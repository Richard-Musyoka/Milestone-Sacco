<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    @if (context.User.Identity?.IsAuthenticated != true)
                    {
                        <RedirectToLogin />
                    }
                    else
                    {
                        <div class="ms-page">
                            <div class="ms-card ms-card-pad ms-empty">
                                <i class="bi bi-shield-exclamation"></i>
                                <b>You don't have access to this page</b>
                                Ask an administrator to update your role.
                            </div>
                        </div>
                    }
                </NotAuthorized>
                <Authorizing>
                    <div class="ms-auth" style="place-items:center;display:grid"><span class="ms-spin" style="width:28px;height:28px;color:var(--ms-accent)"></span></div>
                </Authorizing>
            </AuthorizeRouteView>
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(MainLayout)">
                <div class="ms-page">
                    <div class="ms-card ms-card-pad ms-empty">
                        <i class="bi bi-compass"></i>
                        <b>Page not found</b>
                        Nothing lives at this address. <a href="dashboard">Back to the dashboard</a>
                    </div>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

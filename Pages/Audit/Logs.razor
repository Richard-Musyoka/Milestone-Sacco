@page "/audit-trail"
@using System.Text
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS

<PageTitle>Audit trail · @Brand.Name</PageTitle>

<div class="ms-page">
    <PageHeader Title="Audit trail" Subtitle="Who did what, when and from where — every change and sign-in event.">
        <button class="ms-btn" @onclick="Load"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
        <button class="ms-btn primary" @onclick="Export" disabled="@(data == null || data.Total == 0)"><i class="bi bi-download"></i> Export CSV</button>
    </PageHeader>

    @if (data != null)
    {
        <div class="ms-mini">
            <div><small>Events (24h)</small><b>@data.Stats.Last24h.ToString("N0")</b></div>
            <div><small>Data changes (24h)</small><b>@data.Stats.Changes24h.ToString("N0")</b></div>
            <div><small>Failures (24h)</small><b style="@(data.Stats.Failed24h > 0 ? "color:var(--ms-red, #c0392b)" : "")">@data.Stats.Failed24h.ToString("N0")</b></div>
            <div><small>Active people (24h)</small><b>@data.Stats.Users24h.ToString("N0")</b></div>
        </div>
    }

    <div class="ms-card">
        <div class="ms-toolbar" style="flex-wrap:wrap">
            <div class="ms-searchbox">
                <i class="bi bi-search"></i>
                <input class="ms-input" type="search" placeholder="Search user, action, record or IP…" aria-label="Search audit trail" @bind="q" @bind:event="oninput" @bind:after="Debounced" />
            </div>
            <div class="ms-chips" role="group" aria-label="Source">
                @foreach (var s in new[] { ("", "All"), ("Activity", "Changes"), ("Security", "Sign-ins") })
                {
                    var val = s.Item1;
                    <button type="button" class="ms-chip @(source == val ? "on" : "")" @onclick="() => SetSource(val)">@s.Item2</button>
                }
            </div>
        </div>
        <div class="ms-toolbar" style="flex-wrap:wrap;border-top:1px solid var(--ms-border)">
            <select class="ms-select" style="width:auto" aria-label="Area" @bind="entity" @bind:after="Reload">
                <option value="">All areas</option>
                @if (data != null) { @foreach (var e in data.Entities) { <option value="@e">@Title(e)</option> } }
            </select>
            <select class="ms-select" style="width:auto" aria-label="User" @bind="user" @bind:after="Reload">
                <option value="">Everyone</option>
                @if (data != null) { @foreach (var u in data.Users) { <option value="@u">@u</option> } }
            </select>
            <select class="ms-select" style="width:auto" aria-label="Outcome" @bind="status" @bind:after="Reload">
                <option value="">Any outcome</option><option value="ok">Succeeded</option><option value="failed">Failed</option>
            </select>
            <div class="ms-toolbar-end" style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
                <div class="ms-seg" role="group" aria-label="Quick range">
                    <button type="button" class="@(range == "today" ? "on" : "")" @onclick='() => Quick("today")'>Today</button>
                    <button type="button" class="@(range == "7" ? "on" : "")" @onclick='() => Quick("7")'>7 days</button>
                    <button type="button" class="@(range == "30" ? "on" : "")" @onclick='() => Quick("30")'>30 days</button>
                </div>
                <input class="ms-input" style="width:auto" type="date" aria-label="From date" @bind="from" @bind:after="CustomRange" />
                <span class="ms-hint">to</span>
                <input class="ms-input" style="width:auto" type="date" aria-label="To date" @bind="to" @bind:after="CustomRange" />
            </div>
        </div>

        @if (loading && data == null)
        {
            <div class="ms-card-body">@for (int i = 0; i < 8; i++) { <div class="ms-skel" style="height:48px;margin-bottom:10px"></div> }</div>
        }
        else if (failed)
        {
            <EmptyState Icon="bi-wifi-off" Title="Couldn't load the audit trail" Text="@error">
                <div style="margin-top:14px"><button class="ms-btn" @onclick="Load"><i class="bi bi-arrow-clockwise"></i> Retry</button></div>
            </EmptyState>
        }
        else if (data == null || data.Items.Count == 0)
        {
            <EmptyState Icon="bi-journal-text" Title="No events found" Text="Nothing matches these filters yet. Changes made from now on are recorded here." />
        }
        else
        {
            <div class="ms-table-wrap" style="@(loading ? "opacity:.55" : "")">
                <table class="ms-table">
                    <thead><tr><th>When</th><th>Who</th><th>Action</th><th>Area</th><th>Record</th><th>Outcome</th><th>IP</th></tr></thead>
                    <tbody>
                        @foreach (var e in data.Items)
                        {
                            var row = e;
                            var key = row.Source + row.Id;
                            <tr class="clickable" @onclick="() => Toggle(key)">
                                <td class="ms-num" title="@row.When.ToLocalTime().ToString("dddd d MMMM yyyy HH:mm:ss")">@row.When.ToLocalTime().ToString("d MMM, HH:mm")</td>
                                <td><div class="ms-cell-person"><Avatar Name="@row.User" Size="sm" /><div><b>@row.User</b><small>@(row.Source == "Security" ? "Sign-in event" : "Data change")</small></div></div></td>
                                <td><span class="ms-pill @Tone(row.Action)">@Title(row.Action)</span></td>
                                <td>@Title(row.Entity)</td>
                                <td class="ms-num">@(string.IsNullOrEmpty(row.RecordId) ? "—" : "#" + row.RecordId)</td>
                                <td><StatusPill Status="@(row.Success ? "Success" : "Failed")" /></td>
                                <td class="ms-num">@(row.Ip ?? "—")</td>
                            </tr>
                            @if (open == key)
                            {
                                <tr><td colspan="7" style="background:var(--ms-surface-2)"><div class="ms-kv" style="padding:6px 4px">
                                    <div><small>Exact time</small><b>@row.When.ToLocalTime().ToString("dddd d MMMM yyyy, HH:mm:ss")</b></div>
                                    <div><small>Request / detail</small><b>@(row.Detail ?? "—")</b></div>
                                </div></td></tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <Pager Total="data.Total" Page="page" PageChanged="OnPage" PageSize="size" PageSizeChanged="OnSize" />
        }
    </div>
</div>

@code {
    private AuditPage? data;
    private string q = "", source = "", entity = "", user = "", status = "", range = "7", error = "";
    private DateTime? from = DateTime.Today.AddDays(-6), to;
    private int page = 1, size = 25;
    private bool loading = true, failed;
    private string? open;
    private CancellationTokenSource? cts;

    protected override async Task OnInitializedAsync() => await Load();

    private string Url(int p, int s)
    {
        var sb = new StringBuilder($"api/audit?page={p}&size={s}");
        void Add(string k, string? v) { if (!string.IsNullOrWhiteSpace(v)) sb.Append('&').Append(k).Append('=').Append(Uri.EscapeDataString(v)); }
        Add("q", q); Add("source", source); Add("entity", entity); Add("user", user); Add("status", status);
        if (from.HasValue) Add("from", from.Value.ToString("yyyy-MM-dd"));
        if (to.HasValue) Add("to", to.Value.ToString("yyyy-MM-dd"));
        return sb.ToString();
    }

    private async Task Load()
    {
        loading = true; failed = false; error = ""; open = null;
        try
        {
            var http = HttpClientFactory.CreateClient("ApiClient");
            var r = await http.GetAsync(Url(page, size));
            if (r.IsSuccessStatusCode) data = await r.Content.ReadFromJsonAsync<AuditPage>();
            else { failed = true; error = r.StatusCode == System.Net.HttpStatusCode.InternalServerError ? "The server couldn't read the audit tables — has Database\\002_audit.sql been run?" : $"The server answered {(int)r.StatusCode}."; }
        }
        catch (Exception ex) { failed = true; error = ex.Message; }
        finally { loading = false; }
    }

    private async Task Reload() { page = 1; await Load(); }

    private async Task Debounced()
    {
        cts?.Cancel(); cts = new CancellationTokenSource();
        var token = cts.Token;
        try { await Task.Delay(350, token); } catch (TaskCanceledException) { return; }
        await Reload();
    }

    private async Task SetSource(string s) { source = s; await Reload(); }

    private async Task Quick(string r)
    {
        range = r; to = null;
        from = r == "today" ? DateTime.Today : DateTime.Today.AddDays(-(int.Parse(r) - 1));
        await Reload();
    }

    private async Task CustomRange() { range = ""; await Reload(); }
    private async Task OnPage(int p) { page = p; await Load(); }
    private async Task OnSize(int s) { size = s; page = 1; await Load(); }
    private void Toggle(string key) => open = open == key ? null : key;

    private async Task Export()
    {
        try
        {
            var http = HttpClientFactory.CreateClient("ApiClient");
            var r = await http.GetAsync(Url(1, 200));
            if (!r.IsSuccessStatusCode) { await JS.InvokeVoidAsync("ms.toast", "error", "Couldn't export"); return; }
            var d = await r.Content.ReadFromJsonAsync<AuditPage>();
            var sb = new StringBuilder("When,Who,Source,Area,Action,Record,Outcome,IP,Detail\n");
            static string C(string? s) => "\"" + (s ?? "").Replace("\"", "\"\"") + "\"";
            foreach (var e in d!.Items)
                sb.AppendLine(string.Join(',', C(e.When.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")), C(e.User), C(e.Source), C(e.Entity), C(e.Action), C(e.RecordId), C(e.Success ? "Success" : "Failed"), C(e.Ip), C(e.Detail)));
            await JS.InvokeVoidAsync("ms.download", $"audit-trail-{DateTime.Now:yyyyMMdd-HHmm}.csv", sb.ToString());
            await JS.InvokeVoidAsync("ms.toast", "success", "Exported", $"{d.Items.Count} rows (up to 200 per export)");
        }
        catch (Exception ex) { await JS.InvokeVoidAsync("ms.toast", "error", "Couldn't export", ex.Message); }
    }

    private static string Title(string? s)
    {
        if (string.IsNullOrEmpty(s)) return "—";
        var t = s.Replace('-', ' ').Replace('_', ' ');
        return char.ToUpper(t[0]) + t[1..];
    }

    private static string Tone(string? action)
    {
        var a = (action ?? "").ToLowerInvariant();
        if (a.Contains("fail") || a.Contains("delete") || a.Contains("cancel") || a.Contains("reject") || a.Contains("revoke") || a.Contains("disable") || a.Contains("lock")) return "bad";
        if (a.Contains("update") || a.Contains("edit") || a.Contains("transfer") || a.Contains("password") || a.Contains("profile")) return "info";
        if (a.Contains("approve") || a.Contains("process") || a.Contains("disburse") || a.Contains("add") || a.Contains("create") || a.Contains("sign") || a.Contains("login") || a.Contains("declar") || a.Contains("apply")) return "ok";
        return "warn";
    }

    private sealed class AuditPage
    {
        public int Total { get; set; }
        public List<AuditItem> Items { get; set; } = new();
        public List<string> Entities { get; set; } = new();
        public List<string> Users { get; set; } = new();
        public AuditStats Stats { get; set; } = new();
    }

    private sealed class AuditStats { public int Last24h { get; set; } public int Failed24h { get; set; } public int Users24h { get; set; } public int Changes24h { get; set; } }

    private sealed class AuditItem
    {
        public string Source { get; set; } = "";
        public long Id { get; set; }
        public DateTime When { get; set; }
        public string User { get; set; } = "";
        public string Entity { get; set; } = "";
        public string Action { get; set; } = "";
        public string? RecordId { get; set; }
        public string? Detail { get; set; }
        public bool Success { get; set; }
        public string? Ip { get; set; }
    }
}

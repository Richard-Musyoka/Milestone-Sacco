@page "/contributions/edit/{ContributionId:int}"
@using SaccoManagementSystem.Models
@inject NavigationManager NavigationManager
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS

<PageTitle>Edit contribution · @Brand.Name</PageTitle>

<div class="ms-page">
    <button type="button" class="ms-back" @onclick="Back"><i class="bi bi-arrow-left"></i> Contributions</button>
    <PageHeader Title="Edit contribution" Subtitle="@($"Receipt CT-{ContributionId:D3}")" />

    @if (loading)
    {
        <div class="ms-skel" style="height:220px;max-width:980px;margin-bottom:16px"></div>
        <div class="ms-skel" style="height:320px;max-width:980px"></div>
    }
    else if (contribution == null)
    {
        <div class="ms-card"><EmptyState Icon="bi-receipt" Title="Contribution not found" Text="@(string.IsNullOrEmpty(error) ? "It may have been deleted." : error)">
            <div style="margin-top:14px"><button class="ms-btn" @onclick="Back">Back to contributions</button></div></EmptyState></div>
    }
    else
    {
        <ContributionForm Model="contribution" Members="members" IsEdit="true" Busy="saving" ErrorMessage="@error" OnValidSubmit="Save" OnCancel="Back" />
    }
</div>

@code {
    [CascadingParameter] public DrawerContext? Drawer { get; set; }
    private void Go(string url) { if (Drawer != null) _ = Drawer.Saved(); else NavigationManager.NavigateTo(url); }
    private void Dismiss(string url) { if (Drawer != null) _ = Drawer.Close(); else NavigationManager.NavigateTo(url); }

    [Parameter] public int ContributionId { get; set; }

    private Contribution? contribution;
    private List<ContributionForm.MemberOption> members = new();
    private bool loading = true, saving;
    private string error = string.Empty;

    // The API returns the list-shaped view model (Type/Date), not the entity (ContributionType/DateContributed).
    private sealed class Loaded
    {
        public int MemberId { get; set; }
        public string? Type { get; set; }
        public decimal Amount { get; set; }
        public DateTime Date { get; set; }
        public string? Status { get; set; }
        public string? PaymentMethod { get; set; }
        public string? TransactionRef { get; set; }
        public string? Remarks { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var http = HttpClientFactory.CreateClient("ApiClient");
            var m = http.GetAsync("api/members/get-dropdown");
            var c = http.GetAsync($"api/contributions/get/{ContributionId}");
            await Task.WhenAll(m, c);

            if (m.Result.IsSuccessStatusCode) members = await m.Result.Content.ReadFromJsonAsync<List<ContributionForm.MemberOption>>() ?? new();
            if (c.Result.IsSuccessStatusCode)
            {
                var v = await c.Result.Content.ReadFromJsonAsync<Loaded>();
                if (v != null)
                    contribution = new Contribution
                    {
                        ContributionId = ContributionId,
                        MemberId = v.MemberId,
                        ContributionType = v.Type ?? "",
                        Amount = v.Amount,
                        DateContributed = v.Date,
                        Status = v.Status ?? "Pending",
                        PaymentMethod = v.PaymentMethod ?? "",
                        TransactionRef = v.TransactionRef ?? "",
                        Remarks = v.Remarks ?? ""
                    };
            }
            else if (c.Result.StatusCode != System.Net.HttpStatusCode.NotFound) error = "Couldn't load this contribution.";
        }
        catch (Exception ex) { error = $"Couldn't load this contribution: {ex.Message}"; }
        finally { loading = false; }
    }

    private async Task Save()
    {
        if (contribution == null) return;
        error = string.Empty;
        if (contribution.MemberId <= 0) { error = "Please select a member."; return; }
        saving = true;
        var shownStatus = contribution.Status;
        try
        {
            if (contribution.Status == "Paid") contribution.Status = "Confirmed";
            var http = HttpClientFactory.CreateClient("ApiClient");
            var r = await http.PutAsJsonAsync($"api/contributions/update/{ContributionId}", contribution);
            if (r.IsSuccessStatusCode)
            {
                await JS.InvokeVoidAsync("ms.toast", "success", "Contribution updated");
                Go($"/contributions/view/{ContributionId}");
                return;
            }
            var body = await r.Content.ReadAsStringAsync();
            error = string.IsNullOrWhiteSpace(body) ? "The server couldn't save your changes." : body;
        }
        catch (Exception ex) { error = $"Something went wrong: {ex.Message}"; }
        finally { saving = false; contribution.Status = shownStatus; }
    }

    private void Back() => Dismiss("/contributions");
}

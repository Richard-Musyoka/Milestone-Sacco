@page "/contributions"
@using SaccoManagementSystem.Models
@inject NavigationManager NavigationManager
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS

<PageTitle>Contributions · @Brand.Name</PageTitle>

<div class="ms-page">
    <PageHeader Title="Contributions" Subtitle="Every payment members have made — filter, review and record new ones.">
        <a class="ms-btn primary" href="contributions/add"><i class="bi bi-plus-lg"></i> Record contribution</a>
    </PageHeader>

    @if (!loading && !failed)
    {
        <div class="ms-mini">
            <div><small>Total</small><b>KES @Money(Scoped.Sum(x => x.Amount))</b></div>
            <div><small>Paid</small><b>KES @Money(Scoped.Where(x => x.Status == "Paid").Sum(x => x.Amount))</b></div>
            <div><small>Pending</small><b>KES @Money(Scoped.Where(x => x.Status == "Pending").Sum(x => x.Amount))</b></div>
            <div><small>Overdue</small><b>KES @Money(Scoped.Where(x => x.Status == "Overdue").Sum(x => x.Amount))</b></div>
        </div>
    }

    <div class="ms-card">
        <div class="ms-toolbar">
            <div class="ms-searchbox">
                <i class="bi bi-search"></i>
                <input class="ms-input" type="search" placeholder="Search member, receipt or reference…" aria-label="Search contributions" @bind="search" @bind:event="oninput" @bind:after="ResetPage" />
            </div>
            <div class="ms-chips" role="group" aria-label="Filter by status">
                @foreach (var s in Statuses)
                {
                    <button type="button" class="ms-chip @(status == s ? "on" : "")" @onclick="() => SetStatus(s)">@s<em>@(s == "All" ? items.Count : items.Count(x => x.Status == s))</em></button>
                }
            </div>
            <div class="ms-toolbar-end">
                <select class="ms-select" aria-label="Filter by type" @bind="type" @bind:after="ResetPage">
                    <option value="">All types</option>
                    <option value="Monthly">Monthly</option>
                    <option value="Share">Share</option>
                    <option value="Loan">Loan repayment</option>
                    <option value="Special">Special</option>
                </select>
            </div>
        </div>

        @if (loading)
        {
            <div class="ms-card-body">@for (int i = 0; i < 6; i++) { <div class="ms-skel" style="height:52px;margin-bottom:10px"></div> }</div>
        }
        else if (failed)
        {
            <EmptyState Icon="bi-wifi-off" Title="Couldn't load contributions" Text="Check your connection and try again.">
                <div style="margin-top:14px"><button class="ms-btn" @onclick="Load"><i class="bi bi-arrow-clockwise"></i> Retry</button></div>
            </EmptyState>
        }
        else if (!Filtered.Any())
        {
            <EmptyState Icon="bi-piggy-bank" Title="No contributions found" Text="Try a different search or filter, or record a new contribution.">
                <div style="margin-top:14px"><a class="ms-btn primary" href="contributions/add">Record contribution</a></div>
            </EmptyState>
        }
        else
        {
            <div class="ms-table-wrap">
                <table class="ms-table">
                    <thead>
                        <tr>
                            <th>Receipt</th>
                            <th>Member</th>
                            <th>Type</th>
                            <th class="ms-th-sort" @onclick="ToggleSort">Date @(desc ? "↓" : "↑")</th>
                            <th>Method</th>
                            <th class="r">Amount</th>
                            <th>Status</th>
                            <th class="r" style="width:150px"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var x in PageItems)
                        {
                            <tr class="clickable" @onclick="() => View(x.ContributionId)">
                                <td class="ms-num">@x.ReceiptNumber</td>
                                <td><div class="ms-cell-person"><Avatar Name="@x.MemberName" Size="sm" /><div><b>@x.MemberName</b></div></div></td>
                                <td>@x.Type</td>
                                <td class="ms-num">@x.Date.ToString("d MMM yyyy")</td>
                                <td>@(string.IsNullOrWhiteSpace(x.PaymentMethod) ? "—" : x.PaymentMethod)</td>
                                <td class="r ms-num"><b>KES @x.Amount.ToString("N0")</b></td>
                                <td><StatusPill Status="@x.Status" /></td>
                                <td @onclick:stopPropagation="true">
                                    <div class="ms-row-actions">
                                        <button class="ms-ib" title="View" aria-label="View @x.ReceiptNumber" @onclick="() => View(x.ContributionId)"><i class="bi bi-eye"></i></button>
                                        <button class="ms-ib" title="Edit" aria-label="Edit @x.ReceiptNumber" @onclick="() => Edit(x.ContributionId)"><i class="bi bi-pencil"></i></button>
                                        <button class="ms-ib danger" title="Delete" aria-label="Delete @x.ReceiptNumber" @onclick="() => AskDelete(x)"><i class="bi bi-trash3"></i></button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <Pager Total="Filtered.Count()" @bind-Page="page" @bind-PageSize="pageSize" />
        }
    </div>
</div>

<ConfirmDialog Open="showDelete" Danger="true" Title="Delete contribution" ConfirmText="Delete" Busy="deleting" OnConfirm="Delete" OnCancel="CancelDelete">
    <p style="margin:0 0 6px">Delete <b>@toDelete?.ReceiptNumber</b> — KES @toDelete?.Amount.ToString("N0") from @toDelete?.MemberName?</p>
    <p class="ms-hint" style="margin:0">This can't be undone.</p>
</ConfirmDialog>

@code {
    private static readonly string[] Statuses = { "All", "Paid", "Pending", "Overdue" };

    private List<ContributionViewModel> items = new();
    private string search = "", status = "All", type = "";
    private bool desc = true, loading = true, failed, showDelete, deleting;
    private int page = 1, pageSize = 10;
    private ContributionViewModel? toDelete;

    // Totals follow the search and type filters, but not the status chip (so the chips stay comparable).
    private IEnumerable<ContributionViewModel> Scoped => items
        .Where(x => string.IsNullOrEmpty(type) || x.Type == type)
        .Where(x => string.IsNullOrWhiteSpace(search)
            || (x.MemberName ?? "").Contains(search.Trim(), StringComparison.OrdinalIgnoreCase)
            || x.ReceiptNumber.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase)
            || (x.TransactionRef ?? "").Contains(search.Trim(), StringComparison.OrdinalIgnoreCase));

    private IEnumerable<ContributionViewModel> Filtered =>
        (desc ? Scoped.Where(x => status == "All" || x.Status == status).OrderByDescending(x => x.Date)
              : Scoped.Where(x => status == "All" || x.Status == status).OrderBy(x => x.Date));

    private IEnumerable<ContributionViewModel> PageItems => Filtered.Skip((page - 1) * pageSize).Take(pageSize);

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        loading = true; failed = false;
        try
        {
            var http = HttpClientFactory.CreateClient("ApiClient");
            items = await http.GetFromJsonAsync<List<ContributionViewModel>>("api/contributions/get-all") ?? new();
            foreach (var x in items) if (x.Status == "Confirmed") x.Status = "Paid";
        }
        catch { failed = true; }
        finally { loading = false; }
    }

    private static string Money(decimal v)
    {
        var a = Math.Abs(v);
        if (a >= 1_000_000m) return (v / 1_000_000m).ToString("0.##") + "M";
        if (a >= 10_000m) return (v / 1_000m).ToString("0.#") + "K";
        return v.ToString("N0");
    }

    private void ResetPage() => page = 1;
    private void SetStatus(string s) { status = s; page = 1; }
    private void ToggleSort() => desc = !desc;
    private void View(int id) => NavigationManager.NavigateTo($"/contributions/view/{id}");
    private void Edit(int id) => NavigationManager.NavigateTo($"/contributions/edit/{id}");
    private void AskDelete(ContributionViewModel x) { toDelete = x; showDelete = true; }
    private void CancelDelete() { showDelete = false; toDelete = null; }

    private async Task Delete()
    {
        if (toDelete == null) return;
        deleting = true;
        try
        {
            var http = HttpClientFactory.CreateClient("ApiClient");
            var r = await http.DeleteAsync($"api/contributions/delete/{toDelete.ContributionId}");
            if (r.IsSuccessStatusCode)
            {
                await JS.InvokeVoidAsync("ms.toast", "success", "Contribution deleted", toDelete.ReceiptNumber);
                await Load();
            }
            else await JS.InvokeVoidAsync("ms.toast", "error", "Couldn't delete contribution");
        }
        catch { await JS.InvokeVoidAsync("ms.toast", "error", "Couldn't delete contribution", "Network problem — try again."); }
        finally { deleting = false; showDelete = false; toDelete = null; }
    }
}

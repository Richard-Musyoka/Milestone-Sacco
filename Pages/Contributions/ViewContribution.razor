@page "/contributions/view/{ContributionId:int}"
@using SaccoManagementSystem.Models
@inject NavigationManager NavigationManager
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS

<PageTitle>@(c?.ReceiptNumber ?? "Contribution") · @Brand.Name</PageTitle>

<div class="ms-page">
    <button type="button" class="ms-back" @onclick="Back"><i class="bi bi-arrow-left"></i> Contributions</button>

    @if (loading)
    {
        <div class="ms-skel" style="height:140px;border-radius:20px"></div>
        <div class="ms-skel ms-mt" style="height:260px"></div>
    }
    else if (c == null)
    {
        <div class="ms-card"><EmptyState Icon="bi-receipt" Title="Contribution not found" Text="It may have been deleted, or couldn't be loaded.">
            <div style="margin-top:14px"><button class="ms-btn" @onclick="Back">Back to contributions</button></div></EmptyState></div>
    }
    else
    {
        <section class="ms-hero">
            <span class="ms-avatar xl"><i class="bi bi-receipt"></i></span>
            <div style="position:relative;z-index:1">
                <div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap"><h2>KES @c.Amount.ToString("N2")</h2><StatusPill Status="@c.Status" /></div>
                <div class="meta">
                    <span><i class="bi bi-hash"></i>@c.ReceiptNumber</span>
                    <span><i class="bi bi-tag"></i>@c.Type</span>
                    <span><i class="bi bi-calendar-event"></i>@c.Date.ToString("d MMMM yyyy")</span>
                </div>
            </div>
            <div class="ms-hero-actions">
                <a class="ms-btn primary" href="contributions/edit/@c.ContributionId"><i class="bi bi-pencil"></i> Edit</a>
                <button class="ms-btn" @onclick="Print"><i class="bi bi-printer"></i> Print</button>
                <button class="ms-btn" @onclick="() => showDelete = true"><i class="bi bi-trash3"></i> Delete</button>
            </div>
        </section>

        <div class="ms-grid two ms-mt">
            <section class="ms-card">
                <div class="ms-card-head"><div><h3>Member</h3></div></div>
                <div class="ms-card-body">
                    <a class="ms-cell-person" href="members/view/@c.MemberId" style="text-decoration:none;color:inherit">
                        <Avatar Name="@c.MemberName" />
                        <div><b>@c.MemberName</b><small>View member profile</small></div>
                    </a>
                </div>
            </section>
            <section class="ms-card">
                <div class="ms-card-head"><div><h3>Payment details</h3></div></div>
                <div class="ms-card-body ms-kv">
                    <div><small>Method</small><b>@c.PaymentMethod</b></div>
                    <div><small>Reference</small><b>@c.TransactionRef</b></div>
                    <div><small>Remarks</small><b>@c.Remarks</b></div>
                </div>
            </section>
        </div>
    }
</div>

<ConfirmDialog Open="showDelete" Danger="true" Title="Delete contribution" ConfirmText="Delete" Busy="deleting" OnConfirm="Delete" OnCancel="() => showDelete = false">
    <p style="margin:0 0 6px">Delete <b>@c?.ReceiptNumber</b> — KES @c?.Amount.ToString("N2") from @c?.MemberName?</p>
    <p class="ms-hint" style="margin:0">This can't be undone.</p>
</ConfirmDialog>

@code {
    [Parameter] public int ContributionId { get; set; }

    private ContributionViewModel? c;
    private bool loading = true, showDelete, deleting;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var http = HttpClientFactory.CreateClient("ApiClient");
            c = await http.GetFromJsonAsync<ContributionViewModel>($"api/contributions/get/{ContributionId}");
        }
        catch { c = null; }
        finally { loading = false; }
    }

    private async Task Print() => await JS.InvokeVoidAsync("print");
    private void Back() => NavigationManager.NavigateTo("/contributions");

    private async Task Delete()
    {
        deleting = true;
        try
        {
            var http = HttpClientFactory.CreateClient("ApiClient");
            var r = await http.DeleteAsync($"api/contributions/delete/{ContributionId}");
            if (r.IsSuccessStatusCode)
            {
                await JS.InvokeVoidAsync("ms.toast", "success", "Contribution deleted");
                NavigationManager.NavigateTo("/contributions");
                return;
            }
            await JS.InvokeVoidAsync("ms.toast", "error", "Couldn't delete contribution");
        }
        catch { await JS.InvokeVoidAsync("ms.toast", "error", "Couldn't delete contribution", "Network problem — try again."); }
        finally { deleting = false; showDelete = false; }
    }
}

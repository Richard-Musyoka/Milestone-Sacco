@page "/dividends"
@using SaccoManagementSystem.Models
@inject NavigationManager NavigationManager
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS

<PageTitle>Dividends · @Brand.Name</PageTitle>

<div class="ms-page">
    <PageHeader Title="Dividends" Subtitle="Declare, approve and pay out member dividends.">
        <a class="ms-btn" href="dividends/process"><i class="bi bi-cash-stack"></i> Process payments</a>
        <a class="ms-btn primary" href="dividends/declare"><i class="bi bi-plus-lg"></i> Declare dividend</a>
    </PageHeader>

    @if (failed)
    {
        <div class="ms-card"><EmptyState Icon="bi-wifi-off" Title="Couldn't load dividends" Text="@error">
            <div style="margin-top:14px"><button class="ms-btn" @onclick="Load"><i class="bi bi-arrow-clockwise"></i> Retry</button></div></EmptyState></div>
    }
    else
    {
        @if (loading)
        {
            <div class="ms-grid stats">@for (int i = 0; i < 4; i++) { <div class="ms-skel" style="height:110px"></div> }</div>
        }
        else
        {
            <div class="ms-grid stats">
                <StatCard Label="Total declared" Icon="bi-cash-stack" Prefix="KES" Value="@Money(summary?.TotalDividends ?? 0)" />
                <StatCard Label="Paid out" Icon="bi-check2-circle" Tone="blue" Prefix="KES" Value="@Money(summary?.PaidDividends ?? 0)" Foot="@($"{summary?.PaidMembersCount ?? 0} members")" />
                <StatCard Label="Pending" Icon="bi-hourglass-split" Tone="gold" Prefix="KES" Value="@Money(summary?.PendingDividends ?? 0)" Foot="@($"{summary?.PendingMembersCount ?? 0} members")" />
                <StatCard Label="Latest rate" Icon="bi-percent" Tone="red" Value="@(summary?.CurrentDividendRate is decimal r ? (r * 100).ToString("0.##") + "%" : "—")" Foot="@summary?.CurrentDividendYear" />
            </div>
        }

        <div class="ms-tabs ms-mt" role="tablist">
            <button role="tab" class="@(tab == "declarations" ? "on" : "")" @onclick='() => SetTab("declarations")'><i class="bi bi-megaphone"></i> Declarations <em>@declarations.Count</em></button>
            <button role="tab" class="@(tab == "payments" ? "on" : "")" @onclick='() => SetTab("payments")'><i class="bi bi-wallet2"></i> Payments <em>@payments.Count</em></button>
            <button role="tab" class="@(tab == "projections" ? "on" : "")" @onclick='() => SetTab("projections")'><i class="bi bi-calculator"></i> Projections</button>
        </div>

        @if (tab == "projections")
        {
            <div class="ms-split">
                <section class="ms-card">
                    <div class="ms-card-head"><div><h3>Dividend calculator</h3><p>Estimate next year's payout from expected profit.</p></div></div>
                    <div class="ms-card-body">
                        <div class="ms-grid-form">
                            <Field Class="c12" Label="Estimated profit (KES)"><input class="ms-input" type="number" min="0" @bind="calc.EstimatedProfit" /></Field>
                            <Field Class="c6" Label="Total shares"><input class="ms-input" type="number" min="0" @bind="calc.TotalShares" /></Field>
                            <Field Class="c6" Label="Payout ratio (%)"><input class="ms-input" type="number" min="1" max="100" @bind="calc.PayoutRatio" /></Field>
                        </div>
                        <div style="margin-top:14px"><button class="ms-btn primary @(calcBusy ? "busy" : "")" @onclick="Calculate">@if (calcBusy) { <span class="ms-spin"></span> } <i class="bi bi-calculator"></i> Calculate</button></div>
                    </div>
                </section>
                <aside class="ms-card ms-calc" aria-live="polite">
                    <div><small style="color:var(--ms-text-3);font-weight:700;text-transform:uppercase;letter-spacing:.06em;font-size:11px">Projected payout</small></div>
                    <div class="big">@(result == null ? "—" : "KES " + result.PayoutAmount.ToString("N0"))</div>
                    @if (result != null)
                    {
                        <div class="row"><span>Dividend rate</span><b>@result.DividendRate.ToString("0.##")%</b></div>
                        <div class="row"><span>Per share</span><b>KES @result.PerShareAmount.ToString("N2")</b></div>
                        <div class="row"><span>Total dividends</span><b>KES @result.TotalDividends.ToString("N0")</b></div>
                    }
                    else { <small class="ms-hint">Fill in the figures and press Calculate.</small> }
                </aside>
            </div>

            @if (declarations.Count > 0)
            {
                <section class="ms-card ms-mt">
                    <div class="ms-card-head"><div><h3>Rate history</h3></div></div>
                    <div class="ms-card-body" style="display:grid;gap:12px">
                        @{ var maxRate = declarations.Max(d => d.Rate); }
                        @foreach (var d in declarations.OrderBy(d => d.DeclarationDate))
                        {
                            var w = maxRate > 0 ? (double)(d.Rate / maxRate) * 100 : 0;
                            <div style="display:flex;align-items:center;gap:12px">
                                <span class="ms-num" style="width:90px;font-weight:700">@d.FinancialYear</span>
                                <div class="ms-bar" style="flex:1"><i style="width:@(w.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></i></div>
                                <span class="ms-num" style="width:64px;text-align:right">@((d.Rate * 100).ToString("0.##"))%</span>
                            </div>
                        }
                    </div>
                </section>
            }
        }
        else
        {
            <div class="ms-card">
                <div class="ms-toolbar">
                    <div class="ms-searchbox">
                        <i class="bi bi-search"></i>
                        <input class="ms-input" type="search" placeholder="@(tab == "declarations" ? "Search declaration number or year…" : "Search member, payment number or year…")" aria-label="Search" @bind="search" @bind:event="oninput" @bind:after="ResetPage" />
                    </div>
                </div>

                @if (loading)
                {
                    <div class="ms-card-body">@for (int i = 0; i < 5; i++) { <div class="ms-skel" style="height:52px;margin-bottom:10px"></div> }</div>
                }
                else if (tab == "declarations")
                {
                    @if (!FDecl.Any())
                    {
                        <EmptyState Icon="bi-megaphone" Title="No declarations" Text="Declare a dividend to get started."><div style="margin-top:14px"><a class="ms-btn primary" href="dividends/declare">Declare dividend</a></div></EmptyState>
                    }
                    else
                    {
                        <div class="ms-table-wrap"><table class="ms-table">
                            <thead><tr><th>Declaration</th><th>Year</th><th class="r">Rate</th><th class="r">Total</th><th>Progress</th><th>Payment date</th><th>Status</th><th class="r" style="width:150px"></th></tr></thead>
                            <tbody>
                                @foreach (var d in PDecl)
                                {
                                    var pct = d.TotalAmount > 0 ? (double)(d.PaidAmount / d.TotalAmount) * 100 : 0;
                                    <tr class="clickable" @onclick="() => ViewDecl(d)">
                                        <td class="ms-num"><b>@d.DeclarationNumber</b></td>
                                        <td>@d.FinancialYear</td>
                                        <td class="r ms-num">@((d.Rate * 100).ToString("0.##"))%</td>
                                        <td class="r ms-num"><b>KES @d.TotalAmount.ToString("N0")</b></td>
                                        <td style="min-width:130px"><div class="ms-bar"><i style="width:@(Math.Min(100, pct).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></i></div><small style="color:var(--ms-text-3)">@d.PaymentCount payments</small></td>
                                        <td class="ms-num">@(d.PaymentDate?.ToString("d MMM yyyy") ?? "—")</td>
                                        <td><StatusPill Status="@d.Status" /></td>
                                        <td @onclick:stopPropagation="true"><div class="ms-row-actions">
                                            <button class="ms-ib" title="View" aria-label="View @d.DeclarationNumber" @onclick="() => ViewDecl(d)"><i class="bi bi-eye"></i></button>
                                            <button class="ms-ib" title="Edit" aria-label="Edit @d.DeclarationNumber" @onclick="() => EditDecl(d)"><i class="bi bi-pencil"></i></button>
                                            <button class="ms-ib danger" title="Delete" aria-label="Delete @d.DeclarationNumber" @onclick="() => delDecl = d"><i class="bi bi-trash3"></i></button>
                                        </div></td>
                                    </tr>
                                }
                            </tbody></table></div>
                        <Pager Total="FDecl.Count()" @bind-Page="page" @bind-PageSize="pageSize" />
                    }
                }
                else
                {
                    @if (!FPay.Any())
                    {
                        <EmptyState Icon="bi-wallet2" Title="No payments" Text="Payments appear here after a declaration is approved." />
                    }
                    else
                    {
                        <div class="ms-table-wrap"><table class="ms-table">
                            <thead><tr><th>Payment</th><th>Member</th><th>Year</th><th class="r">Shares</th><th class="r">Amount</th><th>Paid on</th><th>Status</th><th class="r" style="width:130px"></th></tr></thead>
                            <tbody>
                                @foreach (var p in PPay)
                                {
                                    <tr class="clickable" @onclick="() => ViewPay(p.Id)">
                                        <td class="ms-num">@p.PaymentNumber</td>
                                        <td><div class="ms-cell-person"><Avatar Name="@p.MemberName" Size="sm" /><div><b>@p.MemberName</b><small>@p.MemberNumber</small></div></div></td>
                                        <td>@p.DeclarationYear</td>
                                        <td class="r ms-num">@p.Shares.ToString("N0")</td>
                                        <td class="r ms-num"><b>KES @p.Amount.ToString("N0")</b></td>
                                        <td class="ms-num">@(p.PaymentDate?.ToString("d MMM yyyy") ?? "—")</td>
                                        <td><StatusPill Status="@p.Status" /></td>
                                        <td @onclick:stopPropagation="true"><div class="ms-row-actions">
                                            @if (p.Status == "Pending") { <button class="ms-btn sm primary" @onclick="() => OpenPay(p)">Pay</button> }
                                            <button class="ms-ib" title="View" aria-label="View payment @p.PaymentNumber" @onclick="() => ViewPay(p.Id)"><i class="bi bi-eye"></i></button>
                                        </div></td>
                                    </tr>
                                }
                            </tbody></table></div>
                        <Pager Total="FPay.Count()" @bind-Page="page" @bind-PageSize="pageSize" />
                    }
                }
            </div>
        }
    }
</div>

<ConfirmDialog Open="delDecl != null" Danger="true" Title="Delete declaration" ConfirmText="Delete" Busy="busy" OnConfirm="DeleteDecl" OnCancel="() => delDecl = null">
    <p style="margin:0 0 6px">Delete <b>@delDecl?.DeclarationNumber</b> (@delDecl?.FinancialYear)?</p>
    <p class="ms-hint" style="margin:0">Declarations that already have payments may be refused by the server.</p>
</ConfirmDialog>

<Modal Open="payTarget != null" OnClose="() => payTarget = null" Title="Pay dividend" Subtitle="@(payTarget == null ? "" : $"{payTarget.MemberName} · KES {payTarget.Amount:N0}")">
    <ChildContent>
        <div class="ms-grid-form">
            <Field Class="c6" Label="Payment method"><select class="ms-select" @bind="payMethod"><option>Bank Transfer</option><option>M-Pesa</option><option>Cash</option><option>Cheque</option></select></Field>
            <Field Class="c6" Label="Payment date"><input class="ms-input" type="date" @bind="payDate" /></Field>
            <Field Class="c12" Label="Remarks"><textarea class="ms-input" @bind="payRemarks"></textarea></Field>
        </div>
    </ChildContent>
    <Footer>
        <button type="button" class="ms-btn" @onclick="() => payTarget = null">Cancel</button>
        <button type="button" class="ms-btn primary @(busy ? "busy" : "")" @onclick="Pay">@if (busy) { <span class="ms-spin"></span> }Confirm payment</button>
    </Footer>
</Modal>

@code {
    private DividendSummaryDto? summary;
    private List<DividendDeclarationDto> declarations = new();
    private List<DividendPaymentDto> payments = new();
    private string tab = "declarations", search = "", error = "";
    private bool loading = true, failed, busy, calcBusy;
    private int page = 1, pageSize = 10;

    private DividendDeclarationDto? delDecl;
    private DividendPaymentDto? payTarget;
    private string payMethod = "Bank Transfer", payRemarks = "";
    private DateTime payDate = DateTime.Today;

    private ProjectionCalculatorDto calc = new();
    private ProjectionResultDto? result;

    private IEnumerable<DividendDeclarationDto> FDecl => declarations
        .Where(d => string.IsNullOrWhiteSpace(search) || (d.DeclarationNumber ?? "").Contains(search.Trim(), StringComparison.OrdinalIgnoreCase) || (d.FinancialYear ?? "").Contains(search.Trim(), StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(d => d.DeclarationDate);
    private IEnumerable<DividendDeclarationDto> PDecl => FDecl.Skip((page - 1) * pageSize).Take(pageSize);

    private IEnumerable<DividendPaymentDto> FPay => payments
        .Where(p => string.IsNullOrWhiteSpace(search) || (p.MemberName ?? "").Contains(search.Trim(), StringComparison.OrdinalIgnoreCase) || (p.PaymentNumber ?? "").Contains(search.Trim(), StringComparison.OrdinalIgnoreCase) || (p.DeclarationYear ?? "").Contains(search.Trim(), StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(p => p.PaymentDate ?? DateTime.MaxValue);
    private IEnumerable<DividendPaymentDto> PPay => FPay.Skip((page - 1) * pageSize).Take(pageSize);

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        loading = true; failed = false; error = "";
        try
        {
            var http = HttpClientFactory.CreateClient("ApiClient");
            var s = http.GetAsync("api/dividends/summary");
            var d = http.GetAsync("api/dividends/declarations");
            var p = http.GetAsync("api/dividends/payments");
            await Task.WhenAll(s, d, p);
            if (s.Result.IsSuccessStatusCode) summary = await s.Result.Content.ReadFromJsonAsync<DividendSummaryDto>();
            if (d.Result.IsSuccessStatusCode) declarations = await d.Result.Content.ReadFromJsonAsync<List<DividendDeclarationDto>>() ?? new();
            else { failed = true; error = $"Declarations: server answered {(int)d.Result.StatusCode}."; }
            if (p.Result.IsSuccessStatusCode) payments = await p.Result.Content.ReadFromJsonAsync<List<DividendPaymentDto>>() ?? new();
        }
        catch (Exception ex) { failed = true; error = ex.Message; }
        finally { loading = false; }
    }

    private static string Money(decimal v)
    {
        var a = Math.Abs(v);
        if (a >= 1_000_000m) return (v / 1_000_000m).ToString("0.##") + "M";
        if (a >= 10_000m) return (v / 1_000m).ToString("0.#") + "K";
        return v.ToString("N0");
    }

    private void SetTab(string t) { tab = t; page = 1; search = ""; }
    private void ResetPage() => page = 1;
    private static string Slug(string? y) => (y ?? "").Replace("/", "-");
    private void ViewDecl(DividendDeclarationDto d) => NavigationManager.NavigateTo($"/dividends/declarations/financial-year/{Slug(d.FinancialYear)}");
    private void EditDecl(DividendDeclarationDto d) => NavigationManager.NavigateTo($"/dividends/declarations/financial-year/{Slug(d.FinancialYear)}/edit");
    private void ViewPay(int id) => NavigationManager.NavigateTo($"/dividends/payments/{id}");
    private void OpenPay(DividendPaymentDto p) { payTarget = p; payMethod = "Bank Transfer"; payDate = DateTime.Today; payRemarks = ""; }

    private async Task DeleteDecl()
    {
        if (delDecl == null) return;
        busy = true;
        try
        {
            var http = HttpClientFactory.CreateClient("ApiClient");
            var r = await http.DeleteAsync($"api/dividends/declarations/{delDecl.DeclarationId}");
            if (r.IsSuccessStatusCode) { await JS.InvokeVoidAsync("ms.toast", "success", "Declaration deleted", delDecl.DeclarationNumber); delDecl = null; await Load(); }
            else await JS.InvokeVoidAsync("ms.toast", "error", "Couldn't delete declaration", $"The server answered {(int)r.StatusCode}.");
        }
        catch (Exception ex) { await JS.InvokeVoidAsync("ms.toast", "error", "Couldn't delete declaration", ex.Message); }
        finally { busy = false; delDecl = null; }
    }

    private async Task Pay()
    {
        if (payTarget == null) return;
        busy = true;
        try
        {
            var http = HttpClientFactory.CreateClient("ApiClient");
            var r = await http.PostAsJsonAsync($"api/dividends/payments/{payTarget.Id}/process", new { PaymentDate = payDate, PaymentMethod = payMethod, Remarks = payRemarks });
            if (r.IsSuccessStatusCode) { await JS.InvokeVoidAsync("ms.toast", "success", "Payment processed", payTarget.MemberName); payTarget = null; await Load(); }
            else await JS.InvokeVoidAsync("ms.toast", "error", "Couldn't process payment", $"The server answered {(int)r.StatusCode}.");
        }
        catch (Exception ex) { await JS.InvokeVoidAsync("ms.toast", "error", "Couldn't process payment", ex.Message); }
        finally { busy = false; }
    }

    private async Task Calculate()
    {
        if (calc.EstimatedProfit <= 0 || calc.TotalShares <= 0 || calc.PayoutRatio <= 0) { await JS.InvokeVoidAsync("ms.toast", "error", "Fill in all three figures"); return; }
        calcBusy = true;
        try
        {
            var http = HttpClientFactory.CreateClient("ApiClient");
            var r = await http.PostAsJsonAsync("api/dividends/calculate-projection", calc);
            if (r.IsSuccessStatusCode) result = await r.Content.ReadFromJsonAsync<ProjectionResultDto>();
            else await JS.InvokeVoidAsync("ms.toast", "error", "Couldn't calculate projection");
        }
        catch (Exception ex) { await JS.InvokeVoidAsync("ms.toast", "error", "Couldn't calculate projection", ex.Message); }
        finally { calcBusy = false; }
    }
}

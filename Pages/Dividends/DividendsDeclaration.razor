@page "/dividends/declare"
@using System.ComponentModel.DataAnnotations
@inject NavigationManager NavigationManager
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS

<PageTitle>Declare dividend · @Brand.Name</PageTitle>

<div class="ms-page">
    <button type="button" class="ms-back" @onclick="Back"><i class="bi bi-arrow-left"></i> Dividends</button>
    <PageHeader Title="Declare a dividend" Subtitle="Set the rate and dates, review the impact, then confirm." />

    <EditForm Model="req" OnValidSubmit="Preview">
        <DataAnnotationsValidator />
        @if (!string.IsNullOrEmpty(error)) { <div class="ms-alert bad" role="alert"><i class="bi bi-exclamation-circle-fill"></i><div>@error</div></div> }

        <div class="ms-split">
            <div class="ms-form" style="max-width:none">
                <section class="ms-fs">
                    <div class="ms-fs-head"><i class="bi bi-megaphone"></i><div><h3>Declaration</h3><small>Year and rate</small></div></div>
                    <div class="ms-fs-body">
                        <div class="ms-grid-form">
                            <Field Class="c6" Label="Financial year" Required="true" For="@(() => req.FinancialYear)">
                                <InputSelect id="fy" class="ms-select" @bind-Value="req.FinancialYear">
                                    <option value="">Select financial year</option>
                                    @foreach (var y in years) { <option value="@y">@y</option> }
                                </InputSelect>
                            </Field>
                            <Field Class="c6" Label="Dividend rate (%)" Required="true" Hint="For example 10 for 10%">
                                <div class="ms-input-icon"><span>%</span><input id="rate" class="ms-input" type="number" step="0.01" min="0.01" max="100" value="@ratePct" @onchange="OnRate" /></div>
                                <ValidationMessage For="@(() => req.Rate)" class="ms-err" />
                            </Field>
                        </div>
                    </div>
                </section>
                <section class="ms-fs">
                    <div class="ms-fs-head"><i class="bi bi-calendar-event"></i><div><h3>Dates</h3><small>When it is declared, who qualifies and when it is paid</small></div></div>
                    <div class="ms-fs-body">
                        <div class="ms-grid-form">
                            <Field Class="c4" Label="Declaration date" Required="true" For="@(() => req.DeclarationDate)"><InputDate id="decl" class="ms-input" @bind-Value="req.DeclarationDate" /></Field>
                            <Field Class="c4" Label="Record date" Required="true" Hint="Shareholders on this date qualify" For="@(() => req.RecordDate)"><InputDate id="rec" class="ms-input" @bind-Value="req.RecordDate" /></Field>
                            <Field Class="c4" Label="Payment date" Required="true" For="@(() => req.PaymentDate)"><InputDate id="pay" class="ms-input" @bind-Value="req.PaymentDate" /></Field>
                            <Field Class="c12" Label="Notes"><InputTextArea id="notes" class="ms-input" @bind-Value="req.Notes" /></Field>
                        </div>
                    </div>
                </section>
                <div class="ms-formbar">
                    <span class="sp">You'll review the numbers before anything is saved</span>
                    <button type="button" class="ms-btn" @onclick="Back" disabled="@busy">Cancel</button>
                    <button type="submit" class="ms-btn primary @(busy && !preview ? "busy" : "")">@if (busy && !preview) { <span class="ms-spin"></span> } else { <i class="bi bi-eye"></i> } Review impact</button>
                </div>
            </div>

            <aside class="ms-card ms-calc" aria-live="polite">
                <div><small style="color:var(--ms-text-3);font-weight:700;text-transform:uppercase;letter-spacing:.06em;font-size:11px">Impact preview</small></div>
                @if (preview)
                {
                    <div class="big">KES @req.TotalAmount.ToString("N0")</div>
                    <div class="row"><span>Rate</span><b>@ratePct.ToString("0.##")%</b></div>
                    <div class="row"><span>Eligible members</span><b>@eligible.ToString("N0")</b></div>
                    <div class="row"><span>Qualifying shares</span><b>@totalShares.ToString("N0")</b></div>
                    <div class="row"><span>Record date</span><b>@req.RecordDate?.ToString("d MMM yyyy")</b></div>
                    <div class="row"><span>Payment date</span><b>@req.PaymentDate?.ToString("d MMM yyyy")</b></div>
                    <button type="button" class="ms-btn primary @(busy ? "busy" : "")" @onclick="Confirm">@if (busy) { <span class="ms-spin"></span> } else { <i class="bi bi-check2-circle"></i> } Confirm declaration</button>
                    <small class="ms-hint">Change any field and review again to refresh these numbers.</small>
                }
                else
                {
                    <div class="big">—</div>
                    <small class="ms-hint">Press "Review impact" to see the eligible members and total payout.</small>
                }
            </aside>
        </div>
    </EditForm>
</div>

@code {
    [CascadingParameter] public DrawerContext? Drawer { get; set; }
    private Task Leave(string url) { if (Drawer != null) return Drawer.Saved(); NavigationManager.NavigateTo(url); return Task.CompletedTask; }

    private DividendDeclarationRequest req = new();
    private readonly List<string> years = new();
    private decimal ratePct = 10, totalShares;
    private int eligible;
    private bool preview, busy;
    private string error = "";

    protected override void OnInitialized()
    {
        var y = DateTime.Now.Year;
        years.AddRange(new[] { $"{y}/{y + 1}", $"{y - 1}/{y}", $"{y - 2}/{y - 1}" });
        req.DeclarationDate = DateTime.Today;
        req.RecordDate = DateTime.Today.AddDays(-30);
        req.PaymentDate = DateTime.Today.AddDays(14);
        req.Rate = 0.1m;
    }

    private void OnRate(ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var v)) { ratePct = v; req.Rate = v / 100m; preview = false; }
    }

    private async Task Preview()
    {
        error = "";
        busy = true;
        try
        {
            var http = HttpClientFactory.CreateClient("ApiClient");
            var r = await http.GetAsync($"api/dividends/members/eligible-for-dividend?recordDate={req.RecordDate:yyyy-MM-dd}");
            if (r.IsSuccessStatusCode)
            {
                var res = await r.Content.ReadFromJsonAsync<EligibleMembersResponse>();
                totalShares = res?.TotalShares ?? 0;
                eligible = res?.EligibleMembersCount ?? 0;
                req.TotalAmount = totalShares * req.Rate; // same formula as before; the server recalculates authoritative figures
                preview = true;
            }
            else { error = await r.Content.ReadAsStringAsync(); if (string.IsNullOrWhiteSpace(error)) error = $"The server answered {(int)r.StatusCode}."; }
        }
        catch (Exception ex) { error = $"Couldn't calculate the dividend: {ex.Message}"; }
        finally { busy = false; }
    }

    private async Task Confirm()
    {
        busy = true; error = "";
        try
        {
            req.TotalAmount = totalShares * req.Rate;
            var http = HttpClientFactory.CreateClient("ApiClient");
            var r = await http.PostAsJsonAsync("api/dividends/declarations", req);
            if (r.IsSuccessStatusCode)
            {
                await JS.InvokeVoidAsync("ms.toast", "success", "Dividend declared", req.FinancialYear);
                await Leave($"/dividends/declarations/financial-year/{req.FinancialYear.Replace("/", "-")}");
                return;
            }
            error = await r.Content.ReadAsStringAsync();
            if (string.IsNullOrWhiteSpace(error)) error = "The server couldn't save this declaration.";
        }
        catch (Exception ex) { error = $"Couldn't declare the dividend: {ex.Message}"; }
        finally { busy = false; }
    }

    private Task Back() { if (Drawer != null) return Drawer.Close(); NavigationManager.NavigateTo("/dividends"); return Task.CompletedTask; }

    public class DividendDeclarationRequest
    {
        [Required(ErrorMessage = "Financial year is required")]
        public string FinancialYear { get; set; } = string.Empty;
        [Required(ErrorMessage = "Declaration date is required")]
        public DateTime DeclarationDate { get; set; }
        [Required(ErrorMessage = "Record date is required")]
        public DateTime? RecordDate { get; set; }
        [Required(ErrorMessage = "Payment date is required")]
        public DateTime? PaymentDate { get; set; }
        [Range(0.0001, 1, ErrorMessage = "Rate must be between 0.01% and 100%")]
        public decimal Rate { get; set; }
        public decimal TotalAmount { get; set; }
        public string Notes { get; set; } = string.Empty;
    }

    public class EligibleMembersResponse
    {
        public int EligibleMembersCount { get; set; }
        public decimal TotalShares { get; set; }
    }
}

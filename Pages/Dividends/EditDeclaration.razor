@page "/dividends/declarations/financial-year/{FinancialYear}/edit"
@using System.ComponentModel.DataAnnotations
@using System.Net
@inject NavigationManager NavigationManager
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS

<PageTitle>Edit dividend · @Brand.Name</PageTitle>

<div class="ms-page">
    <button type="button" class="ms-back" @onclick="Back"><i class="bi bi-arrow-left"></i> @YearDisplay</button>
    <PageHeader Title="@($"Edit {YearDisplay} dividend")" Subtitle="Changing the rate or record date recalculates every member's dividend." />

    @if (loading)
    {
        <div class="ms-skel" style="height:260px;max-width:980px"></div>
    }
    else if (req == null)
    {
        <div class="ms-card"><EmptyState Icon="bi-megaphone" Title="Declaration not found" Text="@(string.IsNullOrEmpty(error) ? "It may have been removed." : error)" /></div>
    }
    else
    {
        <EditForm Model="req" OnValidSubmit="Review">
            <DataAnnotationsValidator />
            @if (!string.IsNullOrEmpty(error)) { <div class="ms-alert bad" role="alert"><i class="bi bi-exclamation-circle-fill"></i><div>@error</div></div> }

            <div class="ms-split">
                <div class="ms-form" style="max-width:none">
                    <section class="ms-fs">
                        <div class="ms-fs-head"><i class="bi bi-megaphone"></i><div><h3>Declaration</h3><small>Year and rate</small></div></div>
                        <div class="ms-fs-body">
                            <div class="ms-grid-form">
                                <Field Class="c6" Label="Financial year"><InputText class="ms-input" @bind-Value="req.FinancialYear" disabled /></Field>
                                <Field Class="c6" Label="Dividend rate (%)" Required="true">
                                    <div class="ms-input-icon"><span>%</span><input class="ms-input" type="number" step="0.01" min="0.01" max="100" value="@ratePct.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture)" @onchange="OnRate" /></div>
                                    <ValidationMessage For="@(() => req.Rate)" class="ms-err" />
                                </Field>
                            </div>
                        </div>
                    </section>
                    <section class="ms-fs">
                        <div class="ms-fs-head"><i class="bi bi-calendar-event"></i><div><h3>Dates</h3><small>Declaration, record and payment</small></div></div>
                        <div class="ms-fs-body">
                            <div class="ms-grid-form">
                                <Field Class="c4" Label="Declaration date" Required="true" For="@(() => req.DeclarationDate)"><InputDate class="ms-input" @bind-Value="req.DeclarationDate" /></Field>
                                <Field Class="c4" Label="Record date" Required="true" For="@(() => req.RecordDate)"><InputDate class="ms-input" @bind-Value="req.RecordDate" /></Field>
                                <Field Class="c4" Label="Payment date" Required="true" For="@(() => req.PaymentDate)"><InputDate class="ms-input" @bind-Value="req.PaymentDate" /></Field>
                                <Field Class="c12" Label="Notes"><InputTextArea class="ms-input" @bind-Value="req.Notes" /></Field>
                            </div>
                        </div>
                    </section>
                    <div class="ms-formbar">
                        <span class="sp">Review the impact, then save</span>
                        <button type="button" class="ms-btn" @onclick="Back" disabled="@busy">Cancel</button>
                        <button type="submit" class="ms-btn primary @(busy && !reviewed ? "busy" : "")">@if (busy && !reviewed) { <span class="ms-spin"></span> } else { <i class="bi bi-eye"></i> } Review impact</button>
                    </div>
                </div>

                <aside class="ms-card ms-calc" aria-live="polite">
                    <div><small style="color:var(--ms-text-3);font-weight:700;text-transform:uppercase;letter-spacing:.06em;font-size:11px">Impact preview</small></div>
                    @if (reviewed)
                    {
                        <div class="big">KES @req.TotalAmount.ToString("N0")</div>
                        <div class="row"><span>Rate</span><b>@ratePct.ToString("0.##")%</b></div>
                        <div class="row"><span>Eligible members</span><b>@eligible.ToString("N0")</b></div>
                        <div class="row"><span>Qualifying shares</span><b>@totalShares.ToString("N0")</b></div>
                        <button type="button" class="ms-btn primary @(busy ? "busy" : "")" @onclick="() => confirm = true">@if (busy) { <span class="ms-spin"></span> } <i class="bi bi-check2-circle"></i> Save changes</button>
                    }
                    else
                    {
                        <div class="big">—</div>
                        <small class="ms-hint">Press "Review impact" to recalculate before saving.</small>
                    }
                </aside>
            </div>
        </EditForm>
    }
</div>

<ConfirmDialog Open="confirm" Title="Update declaration" ConfirmText="Update and recalculate" Busy="busy" OnConfirm="Save" OnCancel="() => confirm = false">
    <p style="margin:0">This recalculates dividends for all eligible members. Continue?</p>
</ConfirmDialog>

@code {
    [Parameter] public string FinancialYear { get; set; } = string.Empty;

    private DividendDeclarationRequest? req;
    private decimal ratePct, totalShares;
    private int eligible;
    private bool loading = true, busy, reviewed, confirm;
    private string error = "";
    private string YearDisplay => FinancialYear.Replace("-", "/");
    private string ApiYear => Uri.EscapeDataString(YearDisplay);

    protected override async Task OnParametersSetAsync() => await Load();

    private async Task Load()
    {
        loading = true; error = "";
        try
        {
            var http = HttpClientFactory.CreateClient("ApiClient");
            var r = await http.GetAsync($"api/dividends/declarations/financial-year/{ApiYear}");
            if (r.IsSuccessStatusCode)
            {
                req = await r.Content.ReadFromJsonAsync<DividendDeclarationRequest>();
                if (req != null) ratePct = req.Rate * 100m;
            }
            else { req = null; if (r.StatusCode != HttpStatusCode.NotFound) error = $"The server answered {(int)r.StatusCode}."; }
        }
        catch (Exception ex) { req = null; error = ex.Message; }
        finally { loading = false; }
    }

    private void OnRate(ChangeEventArgs e)
    {
        if (req != null && decimal.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var v)) { ratePct = v; req.Rate = v / 100m; reviewed = false; }
    }

    private async Task Review()
    {
        if (req == null) return;
        error = "";
        if (req.RecordDate < req.DeclarationDate) { error = "Record date must be on or after the declaration date."; return; }
        if (req.PaymentDate < req.RecordDate) { error = "Payment date must be on or after the record date."; return; }

        busy = true;
        try
        {
            var http = HttpClientFactory.CreateClient("ApiClient");
            var r = await http.GetAsync($"api/dividends/members/eligible-for-dividend?recordDate={req.RecordDate:yyyy-MM-dd}");
            if (r.IsSuccessStatusCode)
            {
                var res = await r.Content.ReadFromJsonAsync<EligibleMembersResponse>();
                totalShares = res?.TotalShares ?? 0;
                eligible = res?.EligibleMembersCount ?? 0;
                req.TotalAmount = totalShares * req.Rate;
                reviewed = true;
            }
            else error = $"Couldn't calculate the impact ({(int)r.StatusCode}).";
        }
        catch (Exception ex) { error = ex.Message; }
        finally { busy = false; }
    }

    private async Task Save()
    {
        if (req == null) return;
        busy = true; error = "";
        try
        {
            req.TotalAmount = totalShares * req.Rate;
            var http = HttpClientFactory.CreateClient("ApiClient");
            var r = await http.PutAsJsonAsync($"api/dividends/declarations/financial-year/{ApiYear}", req);
            if (r.IsSuccessStatusCode)
            {
                await JS.InvokeVoidAsync("ms.toast", "success", "Declaration updated", YearDisplay);
                NavigationManager.NavigateTo($"/dividends/declarations/financial-year/{FinancialYear}");
                return;
            }
            error = r.StatusCode == HttpStatusCode.Conflict
                ? "This declaration can't be modified — it may already be approved or processed."
                : $"Couldn't update the declaration ({(int)r.StatusCode}). {await r.Content.ReadAsStringAsync()}";
        }
        catch (Exception ex) { error = ex.Message; }
        finally { busy = false; confirm = false; }
    }

    private void Back() => NavigationManager.NavigateTo($"/dividends/declarations/financial-year/{FinancialYear}");

    public class DividendDeclarationRequest
    {
        [Required] public string FinancialYear { get; set; } = string.Empty;
        [Required(ErrorMessage = "Declaration date is required")] public DateTime DeclarationDate { get; set; } = DateTime.Today;
        [Required(ErrorMessage = "Record date is required")] public DateTime? RecordDate { get; set; }
        [Required(ErrorMessage = "Payment date is required")] public DateTime? PaymentDate { get; set; }
        [Range(0.0001, 1, ErrorMessage = "Rate must be between 0.01% and 100%")] public decimal Rate { get; set; } = 0.1m;
        public decimal TotalAmount { get; set; }
        public string? Notes { get; set; } = string.Empty;
    }

    public class EligibleMembersResponse
    {
        public int EligibleMembersCount { get; set; }
        public decimal TotalShares { get; set; }
    }
}

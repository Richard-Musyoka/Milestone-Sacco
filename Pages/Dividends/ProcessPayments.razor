@page "/dividends/process"
@using SaccoManagementSystem.Models
@inject NavigationManager NavigationManager
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS

<PageTitle>Process dividend payments · @Brand.Name</PageTitle>

<div class="ms-page">
    <button type="button" class="ms-back" @onclick="Back"><i class="bi bi-arrow-left"></i> Dividends</button>
    <PageHeader Title="Process dividend payments" Subtitle="Pick an approved declaration, choose who to pay, review, then release." />

    <ol class="ms-steps" aria-label="Steps">
        @foreach (var (n, label) in Steps)
        {
            <li class="@(step == n ? "on" : step > n ? "done" : "")"><span>@(step > n ? "✓" : n.ToString())</span>@label</li>
        }
    </ol>

    @if (!string.IsNullOrEmpty(error)) { <div class="ms-alert bad" role="alert"><i class="bi bi-exclamation-circle-fill"></i><div>@error</div></div> }

    @if (step == 1)
    {
        <section class="ms-card">
            <div class="ms-card-head"><div><h3>Choose a declaration</h3><p>Only approved declarations can be paid out.</p></div></div>
            @if (loading)
            {
                <div class="ms-card-body">@for (int i = 0; i < 3; i++) { <div class="ms-skel" style="height:64px;margin-bottom:10px"></div> }</div>
            }
            else if (!Approved.Any())
            {
                <EmptyState Icon="bi-megaphone" Title="Nothing to process" Text="Approve a declaration first, then come back here."><div style="margin-top:14px"><a class="ms-btn primary" href="dividends">Go to dividends</a></div></EmptyState>
            }
            else
            {
                <div class="ms-card-body" style="display:grid;gap:10px">
                    @foreach (var d in Approved)
                    {
                        var item = d;
                        <button type="button" class="ms-picked" style="cursor:pointer;text-align:left;font:inherit;color:inherit" @onclick="() => Select(item)">
                            <span class="ms-avatar sm"><i class="bi bi-megaphone"></i></span>
                            <div><b>@d.FinancialYear · @d.DeclarationNumber</b><small>@((d.Rate * 100).ToString("0.##"))% · KES @d.TotalAmount.ToString("N0") · @d.PaymentCount payments</small></div>
                            <StatusPill Status="@d.Status" /><i class="bi bi-chevron-right"></i>
                        </button>
                    }
                </div>
            }
        </section>
    }
    else if (step == 2)
    {
        <section class="ms-card">
            <div class="ms-card-head"><div><h3>@selected?.FinancialYear payments</h3><p>Tick the payments to release. Each needs a valid method and details.</p></div></div>
            @if (loading)
            {
                <div class="ms-card-body">@for (int i = 0; i < 5; i++) { <div class="ms-skel" style="height:48px;margin-bottom:10px"></div> }</div>
            }
            else if (payments.Count == 0)
            {
                <EmptyState Icon="bi-wallet2" Title="No payments on this declaration" Text="Nothing has been generated for it yet." />
            }
            else
            {
                <div class="ms-table-wrap"><table class="ms-table">
                    <thead><tr>
                        <th style="width:44px"><input type="checkbox" aria-label="Select all payable" checked="@AllChecked" @onchange="ToggleAll" /></th>
                        <th>Member</th><th class="r">Amount</th><th style="width:190px">Method</th><th>Details</th><th>Status</th>
                    </tr></thead>
                    <tbody>
                        @foreach (var p in payments)
                        {
                            var pay = p;
                            var ok = Valid(p);
                            <tr>
                                <td>@if (p.Status == "Pending") { <input type="checkbox" aria-label="Select @p.MemberName" checked="@chosen.Contains(p.DividendId)" @onchange="e => Toggle(pay, (bool)e.Value!)" /> }</td>
                                <td><div class="ms-cell-person"><Avatar Name="@p.MemberName" Size="sm" /><div><b>@p.MemberName</b><small>@p.MemberNumber</small></div></div></td>
                                <td class="r ms-num"><b>KES @p.Amount.ToString("N0")</b></td>
                                <td>
                                    @if (p.Status == "Pending")
                                    {
                                        <select class="ms-select @(ok ? "" : "invalid")" aria-label="Payment method for @p.MemberName" @bind="p.PaymentMethod">
                                            <option value="">Select…</option><option>Bank Transfer</option><option>M-Pesa</option><option>Cash</option><option>Cheque</option>
                                        </select>
                                    }
                                    else { @p.PaymentMethod }
                                </td>
                                <td class="ms-num" style="font-size:12.5px">@(p.PaymentMethod == "M-Pesa" ? (string.IsNullOrEmpty(p.PhoneNumber) ? "No phone on file" : p.PhoneNumber) : p.PaymentMethod == "Bank Transfer" ? (string.IsNullOrEmpty(p.BankAccountNumber) ? "No account on file" : p.BankAccountNumber) : "—")</td>
                                <td><StatusPill Status="@p.Status" /></td>
                            </tr>
                        }
                    </tbody></table></div>
                <div class="ms-formbar" style="margin:14px">
                    <span class="sp">@chosen.Count selected · KES @Selected.Sum(x => x.Amount).ToString("N0")</span>
                    <button class="ms-btn" @onclick="() => step = 1">Back</button>
                    <button class="ms-btn primary" disabled="@(chosen.Count == 0)" @onclick="Next">Review <i class="bi bi-arrow-right"></i></button>
                </div>
            }
        </section>
    }
    else if (step == 3)
    {
        <div class="ms-split">
            <section class="ms-card">
                <div class="ms-card-head"><div><h3>Review and release</h3><p>@Selected.Count payments for @selected?.FinancialYear</p></div></div>
                <div class="ms-card-body">
                    <div class="ms-grid-form">
                        <Field Class="c6" Label="Payment date"><input class="ms-input" type="date" @bind="date" /></Field>
                        <Field Class="c6" Label="Batch reference" Hint="Leave blank to generate one"><input class="ms-input" @bind="batch" placeholder="BATCH-…" /></Field>
                    </div>
                </div>
                <div class="ms-table-wrap"><table class="ms-table">
                    <thead><tr><th>Member</th><th>Method</th><th class="r">Amount</th></tr></thead>
                    <tbody>@foreach (var p in Selected) { <tr><td>@p.MemberName</td><td>@p.PaymentMethod</td><td class="r ms-num">KES @p.Amount.ToString("N0")</td></tr> }</tbody>
                </table></div>
                <div class="ms-formbar" style="margin:14px">
                    <span class="sp">This releases funds and can't be undone from here</span>
                    <button class="ms-btn" @onclick="() => step = 2" disabled="@busy">Back</button>
                    <button class="ms-btn primary @(busy ? "busy" : "")" @onclick="Process">@if (busy) { <span class="ms-spin"></span> } else { <i class="bi bi-send"></i> } Process payments</button>
                </div>
            </section>
            <aside class="ms-card ms-calc">
                <div><small style="color:var(--ms-text-3);font-weight:700;text-transform:uppercase;letter-spacing:.06em;font-size:11px">Batch total</small></div>
                <div class="big">KES @Selected.Sum(x => x.Amount).ToString("N0")</div>
                @foreach (var g in Selected.GroupBy(x => x.PaymentMethod ?? "Not specified"))
                {
                    <div class="row"><span>@g.Key (@g.Count())</span><b>KES @g.Sum(x => x.Amount).ToString("N0")</b></div>
                }
            </aside>
        </div>
    }
    else
    {
        <section class="ms-card"><EmptyState Icon="bi-check2-circle" Title="Payments processed" Text="@($"{doneCount} payments totalling KES {doneAmount:N0} were released.")">
            <div style="margin-top:14px;display:flex;gap:10px;justify-content:center;flex-wrap:wrap">
                <a class="ms-btn primary" href="dividends">View dividends</a>
                <button class="ms-btn" @onclick="Reset">Process more</button>
            </div>
        </EmptyState></section>
    }
</div>

@code {
    private static readonly (int, string)[] Steps = { (1, "Declaration"), (2, "Select payments"), (3, "Review"), (4, "Done") };

    private int step = 1;
    private bool loading = true, busy;
    private string error = "", batch = "";
    private List<DividendDeclarationDto> declarations = new();
    private DividendDeclarationDto? selected;
    private List<DividendPaymentDto> payments = new();
    private HashSet<int> chosen = new();
    private DateTime date = DateTime.Today;
    private int doneCount;
    private decimal doneAmount;

    private IEnumerable<DividendDeclarationDto> Approved => declarations.Where(d => d.Status == "Approved").OrderByDescending(d => d.DeclarationDate);
    private List<DividendPaymentDto> Selected => payments.Where(p => chosen.Contains(p.DividendId)).ToList();
    private bool AllChecked => payments.Any(p => p.Status == "Pending") && payments.Where(p => p.Status == "Pending").All(p => chosen.Contains(p.DividendId));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var http = HttpClientFactory.CreateClient("ApiClient");
            var r = await http.GetAsync("api/dividends/declarations");
            if (r.IsSuccessStatusCode) declarations = await r.Content.ReadFromJsonAsync<List<DividendDeclarationDto>>() ?? new();
            else error = $"Couldn't load declarations ({(int)r.StatusCode}).";
        }
        catch (Exception ex) { error = ex.Message; }
        finally { loading = false; }
    }

    private async Task Select(DividendDeclarationDto d)
    {
        selected = d; error = ""; loading = true; chosen.Clear();
        try
        {
            var http = HttpClientFactory.CreateClient("ApiClient");
            var r = await http.GetAsync($"api/dividends/payments/declaration/{d.DeclarationId}");
            if (r.IsSuccessStatusCode) { payments = await r.Content.ReadFromJsonAsync<List<DividendPaymentDto>>() ?? new(); step = 2; }
            else error = $"Couldn't load payments: {await r.Content.ReadAsStringAsync()}";
        }
        catch (Exception ex) { error = ex.Message; }
        finally { loading = false; }
    }

    private static bool Valid(DividendPaymentDto p) =>
        !string.IsNullOrEmpty(p.PaymentMethod) &&
        (p.PaymentMethod == "Bank Transfer" ? !string.IsNullOrEmpty(p.BankAccountNumber)
         : p.PaymentMethod == "M-Pesa" ? !string.IsNullOrEmpty(p.PhoneNumber) : true);

    private void Toggle(DividendPaymentDto p, bool on) { if (on) chosen.Add(p.DividendId); else chosen.Remove(p.DividendId); }

    private void ToggleAll(ChangeEventArgs e)
    {
        if ((bool)e.Value!) chosen = payments.Where(p => p.Status == "Pending" && Valid(p)).Select(p => p.DividendId).ToHashSet();
        else chosen.Clear();
    }

    private void Next()
    {
        error = "";
        if (Selected.Any(p => !Valid(p))) { error = "Some selected payments have no method, or are missing the phone number / bank account they need."; return; }
        step = 3;
    }

    private async Task Process()
    {
        busy = true; error = "";
        try
        {
            var chosenPayments = Selected;
            var req = new ProcessRequest
            {
                DividendIds = chosenPayments.Select(p => p.DividendId).ToList(),
                PaymentDate = date,
                BatchReference = string.IsNullOrWhiteSpace(batch) ? $"BATCH-{DateTime.Now:yyyyMMdd-HHmmss}" : batch,
                PaymentMethods = chosenPayments.ToDictionary(p => p.DividendId, p => p.PaymentMethod ?? "Bank Transfer")
            };
            var http = HttpClientFactory.CreateClient("ApiClient");
            var r = await http.PostAsJsonAsync("api/dividends/payments/process", req);
            if (r.IsSuccessStatusCode)
            {
                doneCount = chosenPayments.Count; doneAmount = chosenPayments.Sum(p => p.Amount);
                await JS.InvokeVoidAsync("ms.toast", "success", "Payments processed", $"{doneCount} payments");
                step = 4;
            }
            else error = $"Failed to process payments ({(int)r.StatusCode}). {await r.Content.ReadAsStringAsync()}";
        }
        catch (Exception ex) { error = $"Processing failed: {ex.Message}"; }
        finally { busy = false; }
    }

    private void Reset() { step = 1; selected = null; payments.Clear(); chosen.Clear(); batch = ""; error = ""; }
    private void Back() => NavigationManager.NavigateTo("/dividends");

    private sealed class ProcessRequest
    {
        public List<int> DividendIds { get; set; } = new();
        public DateTime PaymentDate { get; set; }
        public string BatchReference { get; set; } = "";
        public Dictionary<int, string> PaymentMethods { get; set; } = new();
    }
}

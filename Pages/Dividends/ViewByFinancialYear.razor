@page "/dividends/declarations/financial-year/{FinancialYear}"
@using SaccoManagementSystem.Models
@inject NavigationManager NavigationManager
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS

<PageTitle>Dividend @YearDisplay · @Brand.Name</PageTitle>

<div class="ms-page">
    <button type="button" class="ms-back" @onclick="Back"><i class="bi bi-arrow-left"></i> Dividends</button>

    @if (loading)
    {
        <div class="ms-skel" style="height:150px;border-radius:20px"></div>
        <div class="ms-grid stats ms-mt">@for (int i = 0; i < 4; i++) { <div class="ms-skel" style="height:110px"></div> }</div>
    }
    else if (d == null)
    {
        <div class="ms-card"><EmptyState Icon="bi-megaphone" Title="No declaration found" Text="@(string.IsNullOrEmpty(error) ? $"There is no dividend declared for {YearDisplay}." : error)">
            <div style="margin-top:14px"><a class="ms-btn primary" href="dividends/declare">Declare dividend</a></div></EmptyState></div>
    }
    else
    {
        <section class="ms-hero">
            <span class="ms-avatar xl"><i class="bi bi-megaphone"></i></span>
            <div style="position:relative;z-index:1">
                <div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap"><h2>@d.FinancialYear dividend</h2><StatusPill Status="@d.Status" /></div>
                <div class="meta">
                    <span><i class="bi bi-hash"></i>@d.DeclarationNumber</span>
                    <span><i class="bi bi-percent"></i>@((d.Rate * 100).ToString("0.##"))% rate</span>
                    <span><i class="bi bi-calendar-event"></i>Declared @d.DeclarationDate.ToString("d MMM yyyy")</span>
                </div>
            </div>
            <div class="ms-hero-actions">
                @if (d.Status == "Pending")
                {
                    <button class="ms-btn primary" @onclick="() => confirm = true"><i class="bi bi-check2-circle"></i> Approve</button>
                    <a class="ms-btn" href="dividends/declarations/financial-year/@FinancialYear/edit"><i class="bi bi-pencil"></i> Edit</a>
                }
                else if (d.Status == "Approved")
                {
                    <a class="ms-btn primary" href="dividends/process"><i class="bi bi-cash-stack"></i> Process payments</a>
                }
                <button class="ms-btn" @onclick="Print"><i class="bi bi-printer"></i> Print</button>
            </div>
        </section>

        @if (!string.IsNullOrEmpty(error)) { <div class="ms-alert bad ms-mt"><i class="bi bi-exclamation-circle-fill"></i><div>@error</div></div> }

        <div class="ms-grid stats ms-mt">
            <StatCard Label="Total payout" Icon="bi-cash-stack" Prefix="KES" Value="@d.TotalAmount.ToString("N0")" />
            <StatCard Label="Paid" Icon="bi-check2-circle" Tone="blue" Prefix="KES" Value="@d.PaidAmount.ToString("N0")" Foot="@($"{pct:0.#}% of total")" />
            <StatCard Label="Remaining" Icon="bi-hourglass-split" Tone="gold" Prefix="KES" Value="@((d.TotalAmount - d.PaidAmount).ToString("N0"))" />
            <StatCard Label="Payments" Icon="bi-people" Tone="red" Value="@d.PaymentCount.ToString("N0")" Foot="members" />
        </div>

        <div class="ms-card ms-mt" style="padding:16px 18px">
            <div style="display:flex;justify-content:space-between;font-weight:700;font-size:13px;margin-bottom:8px"><span>Payout progress</span><span>@pct.ToString("0")%</span></div>
            <div class="ms-bar"><i style="width:@(Math.Min(100, pct).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></i></div>
        </div>

        <div class="ms-grid two ms-mt">
            <section class="ms-card">
                <div class="ms-card-head"><div><h3>Key dates</h3></div></div>
                <div class="ms-card-body ms-kv">
                    <div><small>Declaration date</small><b>@d.DeclarationDate.ToString("d MMMM yyyy")</b></div>
                    <div><small>Record date</small><b>@d.RecordDate.ToString("d MMMM yyyy")</b></div>
                    <div><small>Payment date</small><b>@(d.PaymentDate?.ToString("d MMMM yyyy") ?? "Not set")</b></div>
                    <div><small>Created</small><b>@d.CreatedDate.ToString("d MMM yyyy, HH:mm")</b></div>
                </div>
            </section>
            <section class="ms-card">
                <div class="ms-card-head"><div><h3>Notes</h3></div></div>
                <div class="ms-card-body">@(string.IsNullOrWhiteSpace(d.Notes) ? "No notes." : d.Notes)</div>
            </section>
        </div>
    }
</div>

<ConfirmDialog Open="confirm" Title="Approve declaration" ConfirmText="Approve" Busy="busy" OnConfirm="Approve" OnCancel="() => confirm = false">
    <p style="margin:0 0 6px">Approve the <b>@d?.FinancialYear</b> dividend of <b>KES @d?.TotalAmount.ToString("N0")</b>?</p>
    <p class="ms-hint" style="margin:0">Once approved, payments can be processed and the declaration can't be edited.</p>
</ConfirmDialog>

@code {
    [Parameter] public string FinancialYear { get; set; } = "";

    private DividendDeclarationDto? d;
    private bool loading = true, busy, confirm;
    private string error = "";
    private double pct => d != null && d.TotalAmount > 0 ? (double)(d.PaidAmount / d.TotalAmount) * 100 : 0;
    private string YearDisplay => FinancialYear?.Replace("-", "/") ?? "";

    protected override async Task OnParametersSetAsync() => await Load();

    private async Task Load()
    {
        loading = true; error = "";
        try
        {
            var http = HttpClientFactory.CreateClient("ApiClient");
            var r = await http.GetAsync($"api/dividends/declarations/financial-year/{Uri.EscapeDataString(FinancialYear)}");
            if (r.IsSuccessStatusCode) d = await r.Content.ReadFromJsonAsync<DividendDeclarationDto>();
            else { d = null; if (r.StatusCode != System.Net.HttpStatusCode.NotFound) error = $"The server answered {(int)r.StatusCode}."; }
        }
        catch (Exception ex) { d = null; error = ex.Message; }
        finally { loading = false; }
    }

    private async Task Approve()
    {
        if (d == null) return;
        busy = true;
        try
        {
            var http = HttpClientFactory.CreateClient("ApiClient");
            var r = await http.PostAsync($"api/dividends/declarations/{d.DeclarationId}/approve", null);
            if (r.IsSuccessStatusCode) { await JS.InvokeVoidAsync("ms.toast", "success", "Declaration approved", d.DeclarationNumber); confirm = false; await Load(); }
            else
            {
                var body = await r.Content.ReadAsStringAsync();
                error = string.IsNullOrWhiteSpace(body) ? "Failed to approve declaration." : body;
                confirm = false;
            }
        }
        catch (Exception ex) { error = $"Error approving declaration: {ex.Message}"; confirm = false; }
        finally { busy = false; }
    }

    private void Back() => NavigationManager.NavigateTo("/dividends");
    private async Task Print() => await JS.InvokeVoidAsync("print");
}

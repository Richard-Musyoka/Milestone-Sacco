@page "/dividends/payments/{id:int}"
@using SaccoManagementSystem.Models
@inject NavigationManager NavigationManager
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS

<PageTitle>@(p?.PaymentNumber ?? "Payment") · @Brand.Name</PageTitle>

<div class="ms-page">
    <button type="button" class="ms-back" @onclick="Back"><i class="bi bi-arrow-left"></i> Dividends</button>

    @if (loading)
    {
        <div class="ms-skel" style="height:150px;border-radius:20px"></div>
        <div class="ms-skel ms-mt" style="height:240px"></div>
    }
    else if (p == null)
    {
        <div class="ms-card"><EmptyState Icon="bi-wallet2" Title="Payment not found" Text="@(string.IsNullOrEmpty(error) ? "It may have been removed." : error)" /></div>
    }
    else
    {
        <section class="ms-hero">
            <Avatar Name="@p.MemberName" Size="xl" />
            <div style="position:relative;z-index:1">
                <div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap"><h2>KES @p.Amount.ToString("N2")</h2><StatusPill Status="@p.Status" /></div>
                <div class="meta">
                    <span><i class="bi bi-person"></i>@p.MemberName</span>
                    <span><i class="bi bi-hash"></i>@p.PaymentNumber</span>
                    <span><i class="bi bi-calendar-event"></i>@p.DeclarationYear dividend</span>
                </div>
            </div>
            <div class="ms-hero-actions">
                @if (p.Status == "Pending")
                {
                    <button class="ms-btn primary" @onclick="() => mode = Pay"><i class="bi bi-check2-circle"></i> Mark as paid</button>
                    <button class="ms-btn" @onclick="() => mode = Fail"><i class="bi bi-x-octagon"></i> Mark failed</button>
                }
                <button class="ms-btn" @onclick="Print"><i class="bi bi-printer"></i> Print</button>
            </div>
        </section>

        <div class="ms-grid two ms-mt">
            <section class="ms-card">
                <div class="ms-card-head"><div><h3>Payment</h3></div></div>
                <div class="ms-card-body ms-kv">
                    <div><small>Payment number</small><b>@p.PaymentNumber</b></div>
                    <div><small>Method</small><b>@(p.PaymentMethod ?? "—")</b></div>
                    <div><small>Paid on</small><b>@(p.PaymentDate?.ToString("d MMMM yyyy") ?? "Not yet paid")</b></div>
                    <div><small>Reference</small><b>@(p.TransactionReference ?? "—")</b></div>
                </div>
            </section>
            <section class="ms-card">
                <div class="ms-card-head"><div><h3>Entitlement</h3></div></div>
                <div class="ms-card-body ms-kv">
                    <div><small>Shares at record date</small><b>@p.Shares.ToString("N0")</b></div>
                    <div><small>Amount</small><b>KES @p.Amount.ToString("N2")</b></div>
                    <div><small>Phone</small><b>@(p.PhoneNumber ?? "—")</b></div>
                    <div><small>Bank account</small><b>@(p.BankAccountNumber ?? "—")</b></div>
                </div>
            </section>
            <section class="ms-card">
                <div class="ms-card-head"><div><h3>Member</h3></div></div>
                <div class="ms-card-body"><a class="ms-picked" style="text-decoration:none;color:inherit" href="members/view/@p.MemberId"><Avatar Name="@p.MemberName" Size="sm" /><div><b>@p.MemberName</b><small>@p.MemberNumber</small></div><i class="bi bi-chevron-right"></i></a></div>
            </section>
            <section class="ms-card">
                <div class="ms-card-head"><div><h3>Remarks</h3></div></div>
                <div class="ms-card-body">@(string.IsNullOrWhiteSpace(p.Remarks) ? "No remarks." : p.Remarks)</div>
            </section>
        </div>
    }
</div>

<Modal Open="mode != null" OnClose="() => mode = null" Title="@(mode == Pay ? "Mark as paid" : "Mark as failed")" Subtitle="@(p == null ? "" : $"{p.MemberName} · KES {p.Amount:N0}")">
    <ChildContent>
        @if (mode == Pay)
        {
            <div class="ms-grid-form">
                <Field Class="c6" Label="Payment method"><select class="ms-select" @bind="method"><option>Bank Transfer</option><option>M-Pesa</option><option>Cash</option><option>Cheque</option></select></Field>
                <Field Class="c6" Label="Payment date"><input class="ms-input" type="date" @bind="date" /></Field>
                <Field Class="c12" Label="Remarks"><textarea class="ms-input" @bind="remarks"></textarea></Field>
            </div>
        }
        else
        {
            <Field Label="Reason"><textarea class="ms-input" placeholder="Why did this payment fail?" @bind="remarks"></textarea></Field>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="ms-btn" @onclick="() => mode = null">Cancel</button>
        <button type="button" class="ms-btn @(mode == Pay ? "primary" : "danger") @(busy ? "busy" : "")" @onclick="Confirm">@if (busy) { <span class="ms-spin"></span> }Confirm</button>
    </Footer>
</Modal>

@code {
    [Parameter] public int Id { get; set; }

    private const string Pay = "pay", Fail = "fail";
    private DividendPaymentDto? p;
    private bool loading = true, busy;
    private string error = "", remarks = "", method = "Bank Transfer";
    private string? mode;
    private DateTime date = DateTime.Today;

    protected override async Task OnParametersSetAsync() => await Load();

    private async Task Load()
    {
        loading = true; error = "";
        try
        {
            var http = HttpClientFactory.CreateClient("ApiClient");
            var r = await http.GetAsync($"api/dividends/payments/{Id}");
            if (r.IsSuccessStatusCode) p = await r.Content.ReadFromJsonAsync<DividendPaymentDto>();
            else { p = null; if (r.StatusCode != System.Net.HttpStatusCode.NotFound) error = $"The server answered {(int)r.StatusCode}."; }
        }
        catch (Exception ex) { p = null; error = ex.Message; }
        finally { loading = false; }
    }

    private async Task Confirm()
    {
        if (p == null) return;
        busy = true;
        try
        {
            var http = HttpClientFactory.CreateClient("ApiClient");
            HttpResponseMessage r = mode == Pay
                ? await http.PostAsJsonAsync($"api/dividends/payments/{Id}/process", new { PaymentDate = date, PaymentMethod = method, Remarks = remarks })
                : await http.PostAsJsonAsync($"api/dividends/payments/{Id}/fail", remarks);
            if (r.IsSuccessStatusCode)
            {
                await JS.InvokeVoidAsync("ms.toast", "success", mode == Pay ? "Payment recorded" : "Payment marked failed");
                mode = null; remarks = ""; await Load();
            }
            else await JS.InvokeVoidAsync("ms.toast", "error", "Couldn't update payment", $"The server answered {(int)r.StatusCode}.");
        }
        catch (Exception ex) { await JS.InvokeVoidAsync("ms.toast", "error", "Couldn't update payment", ex.Message); }
        finally { busy = false; }
    }

    private void Back() => NavigationManager.NavigateTo("/dividends");
    private async Task Print() => await JS.InvokeVoidAsync("print");
}

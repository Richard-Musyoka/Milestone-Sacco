@page "/guarantors/add"
@inject NavigationManager NavigationManager
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS
@using SaccoManagementSystem.Security
@inject AuthenticationStateProvider AuthState

<PageTitle>Add guarantor · @Brand.Name</PageTitle>

<div class="ms-page">
    <button type="button" class="ms-back" @onclick="Back"><i class="bi bi-arrow-left"></i> Guarantors</button>
    <PageHeader Title="Add a guarantor" Subtitle="Record someone who can stand behind a member's loan." />
    <GuarantorForm Model="model" Busy="saving" ErrorMessage="@error" OnValidSubmit="Save" OnCancel="Back" />
</div>

@code {
    [CascadingParameter] public DrawerContext? Drawer { get; set; }
    private Task Leave(string url) { if (Drawer != null) return Drawer.Saved(); NavigationManager.NavigateTo(url); return Task.CompletedTask; }

    private GuarantorForm.GuarantorInput model = new() { IsActive = true };
    private bool saving;
    private string error = "";

    private sealed class Created { public int GuarantorId { get; set; } }

    private async Task Save()
    {
        saving = true; error = "";
        model.CreatedBy = await CurrentUserId();
        try
        {
            var http = HttpClientFactory.CreateClient("ApiClient");
            var r = await http.PostAsJsonAsync("api/guarantors", model);
            if (r.IsSuccessStatusCode)
            {
                var res = await r.Content.ReadFromJsonAsync<Created>();
                await JS.InvokeVoidAsync("ms.toast", "success", "Guarantor added", $"{model.FirstName} {model.LastName}");
                await Leave(res?.GuarantorId > 0 ? $"/guarantors/view/{res.GuarantorId}" : "/guarantors");
                return;
            }
            error = await r.Content.ReadAsStringAsync();
            if (string.IsNullOrWhiteSpace(error)) error = "The server couldn't save this guarantor.";
        }
        catch (Exception ex) { error = $"Something went wrong: {ex.Message}"; }
        finally { saving = false; }
    }

    private Task Back() { if (Drawer != null) return Drawer.Close(); NavigationManager.NavigateTo("/guarantors"); return Task.CompletedTask; }
    private async Task<int> CurrentUserId()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        return AuthService.UserId(state.User) ?? 1;
    }
}

@page "/guarantors/edit/{GuarantorId:int}"
@inject NavigationManager NavigationManager
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS

<PageTitle>Edit guarantor · @Brand.Name</PageTitle>

<div class="ms-page">
    <button type="button" class="ms-back" @onclick="Back"><i class="bi bi-arrow-left"></i> Guarantor</button>
    <PageHeader Title="Edit guarantor" Subtitle="@($"{model?.FirstName} {model?.LastName}")" />

    @if (loading)
    {
        <div class="ms-skel" style="height:220px;max-width:980px;margin-bottom:16px"></div>
        <div class="ms-skel" style="height:220px;max-width:980px"></div>
    }
    else if (model == null)
    {
        <div class="ms-card"><EmptyState Icon="bi-person-x" Title="Guarantor not found" Text="@(string.IsNullOrEmpty(error) ? "They may have been removed." : error)">
            <div style="margin-top:14px"><a class="ms-btn" href="guarantors">Back to guarantors</a></div></EmptyState></div>
    }
    else
    {
        <GuarantorForm Model="model" IsEdit="true" Busy="saving" ErrorMessage="@error" OnValidSubmit="Save" OnCancel="Back" />
    }
</div>

@code {
    [CascadingParameter] public DrawerContext? Drawer { get; set; }
    private void Go(string url) { if (Drawer != null) _ = Drawer.Saved(); else NavigationManager.NavigateTo(url); }
    private void Dismiss(string url) { if (Drawer != null) _ = Drawer.Close(); else NavigationManager.NavigateTo(url); }

    [Parameter] public int GuarantorId { get; set; }

    private GuarantorForm.GuarantorInput? model;
    private bool loading = true, saving;
    private string error = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var http = HttpClientFactory.CreateClient("ApiClient");
            var r = await http.GetAsync($"api/guarantors/{GuarantorId}");
            if (r.IsSuccessStatusCode) model = await r.Content.ReadFromJsonAsync<GuarantorForm.GuarantorInput>();
            else if (r.StatusCode != System.Net.HttpStatusCode.NotFound) error = $"The server answered {(int)r.StatusCode}.";
        }
        catch (Exception ex) { error = ex.Message; }
        finally { loading = false; }
    }

    private async Task Save()
    {
        if (model == null) return;
        saving = true; error = "";
        try
        {
            var http = HttpClientFactory.CreateClient("ApiClient");
            var r = await http.PutAsJsonAsync($"api/guarantors/{GuarantorId}", model);
            if (r.IsSuccessStatusCode)
            {
                await JS.InvokeVoidAsync("ms.toast", "success", "Guarantor updated");
                Go($"/guarantors/view/{GuarantorId}");
                return;
            }
            error = await r.Content.ReadAsStringAsync();
            if (string.IsNullOrWhiteSpace(error)) error = "The server couldn't save your changes.";
        }
        catch (Exception ex) { error = $"Something went wrong: {ex.Message}"; }
        finally { saving = false; }
    }

    private void Back() => Dismiss($"/guarantors/view/{GuarantorId}");
}

@page "/guarantors"
@inject NavigationManager NavigationManager
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS

<PageTitle>Guarantors · @Brand.Name</PageTitle>

<div class="ms-page">
    <PageHeader Title="Guarantors" Subtitle="People who back member loans — internal and external.">
        <a class="ms-btn primary" href="guarantors/add"><i class="bi bi-person-plus"></i> Add guarantor</a>
    </PageHeader>

    @if (!loading && !failed)
    {
        <div class="ms-mini">
            <div><small>Total</small><b>@items.Count</b></div>
            <div><small>Active</small><b>@items.Count(x => x.IsActive)</b></div>
            <div><small>Inactive</small><b>@items.Count(x => !x.IsActive)</b></div>
            <div><small>Added this month</small><b>@items.Count(x => x.CreatedDate.Year == DateTime.Today.Year && x.CreatedDate.Month == DateTime.Today.Month)</b></div>
        </div>
    }

    <div class="ms-card">
        <div class="ms-toolbar">
            <div class="ms-searchbox">
                <i class="bi bi-search"></i>
                <input class="ms-input" type="search" placeholder="Search name, ID or phone…" aria-label="Search guarantors" @bind="search" @bind:event="oninput" @bind:after="ResetPage" />
            </div>
            <div class="ms-chips" role="group" aria-label="Filter by status">
                @foreach (var s in Statuses)
                {
                    <button type="button" class="ms-chip @(status == s ? "on" : "")" @onclick="() => SetStatus(s)">@s<em>@(s == "All" ? items.Count : s == "Active" ? items.Count(x => x.IsActive) : items.Count(x => !x.IsActive))</em></button>
                }
            </div>
        </div>

        @if (loading)
        {
            <div class="ms-card-body">@for (int i = 0; i < 6; i++) { <div class="ms-skel" style="height:52px;margin-bottom:10px"></div> }</div>
        }
        else if (failed)
        {
            <EmptyState Icon="bi-wifi-off" Title="Couldn't load guarantors" Text="@error">
                <div style="margin-top:14px"><button class="ms-btn" @onclick="Load"><i class="bi bi-arrow-clockwise"></i> Retry</button></div>
            </EmptyState>
        }
        else if (!Filtered.Any())
        {
            <EmptyState Icon="bi-shield-check" Title="No guarantors found" Text="Try a different search, or add a guarantor.">
                <div style="margin-top:14px"><a class="ms-btn primary" href="guarantors/add">Add guarantor</a></div>
            </EmptyState>
        }
        else
        {
            <div class="ms-table-wrap">
                <table class="ms-table">
                    <thead><tr><th>Guarantor</th><th>ID number</th><th>Phone</th><th>Added</th><th>Status</th><th class="r" style="width:150px"></th></tr></thead>
                    <tbody>
                        @foreach (var x in PageItems)
                        {
                            <tr class="clickable" @onclick="() => View(x.GuarantorId)">
                                <td><div class="ms-cell-person"><Avatar Name="@($"{x.FirstName} {x.LastName}")" Size="sm" /><div><b>@x.FirstName @x.LastName</b><small>@x.Email</small></div></div></td>
                                <td class="ms-num">@x.IDNumber</td>
                                <td class="ms-num">@(string.IsNullOrWhiteSpace(x.PhoneNumber) ? "—" : x.PhoneNumber)</td>
                                <td class="ms-num">@x.CreatedDate.ToString("d MMM yyyy")</td>
                                <td><StatusPill Status="@(x.IsActive ? "Active" : "Inactive")" /></td>
                                <td @onclick:stopPropagation="true">
                                    <div class="ms-row-actions">
                                        <button class="ms-ib" title="View" aria-label="View @x.FirstName @x.LastName" @onclick="() => View(x.GuarantorId)"><i class="bi bi-eye"></i></button>
                                        <button class="ms-ib" title="Edit" aria-label="Edit @x.FirstName @x.LastName" @onclick="() => Edit(x.GuarantorId)"><i class="bi bi-pencil"></i></button>
                                        <button class="ms-ib danger" title="Delete" aria-label="Delete @x.FirstName @x.LastName" @onclick="() => toDelete = x"><i class="bi bi-trash3"></i></button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <Pager Total="Filtered.Count()" @bind-Page="page" @bind-PageSize="pageSize" />
        }
    </div>
</div>

<ConfirmDialog Open="toDelete != null" Danger="true" Title="Delete guarantor" ConfirmText="Delete" Busy="busy" OnConfirm="Delete" OnCancel="() => toDelete = null">
    <p style="margin:0 0 6px">Delete <b>@toDelete?.FirstName @toDelete?.LastName</b>?</p>
    <p class="ms-hint" style="margin:0">Guarantors attached to loans may be refused by the server.</p>
</ConfirmDialog>

@code {
    private static readonly string[] Statuses = { "All", "Active", "Inactive" };

    private List<Row> items = new();
    private string search = "", status = "All", error = "";
    private bool loading = true, failed, busy;
    private int page = 1, pageSize = 10;
    private Row? toDelete;

    private IEnumerable<Row> Filtered => items
        .Where(x => status == "All" || (status == "Active") == x.IsActive)
        .Where(x => string.IsNullOrWhiteSpace(search)
            || $"{x.FirstName} {x.LastName}".Contains(search.Trim(), StringComparison.OrdinalIgnoreCase)
            || (x.IDNumber ?? "").Contains(search.Trim(), StringComparison.OrdinalIgnoreCase)
            || (x.PhoneNumber ?? "").Contains(search.Trim()))
        .OrderBy(x => x.LastName).ThenBy(x => x.FirstName);

    private IEnumerable<Row> PageItems => Filtered.Skip((page - 1) * pageSize).Take(pageSize);

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        loading = true; failed = false; error = "";
        try
        {
            var http = HttpClientFactory.CreateClient("ApiClient");
            var r = await http.GetAsync("api/guarantors");
            if (r.IsSuccessStatusCode) items = await r.Content.ReadFromJsonAsync<List<Row>>() ?? new();
            else { failed = true; error = $"The server answered {(int)r.StatusCode}."; }
        }
        catch (Exception ex) { failed = true; error = ex.Message; }
        finally { loading = false; }
    }

    private void ResetPage() => page = 1;
    private void SetStatus(string s) { status = s; page = 1; }
    private void View(int id) => NavigationManager.NavigateTo($"/guarantors/view/{id}");
    private void Edit(int id) => NavigationManager.NavigateTo($"/guarantors/edit/{id}");

    private async Task Delete()
    {
        if (toDelete == null) return;
        busy = true;
        try
        {
            var http = HttpClientFactory.CreateClient("ApiClient");
            var r = await http.DeleteAsync($"api/guarantors/{toDelete.GuarantorId}");
            if (r.IsSuccessStatusCode) { await JS.InvokeVoidAsync("ms.toast", "success", "Guarantor deleted"); await Load(); }
            else
            {
                var body = await r.Content.ReadAsStringAsync();
                await JS.InvokeVoidAsync("ms.toast", "error", "Couldn't delete guarantor", string.IsNullOrWhiteSpace(body) ? $"The server answered {(int)r.StatusCode}." : body);
            }
        }
        catch (Exception ex) { await JS.InvokeVoidAsync("ms.toast", "error", "Couldn't delete guarantor", ex.Message); }
        finally { busy = false; toDelete = null; }
    }

    private sealed class Row
    {
        public int GuarantorId { get; set; }
        public string FirstName { get; set; } = "";
        public string LastName { get; set; } = "";
        public string? PhoneNumber { get; set; }
        public string? Email { get; set; }
        public string? IDNumber { get; set; }
        public DateTime CreatedDate { get; set; }
        public bool IsActive { get; set; }
    }
}

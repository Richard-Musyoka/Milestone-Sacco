@page "/guarantors/view/{GuarantorId:int}"
@inject NavigationManager NavigationManager
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS

<PageTitle>@(g == null ? "Guarantor" : $"{g.FirstName} {g.LastName}") · @Brand.Name</PageTitle>

<div class="ms-page">
    <button type="button" class="ms-back" @onclick="Back"><i class="bi bi-arrow-left"></i> Guarantors</button>

    @if (loading)
    {
        <div class="ms-skel" style="height:150px;border-radius:20px"></div>
        <div class="ms-skel ms-mt" style="height:260px"></div>
    }
    else if (g == null)
    {
        <div class="ms-card"><EmptyState Icon="bi-person-x" Title="Guarantor not found" Text="@(string.IsNullOrEmpty(error) ? "They may have been removed." : error)">
            <div style="margin-top:14px"><button class="ms-btn" @onclick="Back">Back to guarantors</button></div></EmptyState></div>
    }
    else
    {
        <section class="ms-hero">
            <Avatar Name="@($"{g.FirstName} {g.LastName}")" Size="xl" />
            <div style="position:relative;z-index:1">
                <div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap"><h2>@g.FirstName @g.LastName</h2><StatusPill Status="@(g.IsActive ? "Active" : "Inactive")" /></div>
                <div class="meta">
                    <span><i class="bi bi-person-vcard"></i>@g.IDNumber</span>
                    @if (!string.IsNullOrWhiteSpace(g.PhoneNumber)) { <span><i class="bi bi-telephone"></i>@g.PhoneNumber</span> }
                    @if (!string.IsNullOrWhiteSpace(g.Email)) { <span><i class="bi bi-envelope"></i>@g.Email</span> }
                </div>
            </div>
            <div class="ms-hero-actions">
                <a class="ms-btn primary" href="guarantors/edit/@g.GuarantorId"><i class="bi bi-pencil"></i> Edit</a>
                <button class="ms-btn" @onclick="() => showDelete = true"><i class="bi bi-trash3"></i> Delete</button>
            </div>
        </section>

        <div class="ms-grid two ms-mt">
            <section class="ms-card">
                <div class="ms-card-head"><div><h3>Personal</h3></div></div>
                <div class="ms-card-body ms-kv">
                    <div><small>ID number</small><b>@g.IDNumber</b></div>
                    <div><small>Date of birth</small>@Val(g.DateOfBirth?.ToString("d MMMM yyyy"))</div>
                    <div><small>Added</small><b>@g.CreatedDate.ToString("d MMM yyyy")</b></div>
                    <div><small>Last modified</small><b>@g.LastModifiedDate.ToString("d MMM yyyy")</b></div>
                </div>
            </section>
            <section class="ms-card">
                <div class="ms-card-head"><div><h3>Contact</h3></div></div>
                <div class="ms-card-body ms-kv">
                    <div><small>Phone</small>@Val(g.PhoneNumber)</div>
                    <div><small>Email</small>@Val(g.Email)</div>
                    <div><small>Address</small>@Val(g.PhysicalAddress)</div>
                </div>
            </section>
            <section class="ms-card" style="grid-column:1/-1">
                <div class="ms-card-head"><div><h3>Remarks</h3></div></div>
                <div class="ms-card-body">@(string.IsNullOrWhiteSpace(g.Remarks) ? "No remarks." : g.Remarks)</div>
            </section>
        </div>
    }
</div>

<ConfirmDialog Open="showDelete" Danger="true" Title="Delete guarantor" ConfirmText="Delete" Busy="busy" OnConfirm="Delete" OnCancel="() => showDelete = false">
    <p style="margin:0 0 6px">Delete <b>@g?.FirstName @g?.LastName</b>?</p>
    <p class="ms-hint" style="margin:0">Guarantors attached to loans may be refused by the server. Consider marking them inactive instead.</p>
</ConfirmDialog>

@code {
    [Parameter] public int GuarantorId { get; set; }

    private GuarantorRecord? g;
    private bool loading = true, showDelete, busy;
    private string error = "";

    private static RenderFragment Val(string? v) => b =>
    {
        b.OpenElement(0, "b");
        if (string.IsNullOrWhiteSpace(v)) { b.AddAttribute(1, "class", "empty"); b.AddContent(2, "Not provided"); }
        else b.AddContent(3, v);
        b.CloseElement();
    };

    protected override async Task OnParametersSetAsync()
    {
        loading = true; error = "";
        try
        {
            var http = HttpClientFactory.CreateClient("ApiClient");
            var r = await http.GetAsync($"api/guarantors/{GuarantorId}");
            if (r.IsSuccessStatusCode) g = await r.Content.ReadFromJsonAsync<GuarantorRecord>();
            else { g = null; if (r.StatusCode != System.Net.HttpStatusCode.NotFound) error = $"The server answered {(int)r.StatusCode}."; }
        }
        catch (Exception ex) { g = null; error = ex.Message; }
        finally { loading = false; }
    }

    private async Task Delete()
    {
        busy = true;
        try
        {
            var http = HttpClientFactory.CreateClient("ApiClient");
            var r = await http.DeleteAsync($"api/guarantors/{GuarantorId}");
            if (r.IsSuccessStatusCode)
            {
                await JS.InvokeVoidAsync("ms.toast", "success", "Guarantor deleted");
                NavigationManager.NavigateTo("/guarantors");
                return;
            }
            var body = await r.Content.ReadAsStringAsync();
            await JS.InvokeVoidAsync("ms.toast", "error", "Couldn't delete guarantor", string.IsNullOrWhiteSpace(body) ? $"The server answered {(int)r.StatusCode}." : body);
        }
        catch (Exception ex) { await JS.InvokeVoidAsync("ms.toast", "error", "Couldn't delete guarantor", ex.Message); }
        finally { busy = false; showDelete = false; }
    }

    private void Back() => NavigationManager.NavigateTo("/guarantors");

    private sealed class GuarantorRecord
    {
        public int GuarantorId { get; set; }
        public string FirstName { get; set; } = "";
        public string LastName { get; set; } = "";
        public string? PhoneNumber { get; set; }
        public string? Email { get; set; }
        public DateTime? DateOfBirth { get; set; }
        public string IDNumber { get; set; } = "";
        public string? PhysicalAddress { get; set; }
        public DateTime CreatedDate { get; set; }
        public DateTime LastModifiedDate { get; set; }
        public bool IsActive { get; set; }
        public string? Remarks { get; set; }
    }
}

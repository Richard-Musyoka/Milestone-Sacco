@page "/loans"
@using SaccoManagementSystem.Models
@inject NavigationManager NavigationManager
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS

<PageTitle>Loans · @Brand.Name</PageTitle>

<div class="ms-page">
    <PageHeader Title="Loans" Subtitle="Applications, approvals and disbursements in one place.">
        <a class="ms-btn primary" href="loans/apply"><i class="bi bi-plus-lg"></i> New loan application</a>
    </PageHeader>

    @if (!loading && !failed)
    {
        <div class="ms-mini">
            <div><small>Total lent (filtered)</small><b>KES @Money(Scoped.Sum(x => x.PrincipalAmount))</b></div>
            <div><small>Awaiting approval</small><b>@Scoped.Count(x => x.Status == "Pending")</b></div>
            <div><small>Ready to disburse</small><b>@Scoped.Count(x => x.Status == "Approved")</b></div>
            <div><small>Outstanding balance</small><b>KES @Money(Scoped.Where(x => x.Status == "Disbursed").Sum(x => x.OutstandingBalance ?? x.PrincipalAmount))</b></div>
        </div>
    }

    <div class="ms-card">
        <div class="ms-toolbar">
            <div class="ms-searchbox">
                <i class="bi bi-search"></i>
                <input class="ms-input" type="search" placeholder="Search member, member no or loan no…" aria-label="Search loans" @bind="search" @bind:event="oninput" @bind:after="ResetPage" />
            </div>
            <div class="ms-chips" role="group" aria-label="Filter by status">
                @foreach (var s in Statuses)
                {
                    <button type="button" class="ms-chip @(status == s ? "on" : "")" @onclick="() => SetStatus(s)">@s<em>@(s == "All" ? Scoped.Count() : Scoped.Count(x => x.Status == s))</em></button>
                }
            </div>
            <div class="ms-toolbar-end">
                <select class="ms-select" aria-label="Filter by loan type" @bind="type" @bind:after="ResetPage">
                    <option value="">All types</option>
                    @foreach (var t in items.Select(x => x.LoanType).Where(x => !string.IsNullOrEmpty(x)).Distinct().OrderBy(x => x)) { <option value="@t">@t</option> }
                </select>
            </div>
        </div>

        @if (loading)
        {
            <div class="ms-card-body">@for (int i = 0; i < 6; i++) { <div class="ms-skel" style="height:56px;margin-bottom:10px"></div> }</div>
        }
        else if (failed)
        {
            <EmptyState Icon="bi-wifi-off" Title="Couldn't load loans" Text="@error">
                <div style="margin-top:14px"><button class="ms-btn" @onclick="Load"><i class="bi bi-arrow-clockwise"></i> Retry</button></div>
            </EmptyState>
        }
        else if (!Filtered.Any())
        {
            <EmptyState Icon="bi-cash-coin" Title="No loans found" Text="Try a different search or filter, or start a new application.">
                <div style="margin-top:14px"><a class="ms-btn primary" href="loans/apply">New loan application</a></div>
            </EmptyState>
        }
        else
        {
            <div class="ms-table-wrap">
                <table class="ms-table">
                    <thead>
                        <tr><th>Loan</th><th>Member</th><th>Type</th><th class="r">Principal</th><th class="r">Monthly</th><th class="r">Balance</th><th>Applied</th><th>Status</th><th class="r" style="width:210px"></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var l in PageItems)
                        {
                            <tr class="clickable" @onclick="() => View(l.LoanId)">
                                <td class="ms-num"><b>@l.LoanNumber</b></td>
                                <td><div class="ms-cell-person"><Avatar Name="@l.MemberName" Size="sm" /><div><b>@l.MemberName</b><small>@l.MemberNo</small></div></div></td>
                                <td>@l.LoanType</td>
                                <td class="r ms-num"><b>KES @l.PrincipalAmount.ToString("N0")</b><small style="display:block;color:var(--ms-text-3)">@l.TermMonths mo @@ @l.InterestRate.ToString("0.##")%</small></td>
                                <td class="r ms-num">@(l.MonthlyInstallment.HasValue ? "KES " + l.MonthlyInstallment.Value.ToString("N0") : "—")</td>
                                <td class="r ms-num">@(l.OutstandingBalance.HasValue ? "KES " + l.OutstandingBalance.Value.ToString("N0") : "—")</td>
                                <td class="ms-num">@l.ApplicationDate.ToString("d MMM yyyy")</td>
                                <td><StatusPill Status="@l.Status" /></td>
                                <td @onclick:stopPropagation="true">
                                    <div class="ms-row-actions">
                                        @if (l.Status == "Pending")
                                        {
                                            <button class="ms-btn sm primary" @onclick="() => Ask(l, Approve)">Approve</button>
                                            <button class="ms-btn sm" @onclick="() => Ask(l, Reject)">Reject</button>
                                        }
                                        else if (l.Status == "Approved")
                                        {
                                            <button class="ms-btn sm primary" @onclick="() => Ask(l, Disburse)">Disburse</button>
                                        }
                                        @if (l.Status is "Disbursed" or "Completed")
                                        {
                                            <button class="ms-ib" title="Repayment schedule" aria-label="Repayment schedule for @l.LoanNumber" @onclick="() => Schedule(l.LoanId)"><i class="bi bi-calendar3"></i></button>
                                        }
                                        <button class="ms-ib" title="View" aria-label="View @l.LoanNumber" @onclick="() => View(l.LoanId)"><i class="bi bi-eye"></i></button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <Pager Total="Filtered.Count()" @bind-Page="page" @bind-PageSize="pageSize" />
        }
    </div>
</div>

<Modal Open="IsDecision" OnClose="Cancel" Title="@DecisionTitle" Subtitle="@DecisionSubtitle">
    <ChildContent>
        @if (action == Approve)
        {
            <div class="ms-grid-form">
                <Field Class="c6" Label="Interest rate (% p.a.)"><input class="ms-input" type="number" step="0.1" min="0" @bind="rate" /></Field>
                <Field Class="c6" Label="Repayment period (months)"><input class="ms-input" type="number" min="1" @bind="term" /></Field>
                <Field Class="c12" Label="Remarks (optional)"><textarea class="ms-input" @bind="remarks"></textarea></Field>
            </div>
        }
        else
        {
            <Field Label="Reason for rejection" Hint="Shared with the member and kept in the audit trail."><textarea class="ms-input" placeholder="Explain why this application is being declined" @bind="remarks"></textarea></Field>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="ms-btn" @onclick="Cancel">Cancel</button>
        <button type="button" class="ms-btn @(action == Approve ? "primary" : "danger") @(busy ? "busy" : "")" @onclick="Confirm">@if (busy) { <span class="ms-spin"></span> }@(action == Approve ? "Approve loan" : "Reject loan")</button>
    </Footer>
</Modal>

<ConfirmDialog Open="action == Disburse" Title="Disburse loan" ConfirmText="Disburse funds" Busy="busy" OnConfirm="Confirm" OnCancel="Cancel">
    <p style="margin:0 0 6px">Release <b>KES @target?.PrincipalAmount.ToString("N0")</b> to <b>@target?.MemberName</b> (@target?.LoanNumber)?</p>
    <p class="ms-hint" style="margin:0">The repayment schedule starts once the loan is disbursed.</p>
</ConfirmDialog>

@code {
    private static readonly string[] Statuses = { "All", "Pending", "Approved", "Disbursed", "Rejected" };

    private List<LoanViewModel> items = new();
    private string search = "", status = "All", type = "", error = "";
    private bool loading = true, failed, busy;
    private int page = 1, pageSize = 10;

    private const string Approve = "Approve", Reject = "Reject", Disburse = "Disburse";
    private bool IsDecision => action == Approve || action == Reject;
    private string DecisionTitle => action + " loan";
    private string DecisionSubtitle => target == null ? "" : $"{target.LoanNumber} · {target.MemberName} · KES {target.PrincipalAmount:N0}";

    private LoanViewModel? target;
    private string action = "";
    private double rate = 10;
    private int term = 12;
    private string remarks = "";

    private IEnumerable<LoanViewModel> Scoped => items
        .Where(x => string.IsNullOrEmpty(type) || x.LoanType == type)
        .Where(x => string.IsNullOrWhiteSpace(search)
            || (x.MemberName ?? "").Contains(search.Trim(), StringComparison.OrdinalIgnoreCase)
            || (x.LoanNumber ?? "").Contains(search.Trim(), StringComparison.OrdinalIgnoreCase)
            || (x.MemberNo ?? "").Contains(search.Trim(), StringComparison.OrdinalIgnoreCase));

    private IEnumerable<LoanViewModel> Filtered => Scoped.Where(x => status == "All" || x.Status == status).OrderByDescending(x => x.ApplicationDate);
    private IEnumerable<LoanViewModel> PageItems => Filtered.Skip((page - 1) * pageSize).Take(pageSize);

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        loading = true; failed = false; error = "";
        try
        {
            var http = HttpClientFactory.CreateClient("ApiClient");
            var r = await http.GetAsync("api/loans/get-all");
            if (r.IsSuccessStatusCode) items = await r.Content.ReadFromJsonAsync<List<LoanViewModel>>() ?? new();
            else { failed = true; error = $"The server answered {(int)r.StatusCode}."; }
        }
        catch (Exception ex) { failed = true; error = ex.Message; }
        finally { loading = false; }
    }

    private static string Money(decimal v)
    {
        var a = Math.Abs(v);
        if (a >= 1_000_000m) return (v / 1_000_000m).ToString("0.##") + "M";
        if (a >= 10_000m) return (v / 1_000m).ToString("0.#") + "K";
        return v.ToString("N0");
    }

    private void ResetPage() => page = 1;
    private void SetStatus(string s) { status = s; page = 1; }
    private void View(int id) => NavigationManager.NavigateTo($"/loans/view/{id}");
    private void Schedule(int id) => NavigationManager.NavigateTo($"/loans/schedule/{id}");

    private void Ask(LoanViewModel l, string a)
    {
        target = l; action = a; remarks = "";
        rate = l.InterestRate > 0 ? (double)l.InterestRate : 10;
        term = l.TermMonths > 0 ? l.TermMonths : 12;
    }

    private void Cancel() { action = ""; target = null; remarks = ""; }

    private async Task Confirm()
    {
        if (target == null) return;
        busy = true;
        var http = HttpClientFactory.CreateClient("ApiClient");
        try
        {
            HttpResponseMessage r;
            string done;
            switch (action)
            {
                case Approve:
                    r = await http.PutAsJsonAsync($"api/loans/approve/{target.LoanId}", new { InterestRate = (decimal)rate, TermMonths = term, Remarks = remarks });
                    done = "Loan approved"; break;
                case Reject:
                    r = await http.PutAsJsonAsync($"api/loans/reject/{target.LoanId}", remarks);
                    done = "Loan rejected"; break;
                default:
                    r = await http.PutAsync($"api/loans/disburse/{target.LoanId}", null);
                    done = "Loan disbursed"; break;
            }
            if (r.IsSuccessStatusCode)
            {
                await JS.InvokeVoidAsync("ms.toast", "success", done, target.LoanNumber);
                Cancel();
                await Load();
            }
            else await JS.InvokeVoidAsync("ms.toast", "error", $"Couldn't {action.ToLower()} loan", $"The server answered {(int)r.StatusCode}.");
        }
        catch (Exception ex) { await JS.InvokeVoidAsync("ms.toast", "error", $"Couldn't {action.ToLower()} loan", ex.Message); }
        finally { busy = false; }
    }
}

@page "/loans/schedule/{LoanId:int}"
@using SaccoManagementSystem.Models
@inject NavigationManager NavigationManager
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS

<PageTitle>Repayment schedule · @Brand.Name</PageTitle>

<div class="ms-page">
    <button type="button" class="ms-back" @onclick="Back"><i class="bi bi-arrow-left"></i> Loans</button>
    <PageHeader Title="Repayment schedule" Subtitle="@(loan == null ? "" : $"{loan.LoanNumber} · {loan.MemberName} · {loan.LoanType} loan")">
        @if (loan != null) { <a class="ms-btn" href="loans/view/@loan.LoanId"><i class="bi bi-eye"></i> Loan details</a> }
        <button class="ms-btn" @onclick="Print"><i class="bi bi-printer"></i> Print</button>
    </PageHeader>

    @if (loading)
    {
        <div class="ms-grid stats">@for (int i = 0; i < 4; i++) { <div class="ms-skel" style="height:110px"></div> }</div>
        <div class="ms-skel ms-mt" style="height:320px"></div>
    }
    else if (loan == null)
    {
        <div class="ms-card"><EmptyState Icon="bi-calendar-x" Title="Loan not found" Text="@(string.IsNullOrEmpty(error) ? "We couldn't load this loan." : error)" /></div>
    }
    else if (schedule.Count == 0)
    {
        <div class="ms-card"><EmptyState Icon="bi-calendar3" Title="No schedule yet" Text="A repayment schedule is generated when the loan is disbursed.">
            <div style="margin-top:14px"><a class="ms-btn primary" href="loans/view/@loan.LoanId">Back to loan</a></div></EmptyState></div>
    }
    else
    {
        <div class="ms-grid stats">
            <StatCard Label="Total repayable" Icon="bi-receipt" Prefix="KES" Value="@TotalRepayable.ToString("N0")" Foot="@($"KES {TotalInterest:N0} interest")" />
            <StatCard Label="Paid so far" Icon="bi-check2-circle" Prefix="KES" Value="@TotalPaid.ToString("N0")" Foot="@($"{PaidCount} of {schedule.Count} instalments")" />
            <StatCard Label="Balance" Icon="bi-hourglass-split" Tone="gold" Prefix="KES" Value="@Balance.ToString("N0")" />
            <StatCard Label="Overdue" Icon="bi-exclamation-triangle" Tone="red" Value="@OverdueCount.ToString()" Foot="instalments" />
        </div>

        <div class="ms-card ms-mt" style="padding:16px 18px">
            <div style="display:flex;justify-content:space-between;font-weight:700;font-size:13px;margin-bottom:8px"><span>Repayment progress</span><span>@Pct.ToString("0")%</span></div>
            <div class="ms-bar"><i style="width:@(Pct.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></i></div>
        </div>

        <div class="ms-card ms-mt">
            <div class="ms-table-wrap">
                <table class="ms-table">
                    <thead><tr><th>#</th><th>Due date</th><th class="r">Principal</th><th class="r">Interest</th><th class="r">Total due</th><th>Status</th><th>Paid on</th><th class="r" style="width:120px"></th></tr></thead>
                    <tbody>
                        @foreach (var i in schedule)
                        {
                            var st = StatusOf(i);
                            <tr>
                                <td class="ms-num">@i.InstallmentNumber</td>
                                <td class="ms-num">@i.DueDate.ToString("d MMM yyyy")</td>
                                <td class="r ms-num">@i.Principal.ToString("N0")</td>
                                <td class="r ms-num">@i.Interest.ToString("N0")</td>
                                <td class="r ms-num"><b>KES @i.TotalDue.ToString("N0")</b></td>
                                <td><StatusPill Status="@st" /></td>
                                <td class="ms-num">@(i.PaymentDate?.ToString("d MMM yyyy") ?? "—")</td>
                                <td class="r">@if (st != "Paid") { <button class="ms-btn sm primary" @onclick="() => Pay(i)">Mark paid</button> }</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<Modal Open="toPay != null" OnClose="Close" Title="Record payment" Subtitle="@(toPay == null ? "" : $"Instalment {toPay.InstallmentNumber} · KES {toPay.TotalDue:N0}")">
    <ChildContent>
        @if (!string.IsNullOrEmpty(error)) { <div class="ms-alert bad"><i class="bi bi-exclamation-circle-fill"></i><div>@error</div></div> }
        <Field Label="Payment date"><input class="ms-input" type="date" @bind="payDate" /></Field>
    </ChildContent>
    <Footer>
        <button type="button" class="ms-btn" @onclick="Close">Cancel</button>
        <button type="button" class="ms-btn primary @(busy ? "busy" : "")" @onclick="Confirm">@if (busy) { <span class="ms-spin"></span> }Confirm payment</button>
    </Footer>
</Modal>

@code {
    [Parameter] public int LoanId { get; set; }

    private LoanViewModel? loan;
    private List<InstallmentViewModel> schedule = new();
    private bool loading = true, busy;
    private string error = "";
    private InstallmentViewModel? toPay;
    private DateTime payDate = DateTime.Today;

    private string StatusOf(InstallmentViewModel i) => i.Status == "Paid" ? "Paid" : (i.DueDate.Date < DateTime.Today ? "Overdue" : "Pending");
    private decimal TotalInterest => schedule.Sum(i => i.Interest);
    private decimal TotalRepayable => schedule.Sum(i => i.TotalDue);
    private decimal TotalPaid => schedule.Where(i => i.Status == "Paid").Sum(i => i.TotalDue);
    private decimal Balance => TotalRepayable - TotalPaid;
    private int PaidCount => schedule.Count(i => i.Status == "Paid");
    private int OverdueCount => schedule.Count(i => StatusOf(i) == "Overdue");
    private double Pct => schedule.Count == 0 ? 0 : PaidCount * 100.0 / schedule.Count;

    protected override async Task OnInitializedAsync()
    {
        var http = HttpClientFactory.CreateClient("ApiClient");
        try
        {
            var l = http.GetAsync($"api/loans/get/{LoanId}");
            var s = http.GetAsync($"api/loans/installments/{LoanId}");
            await Task.WhenAll(l, s);
            if (l.Result.IsSuccessStatusCode) loan = await l.Result.Content.ReadFromJsonAsync<LoanViewModel>();
            if (s.Result.IsSuccessStatusCode) schedule = (await s.Result.Content.ReadFromJsonAsync<List<InstallmentViewModel>>() ?? new()).OrderBy(i => i.InstallmentNumber).ToList();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { loading = false; }
    }

    private void Pay(InstallmentViewModel i) { toPay = i; payDate = DateTime.Today; error = ""; }
    private void Close() { toPay = null; error = ""; }
    private void Back() => NavigationManager.NavigateTo("/loans");
    private async Task Print() => await JS.InvokeVoidAsync("print");

    private async Task Confirm()
    {
        if (toPay == null) return;
        busy = true; error = "";
        try
        {
            var http = HttpClientFactory.CreateClient("ApiClient");
            var r = await http.PutAsJsonAsync("api/loans/mark-paid", new { InstallmentId = toPay.InstallmentId, PaymentDate = payDate });
            if (r.IsSuccessStatusCode)
            {
                await JS.InvokeVoidAsync("ms.toast", "success", "Payment recorded", $"Instalment {toPay.InstallmentNumber}");
                var s = await http.GetFromJsonAsync<List<InstallmentViewModel>>($"api/loans/installments/{LoanId}");
                schedule = (s ?? new()).OrderBy(i => i.InstallmentNumber).ToList();
                toPay = null;
            }
            else
            {
                error = await r.Content.ReadAsStringAsync();
                if (string.IsNullOrWhiteSpace(error)) error = $"The server answered {(int)r.StatusCode}.";
            }
        }
        catch (Exception ex) { error = ex.Message; }
        finally { busy = false; }
    }
}

@page "/loans/view/{LoanId:int}"
@using SaccoManagementSystem.Models
@inject NavigationManager NavigationManager
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS

<PageTitle>@(loan?.LoanNumber ?? "Loan") · @Brand.Name</PageTitle>

<div class="ms-page">
    <button type="button" class="ms-back" @onclick="Back"><i class="bi bi-arrow-left"></i> Loans</button>

    @if (loading)
    {
        <div class="ms-skel" style="height:150px;border-radius:20px"></div>
        <div class="ms-grid stats ms-mt">@for (int i = 0; i < 4; i++) { <div class="ms-skel" style="height:110px"></div> }</div>
    }
    else if (loan == null)
    {
        <div class="ms-card"><EmptyState Icon="bi-cash-coin" Title="Loan not found" Text="@(string.IsNullOrEmpty(error) ? "It may have been removed." : error)">
            <div style="margin-top:14px"><button class="ms-btn" @onclick="Back">Back to loans</button></div></EmptyState></div>
    }
    else
    {
        <section class="ms-hero">
            <span class="ms-avatar xl"><i class="bi bi-cash-coin"></i></span>
            <div style="position:relative;z-index:1">
                <div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap"><h2>@loan.LoanNumber</h2><StatusPill Status="@loan.Status" /></div>
                <div class="meta">
                    <span><i class="bi bi-person"></i>@loan.MemberName</span>
                    <span><i class="bi bi-tag"></i>@loan.LoanType loan</span>
                    <span><i class="bi bi-calendar-event"></i>Applied @loan.ApplicationDate.ToString("d MMM yyyy")</span>
                </div>
            </div>
            <div class="ms-hero-actions">
                @if (loan.Status == "Pending")
                {
                    <button class="ms-btn primary" @onclick="() => Ask(Approve)"><i class="bi bi-check2"></i> Approve</button>
                    <button class="ms-btn" @onclick="() => Ask(Reject)"><i class="bi bi-x-lg"></i> Reject</button>
                }
                else if (loan.Status == "Approved")
                {
                    <button class="ms-btn primary" @onclick="() => Ask(Disburse)"><i class="bi bi-send"></i> Disburse</button>
                }
                @if (loan.Status is "Disbursed" or "Completed")
                {
                    <a class="ms-btn primary" href="loans/schedule/@loan.LoanId"><i class="bi bi-calendar3"></i> Repayment schedule</a>
                }
                <button class="ms-btn" @onclick="Print"><i class="bi bi-printer"></i> Print</button>
            </div>
        </section>

        <div class="ms-grid stats ms-mt">
            <StatCard Label="Principal" Icon="bi-cash-stack" Prefix="KES" Value="@loan.PrincipalAmount.ToString("N0")" Foot="@($"{loan.TermMonths} months @ {loan.InterestRate:0.##}%")" />
            <StatCard Label="Monthly instalment" Icon="bi-calendar-check" Tone="blue" Prefix="KES" Value="@(loan.MonthlyInstallment?.ToString("N0") ?? "—")" />
            <StatCard Label="Total payable" Icon="bi-receipt" Tone="gold" Prefix="KES" Value="@(loan.TotalPayable?.ToString("N0") ?? "—")" />
            <StatCard Label="Outstanding" Icon="bi-hourglass-split" Tone="red" Prefix="KES" Value="@(loan.OutstandingBalance?.ToString("N0") ?? "—")" />
        </div>

        <div class="ms-grid two ms-mt">
            <section class="ms-card">
                <div class="ms-card-head"><div><h3>Timeline</h3></div></div>
                <div class="ms-card-body ms-kv">
                    <div><small>Applied</small><b>@loan.ApplicationDate.ToString("d MMM yyyy")</b></div>
                    <div><small>Approved</small>@Date(loan.ApprovalDate)</div>
                    <div><small>Start date</small>@Date(loan.StartDate)</div>
                    <div><small>End date</small>@Date(loan.EndDate)</div>
                </div>
            </section>
            <section class="ms-card">
                <div class="ms-card-head"><div><h3>Guarantors</h3></div></div>
                <div class="ms-card-body">
                    @if (loan.Guarantor1Id == null && loan.Guarantor2Id == null)
                    {
                        <div class="ms-hint">No guarantors recorded.</div>
                    }
                    else
                    {
                        @if (loan.Guarantor1Id != null)
                        {
                            <a class="ms-picked" style="text-decoration:none;color:inherit;margin-bottom:8px" href="guarantors/view/@loan.Guarantor1Id"><Avatar Name="@loan.Guarantor1Name" Size="sm" /><div><b>@loan.Guarantor1Name</b><small>Primary guarantor</small></div><i class="bi bi-chevron-right"></i></a>
                        }
                        @if (loan.Guarantor2Id != null)
                        {
                            <a class="ms-picked" style="text-decoration:none;color:inherit" href="guarantors/view/@loan.Guarantor2Id"><Avatar Name="@loan.Guarantor2Name" Size="sm" /><div><b>@loan.Guarantor2Name</b><small>Secondary guarantor</small></div><i class="bi bi-chevron-right"></i></a>
                        }
                    }
                </div>
            </section>
            <section class="ms-card">
                <div class="ms-card-head"><div><h3>Borrower</h3></div></div>
                <div class="ms-card-body">
                    <a class="ms-picked" style="text-decoration:none;color:inherit" href="members/view/@loan.MemberId"><Avatar Name="@loan.MemberName" Size="sm" /><div><b>@loan.MemberName</b><small>@loan.MemberNo</small></div><i class="bi bi-chevron-right"></i></a>
                </div>
            </section>
            <section class="ms-card">
                <div class="ms-card-head"><div><h3>Remarks</h3></div></div>
                <div class="ms-card-body">@(string.IsNullOrWhiteSpace(loan.Remarks) ? "No remarks." : loan.Remarks)</div>
            </section>
        </div>
    }
</div>

<Modal Open="IsDecision" OnClose="Cancel" Title="@(action + " loan")" Subtitle="@Sub">
    <ChildContent>
        @if (action == Approve)
        {
            <div class="ms-grid-form">
                <Field Class="c6" Label="Interest rate (% p.a.)"><input class="ms-input" type="number" step="0.1" min="0" @bind="rate" /></Field>
                <Field Class="c6" Label="Repayment period (months)"><input class="ms-input" type="number" min="1" @bind="term" /></Field>
                <Field Class="c12" Label="Remarks (optional)"><textarea class="ms-input" @bind="remarks"></textarea></Field>
            </div>
        }
        else
        {
            <Field Label="Reason for rejection"><textarea class="ms-input" placeholder="Explain why this application is being declined" @bind="remarks"></textarea></Field>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="ms-btn" @onclick="Cancel">Cancel</button>
        <button type="button" class="ms-btn @(action == Approve ? "primary" : "danger") @(busy ? "busy" : "")" @onclick="Confirm">@if (busy) { <span class="ms-spin"></span> }@(action == Approve ? "Approve loan" : "Reject loan")</button>
    </Footer>
</Modal>

<ConfirmDialog Open="action == Disburse" Title="Disburse loan" ConfirmText="Disburse funds" Busy="busy" OnConfirm="Confirm" OnCancel="Cancel">
    <p style="margin:0 0 6px">Release <b>KES @loan?.PrincipalAmount.ToString("N0")</b> to <b>@loan?.MemberName</b>?</p>
    <p class="ms-hint" style="margin:0">The repayment schedule starts once the loan is disbursed.</p>
</ConfirmDialog>

@code {
    [Parameter] public int LoanId { get; set; }

    private const string Approve = "Approve", Reject = "Reject", Disburse = "Disburse";
    private LoanViewModel? loan;
    private bool loading = true, busy;
    private string error = "", action = "", remarks = "";
    private double rate = 10;
    private int term = 12;

    private bool IsDecision => action == Approve || action == Reject;
    private string Sub => loan == null ? "" : $"{loan.LoanNumber} · {loan.MemberName} · KES {loan.PrincipalAmount:N0}";

    protected override async Task OnParametersSetAsync() => await Load();

    private async Task Load()
    {
        loading = true; error = "";
        try
        {
            var http = HttpClientFactory.CreateClient("ApiClient");
            var r = await http.GetAsync($"api/loans/get/{LoanId}");
            if (r.IsSuccessStatusCode) loan = await r.Content.ReadFromJsonAsync<LoanViewModel>();
            else { loan = null; if (r.StatusCode != System.Net.HttpStatusCode.NotFound) error = $"The server answered {(int)r.StatusCode}."; }
        }
        catch (Exception ex) { loan = null; error = ex.Message; }
        finally { loading = false; }
    }

    private static RenderFragment Date(DateTime? d) => b =>
    {
        b.OpenElement(0, "b");
        if (d == null) { b.AddAttribute(1, "class", "empty"); b.AddContent(2, "—"); }
        else b.AddContent(3, d.Value.ToString("d MMM yyyy"));
        b.CloseElement();
    };

    private void Ask(string a)
    {
        action = a; remarks = "";
        if (loan != null) { rate = loan.InterestRate > 0 ? (double)loan.InterestRate : 10; term = loan.TermMonths > 0 ? loan.TermMonths : 12; }
    }

    private void Cancel() { action = ""; remarks = ""; }
    private void Back() => NavigationManager.NavigateTo("/loans");
    private async Task Print() => await JS.InvokeVoidAsync("print");

    private async Task Confirm()
    {
        if (loan == null) return;
        busy = true;
        var http = HttpClientFactory.CreateClient("ApiClient");
        try
        {
            HttpResponseMessage r;
            string done;
            switch (action)
            {
                case Approve:
                    r = await http.PutAsJsonAsync($"api/loans/approve/{loan.LoanId}", new { InterestRate = (decimal)rate, TermMonths = term, Remarks = remarks });
                    done = "Loan approved"; break;
                case Reject:
                    r = await http.PutAsJsonAsync($"api/loans/reject/{loan.LoanId}", remarks);
                    done = "Loan rejected"; break;
                default:
                    r = await http.PutAsync($"api/loans/disburse/{loan.LoanId}", null);
                    done = "Loan disbursed"; break;
            }
            if (r.IsSuccessStatusCode)
            {
                await JS.InvokeVoidAsync("ms.toast", "success", done, loan.LoanNumber);
                Cancel();
                await Load();
            }
            else await JS.InvokeVoidAsync("ms.toast", "error", $"Couldn't {action.ToLower()} loan", $"The server answered {(int)r.StatusCode}.");
        }
        catch (Exception ex) { await JS.InvokeVoidAsync("ms.toast", "error", $"Couldn't {action.ToLower()} loan", ex.Message); }
        finally { busy = false; }
    }
}

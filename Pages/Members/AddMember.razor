@page "/members/add-member"
@using SaccoManagementSystem.Models
@inject NavigationManager NavigationManager
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JSRuntime
@using SaccoManagementSystem.Security
@inject AuthenticationStateProvider AuthState
@inject SaccoManagementSystem.Services.ConfigStore Cfg
@inject SaccoManagementSystem.Services.MemberExtrasStore ExtrasStore

<PageTitle>Add member · @Brand.Name</PageTitle>

<div class="ms-page">
    <button type="button" class="ms-back" @onclick="Back"><i class="bi bi-arrow-left"></i> Members</button>
    <PageHeader Title="Add a member" Subtitle="Create a new member profile. You can edit it any time." />

    <MemberForm Model="newMember" Extras="extras" Busy="isSaving" ErrorMessage="@errorMessage" OnValidSubmit="HandleValidSubmit" OnCancel="Back" OnReset="ResetForm" />
</div>

@code {
    [CascadingParameter] public DrawerContext? Drawer { get; set; }
    private Task Leave(string url) { if (Drawer != null) return Drawer.Saved(); NavigationManager.NavigateTo(url); return Task.CompletedTask; }

    private MemberModel newMember = NewModel();
    private SaccoManagementSystem.Services.MemberExtras extras = new();
    private bool isSaving;
    private string errorMessage = string.Empty;

    private string Prefix => string.IsNullOrWhiteSpace(Cfg.Current.MemberNoPrefix) ? "TSC" : Cfg.Current.MemberNoPrefix.Trim();
    private static MemberModel NewModel() => new() { Status = "Active", JoinDate = DateTime.Today };

    protected override async Task OnInitializedAsync() => await GenerateMemberNumber();

    private async Task GenerateMemberNumber()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("ApiClient");
            var response = await client.GetAsync("api/members/get-last-member-number");

            if (response.IsSuccessStatusCode)
            {
                var lastNumber = (await response.Content.ReadAsStringAsync()).Trim('"', ' ');
                var digits = System.Text.RegularExpressions.Regex.Match(lastNumber, "([0-9]+)$").Groups[1].Value;
                var nextNumber = int.TryParse(digits, out var num) ? num + 1 : 1;
                newMember.MemberNo = $"{Prefix}{nextNumber:D4}";
            }
            else newMember.MemberNo = $"{Prefix}{DateTime.Now:yyMMddHHmm}";
        }
        catch
        {
            newMember.MemberNo = $"{Prefix}{DateTime.Now:yyMMddHHmm}";
        }
    }

    private async Task HandleValidSubmit()
    {
        isSaving = true;
        errorMessage = string.Empty;

        try
        {
            newMember.CreatedDate = DateTime.Now;
            newMember.CreatedBy = await CurrentUserId();
            extras.MemberNo = newMember.MemberNo;
            if (!string.IsNullOrEmpty(extras.Photo)) newMember.ProfileImageUrl = SaccoManagementSystem.Services.MemberExtrasStore.PhotoUrl(newMember.MemberNo);

            var client = HttpClientFactory.CreateClient("ApiClient");
            var response = await client.PostAsJsonAsync("api/members/add", newMember);

            if (response.IsSuccessStatusCode)
            {
                try { await ExtrasStore.SaveAsync(extras); } catch (Exception ex) { await JSRuntime.InvokeVoidAsync("ms.toast", "warning", "Member saved, extra details not saved", ex.Message); }
                await JSRuntime.InvokeVoidAsync("ms.toast", "success", "Member added", $"{newMember.FirstName} {newMember.LastName} is now a member.");
                await Leave("/members");
            }
            else
            {
                errorMessage = await response.Content.ReadAsStringAsync();
                if (string.IsNullOrWhiteSpace(errorMessage)) errorMessage = "The server couldn't save this member.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Something went wrong: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ResetForm()
    {
        newMember = NewModel();
        extras = new();
        errorMessage = string.Empty;
        _ = GenerateMemberNumber().ContinueWith(_ => InvokeAsync(StateHasChanged));
    }

    private Task Back() { if (Drawer != null) return Drawer.Close(); NavigationManager.NavigateTo("/members"); return Task.CompletedTask; }
    private async Task<int> CurrentUserId()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        return AuthService.UserId(state.User) ?? 1;
    }
}

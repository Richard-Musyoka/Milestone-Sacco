@page "/members"
@inject NavigationManager NavigationManager
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS

<PageTitle>Members · @Brand.Name</PageTitle>

<div class="ms-page">
    <PageHeader Title="Members" Subtitle="Everyone in your SACCO — search, filter and open a profile.">
        <a class="ms-btn primary" href="members/add-member"><i class="bi bi-person-plus"></i> Add member</a>
    </PageHeader>

    @if (!isLoading && !errorLoading)
    {
        <div class="ms-mini">
            <div><small>Total members</small><b>@members.Count.ToString("N0")</b></div>
            <div><small>Active</small><b>@Count("Active").ToString("N0")</b></div>
            <div><small>Pending</small><b>@Count("Pending").ToString("N0")</b></div>
            <div><small>Joined this month</small><b>@JoinedThisMonth.ToString("N0")</b></div>
        </div>
    }

    <div class="ms-card">
        <div class="ms-toolbar">
            <div class="ms-searchbox">
                <i class="bi bi-search"></i>
                <input class="ms-input" type="search" placeholder="Search name, email, phone or member no…" aria-label="Search members" @bind="searchTerm" @bind:event="oninput" @bind:after="ResetPage" />
            </div>
            <div class="ms-chips" role="group" aria-label="Filter by status">
                @foreach (var s in Statuses)
                {
                    <button type="button" class="ms-chip @(status == s ? "on" : "")" @onclick="() => SetStatus(s)">@s<em>@(s == "All" ? members.Count : Count(s))</em></button>
                }
            </div>
        </div>

        @if (isLoading)
        {
            <div class="ms-card-body">
                @for (int i = 0; i < 6; i++) { <div class="ms-skel" style="height:52px;margin-bottom:10px"></div> }
            </div>
        }
        else if (errorLoading)
        {
            <EmptyState Icon="bi-wifi-off" Title="Couldn't load members" Text="Check your connection and try again.">
                <div style="margin-top:14px"><button class="ms-btn" @onclick="LoadMembers"><i class="bi bi-arrow-clockwise"></i> Retry</button></div>
            </EmptyState>
        }
        else if (!Filtered.Any())
        {
            <EmptyState Icon="bi-people" Title="No members found" Text="Try a different search or filter, or add a new member.">
                <div style="margin-top:14px"><a class="ms-btn primary" href="members/add-member"><i class="bi bi-person-plus"></i> Add member</a></div>
            </EmptyState>
        }
        else
        {
            <div class="ms-table-wrap">
                <table class="ms-table">
                    <thead>
                        <tr>
                            <th class="ms-th-sort" @onclick='() => Sort("name")'>Member @SortIcon("name")</th>
                            <th class="ms-th-sort" @onclick='() => Sort("no")'>Member no @SortIcon("no")</th>
                            <th>Phone</th>
                            <th>Occupation</th>
                            <th class="ms-th-sort" @onclick='() => Sort("joined")'>Joined @SortIcon("joined")</th>
                            <th>Status</th>
                            <th class="r" style="width:150px"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in PageItems)
                        {
                            <tr class="clickable" @onclick="() => ViewMember(m.MemberId)">
                                <td>
                                    <div class="ms-cell-person">
                                        <Avatar Name="@m.FullName" ImageUrl="@m.ProfileImageUrl" Size="sm" />
                                        <div><b>@m.FullName</b><small>@m.Email</small></div>
                                    </div>
                                </td>
                                <td class="ms-num">@m.MemberNo</td>
                                <td class="ms-num">@m.PhoneNumber</td>
                                <td>@(string.IsNullOrWhiteSpace(m.Occupation) ? "—" : m.Occupation)</td>
                                <td class="ms-num">@(m.JoinDate?.ToString("d MMM yyyy") ?? "—")</td>
                                <td><StatusPill Status="@m.Status" /></td>
                                <td @onclick:stopPropagation="true">
                                    <div class="ms-row-actions">
                                        <button class="ms-ib" title="View" aria-label="View @m.FullName" @onclick="() => ViewMember(m.MemberId)"><i class="bi bi-eye"></i></button>
                                        <button class="ms-ib" title="Edit" aria-label="Edit @m.FullName" @onclick="() => EditMember(m.MemberId)"><i class="bi bi-pencil"></i></button>
                                        <button class="ms-ib danger" title="Delete" aria-label="Delete @m.FullName" @onclick="() => ConfirmDelete(m)"><i class="bi bi-trash3"></i></button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <Pager Total="Filtered.Count()" @bind-Page="page" @bind-PageSize="pageSize" />
        }
    </div>
</div>

<ConfirmDialog Open="showDeleteModal" Danger="true" Title="Delete member" ConfirmText="Delete member" Busy="deleting" OnConfirm="DeleteMember" OnCancel="CancelDelete">
    <p style="margin:0 0 6px">Delete <b>@memberToDelete?.FullName</b> (@memberToDelete?.MemberNo)?</p>
    <p class="ms-hint" style="margin:0">This can't be undone. Loans, shares or contributions linked to this member may block the deletion.</p>
</ConfirmDialog>

@code {
    private static readonly string[] Statuses = { "All", "Active", "Pending", "Inactive", "Suspended" };

    private List<Member> members = new();
    private string searchTerm = string.Empty;
    private string status = "All";
    private string sortKey = "name";
    private bool sortDesc;
    private int page = 1, pageSize = 10;
    private bool showDeleteModal, deleting;
    private Member? memberToDelete = null;
    private bool isLoading = true;
    private bool errorLoading = false;

    private int Count(string s) => members.Count(m => string.Equals(m.Status, s, StringComparison.OrdinalIgnoreCase));
    private int JoinedThisMonth => members.Count(m => (m.JoinDate ?? m.CreatedDate) is DateTime d && d.Year == DateTime.Today.Year && d.Month == DateTime.Today.Month);

    private IEnumerable<Member> Filtered
    {
        get
        {
            var q = members.Where(m => status == "All" || string.Equals(m.Status, status, StringComparison.OrdinalIgnoreCase));
            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                var t = searchTerm.Trim();
                q = q.Where(m => m.FullName.Contains(t, StringComparison.OrdinalIgnoreCase)
                              || (m.Email ?? "").Contains(t, StringComparison.OrdinalIgnoreCase)
                              || (m.PhoneNumber ?? "").Contains(t)
                              || (m.MemberNo ?? "").Contains(t, StringComparison.OrdinalIgnoreCase));
            }
            q = sortKey switch
            {
                "no" => sortDesc ? q.OrderByDescending(m => m.MemberNo) : q.OrderBy(m => m.MemberNo),
                "joined" => sortDesc ? q.OrderByDescending(m => m.JoinDate) : q.OrderBy(m => m.JoinDate),
                _ => sortDesc ? q.OrderByDescending(m => m.FullName) : q.OrderBy(m => m.FullName),
            };
            return q;
        }
    }

    private IEnumerable<Member> PageItems => Filtered.Skip((page - 1) * pageSize).Take(pageSize);

    protected override async Task OnInitializedAsync() => await LoadMembers();

    private void ResetPage() => page = 1;
    private void SetStatus(string s) { status = s; page = 1; }
    private void Sort(string key) { if (sortKey == key) sortDesc = !sortDesc; else { sortKey = key; sortDesc = false; } }
    private MarkupString SortIcon(string key) => sortKey != key ? new("") : new(sortDesc ? "<i class='bi bi-arrow-down-short'></i>" : "<i class='bi bi-arrow-up-short'></i>");

    private async Task LoadMembers()
    {
        try
        {
            isLoading = true;
            errorLoading = false;

            var client = HttpClientFactory.CreateClient("ApiClient");
            var response = await client.GetAsync("api/members/get-all");

            if (response.IsSuccessStatusCode)
                members = await response.Content.ReadFromJsonAsync<List<Member>>() ?? new List<Member>();
            else
                errorLoading = true;
        }
        catch
        {
            errorLoading = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ViewMember(int id) => NavigationManager.NavigateTo($"/members/view/{id}");
    private void EditMember(int id) => NavigationManager.NavigateTo($"/members/edit/{id}");

    private void ConfirmDelete(Member member) { memberToDelete = member; showDeleteModal = true; }
    private void CancelDelete() { showDeleteModal = false; memberToDelete = null; }

    private async Task DeleteMember()
    {
        if (memberToDelete == null) return;
        deleting = true;
        try
        {
            var client = HttpClientFactory.CreateClient("ApiClient");
            var response = await client.DeleteAsync($"api/members/delete/{memberToDelete.MemberId}");

            if (response.IsSuccessStatusCode)
            {
                await JS.InvokeVoidAsync("ms.toast", "success", "Member deleted", memberToDelete.FullName);
                await LoadMembers();
            }
            else
            {
                await JS.InvokeVoidAsync("ms.toast", "error", "Couldn't delete member", "They may have loans, shares or contributions on record.");
            }
        }
        catch
        {
            await JS.InvokeVoidAsync("ms.toast", "error", "Couldn't delete member", "Network problem — try again.");
        }
        finally
        {
            deleting = false;
            showDeleteModal = false;
            memberToDelete = null;
        }
    }

    public class Member
    {
        public int MemberId { get; set; }
        public string MemberNo { get; set; } = string.Empty;
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string PhoneNumber { get; set; } = string.Empty;
        public string NationalID { get; set; } = string.Empty;
        public DateTime? DateOfBirth { get; set; }
        public string Gender { get; set; } = string.Empty;
        public string MaritalStatus { get; set; } = string.Empty;
        public string Occupation { get; set; } = string.Empty;
        public string Employer { get; set; } = string.Empty;
        public string Address { get; set; } = string.Empty;
        public string ProfileImageUrl { get; set; } = string.Empty;
        public DateTime? JoinDate { get; set; }
        public string Status { get; set; } = "Active";
        public DateTime? CreatedDate { get; set; }
        public int? CreatedBy { get; set; }

        public string FullName => $"{FirstName} {LastName}";
    }
}

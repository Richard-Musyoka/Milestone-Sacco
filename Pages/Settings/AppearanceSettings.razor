@using System.Text.Json
@using SaccoManagementSystem.Services
@inject IJSRuntime JS

<fieldset class="cc-fs" disabled="@ReadOnly">
    <div class="cc-card">
        <h3><i class="bi bi-circle-half"></i> Default theme</h3>
        <p class="sub">What everyone sees until they pick their own.</p>
        <div class="cc-themes">
            @foreach (var t in Themes)
            {
                <button type="button" class="cc-theme @t.Key @(Cfg.DefaultTheme == t.Key ? "on" : "")" @onclick="() => Org(nameof(Cfg.DefaultTheme), t.Key)">
                    <div class="pv"><i></i><i></i></div>
                    <b>@t.Label @if (Cfg.DefaultTheme == t.Key) { <i class="bi bi-check-circle-fill"></i> }</b>
                    <small>@t.Hint</small>
                </button>
            }
        </div>
    </div>

    <div class="cc-card">
        <h3><i class="bi bi-layout-sidebar"></i> Layout</h3>
        <p class="sub">Spacing, shape and sidebar for the whole organisation.</p>
        <div class="cc-row">
            <div class="m"><b>Density</b><small>Compact fits more rows on screen.</small></div>
            <div class="e"><InputSelect Value="Cfg.Density" ValueChanged="@((string v) => Org(nameof(Cfg.Density), v))" ValueExpression="@(() => Cfg.Density)" class="ms-select"><option value="comfortable">Comfortable</option><option value="compact">Compact</option></InputSelect></div>
        </div>
        <div class="cc-row">
            <div class="m"><b>Corners</b><small>Sharp, rounded or soft.</small></div>
            <div class="e"><InputSelect Value="Cfg.Corners" ValueChanged="@((string v) => Org(nameof(Cfg.Corners), v))" ValueExpression="@(() => Cfg.Corners)" class="ms-select"><option value="sharp">Sharp</option><option value="rounded">Rounded</option><option value="soft">Soft</option></InputSelect></div>
        </div>
        <div class="cc-row">
            <div class="m"><b>Sidebar</b><small>Soft tint is the lightest and easiest on the eyes.</small></div>
            <div class="e"><InputSelect Value="Cfg.SidebarStyle" ValueChanged="@((string v) => Org(nameof(Cfg.SidebarStyle), v))" ValueExpression="@(() => Cfg.SidebarStyle)" class="ms-select"><option value="tint">Soft tint (light)</option><option value="light">White</option><option value="dark">Dark</option><option value="brand">Brand colour</option></InputSelect></div>
        </div>
        <div class="cc-row">
            <div class="m"><b>Page headers</b><small>Greeting and profile banners in light mode.</small></div>
            <div class="e"><InputSelect Value="Cfg.HeaderStyle" ValueChanged="@((string v) => Org(nameof(Cfg.HeaderStyle), v))" ValueExpression="@(() => Cfg.HeaderStyle)" class="ms-select"><option value="soft">Soft (light)</option><option value="dark">Dark navy</option></InputSelect></div>
        </div>
        <div class="cc-row">
            <div class="m"><b>Page descriptions</b><small>The short line under each page title.</small></div>
            <div class="e"><ToggleSwitch Value="Cfg.PageBanners" ValueChanged="SetBanners" AriaLabel="Page descriptions" /></div>
        </div>
    </div>
</fieldset>

<div class="cc-card">
    <h3><i class="bi bi-person-gear"></i> Just for me</h3>
    <p class="sub">Saved on this device only. Overrides the organisation default for you.</p>
    <div class="cc-themes">
        @foreach (var t in Themes)
        {
            <button type="button" class="cc-theme @t.Key @(myTheme == t.Key ? "on" : "")" @onclick="() => Mine(t.Key)">
                <div class="pv"><i></i><i></i></div>
                <b>@t.Label @if (myTheme == t.Key) { <i class="bi bi-check-circle-fill"></i> }</b>
                <small>@t.Hint</small>
            </button>
        }
    </div>
    <div class="cc-row" style="margin-top:8px">
        <div class="m"><b>Collapse the sidebar</b><small>Icons only. On phones the menu always slides in.</small></div>
        <div class="e"><ToggleSwitch Value="collapsed" ValueChanged="SetCollapsed" AriaLabel="Collapse the sidebar" /></div>
    </div>
    <div class="cc-row">
        <div class="m"><b>Use the organisation default</b><small>Forget my personal theme and density on this device.</small></div>
        <div class="e"><button type="button" class="ms-btn sm" @onclick="ResetMine" disabled="@(myTheme == "")"><i class="bi bi-arrow-counterclockwise"></i> Reset</button></div>
    </div>
</div>

@code {
    [Parameter] public OrgConfig Cfg { get; set; } = new();
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public Action? OnChanged { get; set; }

    private string myTheme = "";
    private bool collapsed;

    private sealed record Th(string Key, string Label, string Hint);
    private static readonly Th[] Themes =
    {
        new("light", "Light", "Bright and airy"), new("dark", "Dark", "Easy on the eyes"), new("system", "Match device", "Follows your OS"),
    };

    private void Org(string prop, string value)
    {
        switch (prop)
        {
            case nameof(Cfg.DefaultTheme): Cfg.DefaultTheme = value; break;
            case nameof(Cfg.Density): Cfg.Density = value; break;
            case nameof(Cfg.Corners): Cfg.Corners = value; break;
            case nameof(Cfg.SidebarStyle): Cfg.SidebarStyle = value; break;
            case nameof(Cfg.HeaderStyle): Cfg.HeaderStyle = value; break;
        }
        OnChanged?.Invoke();
    }
    private void SetBanners(bool v) { Cfg.PageBanners = v; OnChanged?.Invoke(); }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var p = await JS.InvokeAsync<JsonElement>("ms.getPrefs");
            if (p.ValueKind == JsonValueKind.Object)
            {
                if (p.TryGetProperty("theme", out var t) && t.ValueKind == JsonValueKind.String) myTheme = t.GetString() ?? "";
                if (p.TryGetProperty("collapsed", out var c)) collapsed = c.ValueKind == JsonValueKind.True;
            }
            StateHasChanged();
        }
        catch { }
    }

    private async Task Mine(string key) { myTheme = key; await JS.InvokeVoidAsync("ms.setPrefs", new { theme = key }); }
    private async Task SetCollapsed(bool v) { collapsed = v; await JS.InvokeVoidAsync("ms.setPrefs", new { collapsed = v }); }
    private async Task ResetMine()
    {
        myTheme = "";
        await JS.InvokeVoidAsync("ms.clearPref", "theme");
        await JS.InvokeVoidAsync("ms.clearPref", "density");
    }
}

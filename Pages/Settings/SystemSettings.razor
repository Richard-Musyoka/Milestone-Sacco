@page "/settings"
@using Sacco_Management_System.Models
@inject HttpClient Http
@inject IJSRuntime JsRuntime
@inject NavigationManager NavigationManager

<PageTitle>Settings · @Brand.Name</PageTitle>

<div class="ms-page">
    <PageHeader Title="Settings" Subtitle="Everything about how your SACCO runs — organised so you can find it." />

    <div class="ms-settings">
        <nav class="ms-card ms-set-nav" aria-label="Settings sections">
            <input class="ms-input ms-set-search" type="search" placeholder="Search settings…" aria-label="Search settings" @bind="filter" @bind:event="oninput" />
            @foreach (var group in Groups)
            {
                var items = Tabs.Where(t => t.Group == group && Matches(t)).ToList();
                if (items.Count == 0) continue;
                <div class="ms-set-group">@group</div>
                @foreach (var t in items)
                {
                    <button type="button" class="ms-set-item @(activeTab == t.Key ? "active" : "")" @onclick="() => SetActiveTab(t.Key)" aria-current="@(activeTab == t.Key ? "page" : null)">
                        <i class="bi @t.Icon"></i>
                        <span>@t.Title<small>@t.Hint</small></span>
                    </button>
                }
            }
        </nav>

        <div>
            <div class="ms-card">
                <div class="ms-set-panel-head">
                    <span class="ms-stat-ico"><i class="bi @Current.Icon"></i></span>
                    <div style="flex:1"><h2>@Current.Title</h2><p>@Current.Description</p></div>
                    @if (IsPolicyTab)
                    {
                        <span class="ms-pill @(isDirty ? "warn dot" : "ok dot")">@(isDirty ? "Unsaved changes" : "All changes saved")</span>
                    }
                </div>

                <div class="ms-set-panel-body">
                    @if (activeTab == "security-center")
                    {
                        <SecurityCenter />
                    }
                    else if (activeTab == "appearance")
                    {
                        <AppearanceSettings />
                    }
                    else if (isLoading)
                    {
                        <div style="padding-top:22px;display:flex;flex-direction:column;gap:14px">
                            <div class="ms-skel" style="height:44px;width:40%"></div><div class="ms-skel" style="height:90px"></div><div class="ms-skel" style="height:90px"></div>
                        </div>
                    }
                    else
                    {
                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="ms-alert bad" style="margin-top:22px"><i class="bi bi-exclamation-triangle-fill"></i><div>@errorMessage</div></div>
                        }
                        <EditForm Model="settings" OnValidSubmit="HandleValidSubmit" @ref="editForm">
                            <DataAnnotationsValidator />
                            <div class="ms-legacy-form">
                                <CascadingValue Value="editForm?.EditContext">
                                    @if (activeTab == "general")
                                    {
                                        <div class="ms-section" style="padding-top:22px"><GeneralSettingsTab Settings="@settings" OnSettingsChanged="@HandleSettingsChange" /></div>
                                    }
                                    else if (activeTab == "financial")
                                    {
                                        <div class="ms-section" style="padding-top:22px"><FinancialSettingsTab Settings="@settings" OnSettingsChanged="@HandleSettingsChange" /></div>
                                    }
                                    else if (activeTab == "loan")
                                    {
                                        <div class="ms-section" style="padding-top:22px"><LoanSettingsTab Settings="@settings" OnSettingsChanged="@HandleSettingsChange" /></div>
                                    }
                                    else if (activeTab == "notification")
                                    {
                                        <div class="ms-section" style="padding-top:22px"><NotificationSettingsTab Settings="@settings" OnSettingsChanged="@HandleSettingsChange" /></div>
                                    }
                                    else if (activeTab == "security")
                                    {
                                        <SecuritySettingsTab Settings="@settings" OnSettingsChanged="@HandleSettingsChange" />
                                    }
                                </CascadingValue>
                            </div>

                            @if (isDirty)
                            {
                                <div class="ms-savebar" role="status">
                                    <i class="bi bi-pencil-square"></i>
                                    <span>You have unsaved changes</span>
                                    <button type="button" class="ms-btn" @onclick="CancelChanges">Discard</button>
                                    <button type="submit" class="ms-btn primary @(isSaving ? "busy" : "")">@if (isSaving) { <span class="ms-spin"></span> } Save changes</button>
                                </div>
                            }
                            else
                            {
                                <div style="padding-top:18px;text-align:right">
                                    <button type="button" class="ms-btn sm ghost danger" @onclick="ResetToDefaults" disabled="@isSaving"><i class="bi bi-arrow-counterclockwise"></i> Reset this organisation to defaults</button>
                                </div>
                            }
                        </EditForm>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private sealed record Tab(string Key, string Group, string Title, string Hint, string Icon, string Description);

    private static readonly string[] Groups = { "Organisation", "Finance", "Communication", "Security & access", "Personal" };

    private static readonly Tab[] Tabs =
    {
        new("general", "Organisation", "General", "Name, contact, branding", "bi-building", "Your SACCO's identity and how it appears across the system."),
        new("financial", "Finance", "Financial", "Currency, shares, fees", "bi-cash-stack", "Currency, share pricing, contributions and financial year."),
        new("loan", "Finance", "Loans", "Limits, rates, terms", "bi-bank2", "Lending rules used when members apply for loans."),
        new("notification", "Communication", "Notifications", "Email & SMS", "bi-bell", "Choose how the SACCO talks to members and staff."),
        new("security", "Security & access", "Security policy", "Passwords, lockout, 2-step", "bi-shield-lock", "Organisation-wide sign-in rules for everyone."),
        new("security-center", "Security & access", "My security", "Authenticator, passkeys, devices", "bi-shield-check", "Manage how you sign in, your trusted devices and active sessions."),
        new("appearance", "Personal", "Appearance", "Theme, colour, density", "bi-palette", "Make the workspace look and feel the way you like."),
    };

    private string activeTab = "general";
    private string filter = "";
    private bool isDirty, isLoading = true, isSaving;
    private string errorMessage = string.Empty;
    private SaccoSettings settings = new();
    private SaccoSettings originalSettings = new();
    private EditForm? editForm;

    [SupplyParameterFromQuery(Name = "tab")] public string? TabParam { get; set; }

    private Tab Current => Tabs.First(t => t.Key == activeTab);
    private bool IsPolicyTab => activeTab is not ("security-center" or "appearance");
    private bool Matches(Tab t) => string.IsNullOrWhiteSpace(filter) ||
        t.Title.Contains(filter, StringComparison.OrdinalIgnoreCase) || t.Hint.Contains(filter, StringComparison.OrdinalIgnoreCase) || t.Description.Contains(filter, StringComparison.OrdinalIgnoreCase);

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(TabParam) && Tabs.Any(t => t.Key == TabParam)) activeTab = TabParam;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var response = await Http.GetAsync($"{NavigationManager.BaseUri}api/settings");
            if (response.IsSuccessStatusCode)
                settings = await response.Content.ReadFromJsonAsync<SaccoSettings>() ?? SaccoSettings.GetDefaultSettings();
            else
            {
                settings = SaccoSettings.GetDefaultSettings();
                errorMessage = "Couldn't load settings from the server — showing defaults.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Couldn't load settings: {ex.Message}";
            settings = SaccoSettings.GetDefaultSettings();
        }
        originalSettings = (SaccoSettings)settings.Clone();
        isLoading = false;
    }

    private void SetActiveTab(string tab)
    {
        activeTab = tab;
        NavigationManager.NavigateTo($"settings?tab={tab}", replace: true);
    }

    private void HandleSettingsChange()
    {
        isDirty = !settings.Equals(originalSettings);
        StateHasChanged();
    }

    private async Task HandleValidSubmit() => await SaveSettings();

    private void CancelChanges()
    {
        settings = (SaccoSettings)originalSettings.Clone();
        isDirty = false;
    }

    private async Task SaveSettings()
    {
        isSaving = true;
        errorMessage = string.Empty;
        try
        {
            var response = await Http.PutAsJsonAsync($"{NavigationManager.BaseUri}api/settings", settings);
            if (response.IsSuccessStatusCode)
            {
                originalSettings = (SaccoSettings)settings.Clone();
                isDirty = false;
                await JsRuntime.InvokeVoidAsync("ms.toast", "success", "Settings saved");
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                errorMessage = $"The server rejected the change ({(int)response.StatusCode}). {body}";
                await JsRuntime.InvokeVoidAsync("ms.toast", "error", "Couldn't save settings");
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Network error: {ex.Message}";
            await JsRuntime.InvokeVoidAsync("ms.toast", "error", "Couldn't save settings");
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ResetToDefaults()
    {
        if (!await JsRuntime.InvokeAsync<bool>("confirm", "Reset all organisation settings to their defaults? You can still discard before saving."))
            return;
        settings = SaccoSettings.GetDefaultSettings();
        isDirty = !settings.Equals(originalSettings);
    }
}

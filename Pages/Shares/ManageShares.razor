@page "/shares"
@using SaccoManagementSystem.Models
@using static Sacco_Management_System.Pages.Members.ListMember
@inject NavigationManager NavigationManager
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS

<PageTitle>Shares · @Brand.Name</PageTitle>

<div class="ms-page">
    <PageHeader Title="Shares" Subtitle="Share capital by member — buy, transfer and review holdings.">
        <a class="ms-btn primary" href="shares/purchase"><i class="bi bi-plus-lg"></i> Purchase shares</a>
    </PageHeader>

    @if (!loading && !failed)
    {
        <div class="ms-grid stats">
            <StatCard Label="Total shares" Icon="bi-pie-chart" Value="@summary.TotalShares.ToString("N0")" Foot="active units" />
            <StatCard Label="Share capital" Icon="bi-graph-up-arrow" Tone="blue" Prefix="KES" Value="@Money(summary.TotalValue)" />
            <StatCard Label="Shareholders" Icon="bi-people" Tone="gold" Value="@summary.ShareholdersCount.ToString("N0")" />
            <StatCard Label="Current price" Icon="bi-tag" Tone="red" Prefix="KES" Value="@summary.CurrentSharePrice.ToString("N2")" Foot="per unit" />
        </div>
    }

    <div class="ms-card ms-mt">
        <div class="ms-toolbar">
            <div class="ms-searchbox">
                <i class="bi bi-search"></i>
                <input class="ms-input" type="search" placeholder="Search shareholder or member no…" aria-label="Search shareholders" @bind="search" @bind:event="oninput" @bind:after="ResetPage" />
            </div>
        </div>

        @if (loading)
        {
            <div class="ms-card-body">@for (int i = 0; i < 6; i++) { <div class="ms-skel" style="height:52px;margin-bottom:10px"></div> }</div>
        }
        else if (failed)
        {
            <EmptyState Icon="bi-wifi-off" Title="Couldn't load shares" Text="@error">
                <div style="margin-top:14px"><button class="ms-btn" @onclick="Load"><i class="bi bi-arrow-clockwise"></i> Retry</button></div>
            </EmptyState>
        }
        else if (!Filtered.Any())
        {
            <EmptyState Icon="bi-pie-chart" Title="No shareholders found" Text="Try a different search, or record a share purchase.">
                <div style="margin-top:14px"><a class="ms-btn primary" href="shares/purchase">Purchase shares</a></div>
            </EmptyState>
        }
        else
        {
            <div class="ms-table-wrap">
                <table class="ms-table">
                    <thead><tr><th>Shareholder</th><th>Member no</th><th class="r">Units</th><th style="width:220px">Ownership</th><th class="r">Value</th><th>Last purchase</th><th class="r" style="width:150px"></th></tr></thead>
                    <tbody>
                        @foreach (var h in PageItems)
                        {
                            var pct = summary.TotalShares > 0 ? h.Units * 100.0 / summary.TotalShares : 0;
                            <tr class="clickable" @onclick="() => View(h.MemberId)">
                                <td><div class="ms-cell-person"><Avatar Name="@h.MemberName" Size="sm" /><div><b>@h.MemberName</b></div></div></td>
                                <td class="ms-num">@h.MemberNumber</td>
                                <td class="r ms-num"><b>@h.Units.ToString("N0")</b></td>
                                <td><div style="display:flex;align-items:center;gap:10px"><div class="ms-bar" style="flex:1"><i style="width:@(Math.Min(100, pct).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></i></div><span class="ms-num" style="font-size:12px;width:44px;text-align:right">@pct.ToString("0.#")%</span></div></td>
                                <td class="r ms-num">KES @h.TotalValue.ToString("N0")</td>
                                <td class="ms-num">@h.PurchaseDate.ToString("d MMM yyyy")</td>
                                <td @onclick:stopPropagation="true">
                                    <div class="ms-row-actions">
                                        <button class="ms-ib" title="Buy more" aria-label="Buy more shares for @h.MemberName" @onclick="() => Buy(h.MemberId)"><i class="bi bi-plus-circle"></i></button>
                                        <button class="ms-ib" title="Transfer" aria-label="Transfer shares from @h.MemberName" @onclick="() => OpenTransfer(h)"><i class="bi bi-arrow-left-right"></i></button>
                                        <button class="ms-ib" title="View" aria-label="View @h.MemberName" @onclick="() => View(h.MemberId)"><i class="bi bi-eye"></i></button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <Pager Total="Filtered.Count()" @bind-Page="page" @bind-PageSize="pageSize" />
        }
    </div>
</div>

<Modal Open="from != null" OnClose="CloseTransfer" Title="Transfer shares" Subtitle="@(from == null ? "" : $"From {from.MemberName} · {from.Units:N0} units available")">
    <ChildContent>
        @if (!string.IsNullOrEmpty(tError)) { <div class="ms-alert bad"><i class="bi bi-exclamation-circle-fill"></i><div>@tError</div></div> }
        <div class="ms-grid-form">
            <Field Class="c12" Label="Transfer to" Required="true">
                <SearchPicker TItem="Member" Items="Recipients" Title="@(m => m.FullName)" Sub="@(m => m.MemberNo)"
                              Match="@((m, q) => m.FullName.Contains(q, StringComparison.OrdinalIgnoreCase) || (m.MemberNo ?? "").Contains(q, StringComparison.OrdinalIgnoreCase))"
                              Placeholder="Search recipient…" @bind-Selected="to" />
            </Field>
            <Field Class="c6" Label="Units" Required="true"><input class="ms-input" type="number" min="1" max="@(from?.Units ?? 1)" @bind="units" /></Field>
            <Field Class="c6" Label="Share type">
                <select class="ms-select" @bind="shareType">@foreach (var t in ShareTypes.All) { <option value="@t">@t</option> }</select>
            </Field>
            <Field Class="c12" Label="Remarks"><textarea class="ms-input" @bind="remarks"></textarea></Field>
        </div>
    </ChildContent>
    <Footer>
        <button type="button" class="ms-btn" @onclick="CloseTransfer">Cancel</button>
        <button type="button" class="ms-btn primary @(busy ? "busy" : "")" @onclick="Transfer">@if (busy) { <span class="ms-spin"></span> }Transfer shares</button>
    </Footer>
</Modal>

@code {
    private List<ShareViewModel> holders = new();
    private List<Member> members = new();
    private ShareSummaryDto summary = new();
    private string search = "", error = "", tError = "", remarks = "", shareType = "Ordinary";
    private bool loading = true, failed, busy;
    private int page = 1, pageSize = 10, units = 1;

    private ShareViewModel? from;
    private Member? to;

    private IEnumerable<Member> Recipients => members.Where(m => m.MemberId != from?.MemberId);

    private IEnumerable<ShareViewModel> Filtered => holders
        .Where(s => string.IsNullOrWhiteSpace(search)
            || (s.MemberName ?? "").Contains(search.Trim(), StringComparison.OrdinalIgnoreCase)
            || (s.MemberNumber ?? "").Contains(search.Trim(), StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(s => s.Units);

    private IEnumerable<ShareViewModel> PageItems => Filtered.Skip((page - 1) * pageSize).Take(pageSize);

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        loading = true; failed = false; error = "";
        try
        {
            var http = HttpClientFactory.CreateClient("ApiClient");
            var s = http.GetFromJsonAsync<ShareSummaryDto>("api/shares/summary");
            var m = http.GetFromJsonAsync<List<Member>>("api/members");
            var a = http.GetFromJsonAsync<List<ShareViewModel>>("api/shares/get-all");
            await Task.WhenAll(s, m, a);
            summary = s.Result ?? new();
            members = m.Result ?? new();
            holders = (a.Result ?? new())
                .Where(x => x.Status == "Active")
                .GroupBy(x => x.MemberId)
                .Select(g => new ShareViewModel
                {
                    MemberId = g.Key,
                    MemberName = g.First().MemberName,
                    MemberNumber = g.First().MemberNumber,
                    Units = g.Sum(x => x.Units),
                    TotalValue = g.Sum(x => x.TotalValue),
                    PurchaseDate = g.Max(x => x.PurchaseDate),
                    Status = "Active"
                }).ToList();
        }
        catch (Exception ex) { failed = true; error = ex.Message; }
        finally { loading = false; }
    }

    private static string Money(decimal v)
    {
        var a = Math.Abs(v);
        if (a >= 1_000_000m) return (v / 1_000_000m).ToString("0.##") + "M";
        if (a >= 10_000m) return (v / 1_000m).ToString("0.#") + "K";
        return v.ToString("N0");
    }

    private void ResetPage() => page = 1;
    private void View(int id) => NavigationManager.NavigateTo($"/shares/member/{id}");
    private void Buy(int id) => NavigationManager.NavigateTo($"/shares/purchase/{id}");

    private void OpenTransfer(ShareViewModel h) { from = h; to = null; units = 1; remarks = ""; tError = ""; shareType = "Ordinary"; }
    private void CloseTransfer() { from = null; to = null; tError = ""; }

    private async Task Transfer()
    {
        tError = "";
        if (from == null) return;
        if (to == null) { tError = "Please choose who receives the shares."; return; }
        if (units < 1 || units > from.Units) { tError = $"Units must be between 1 and {from.Units:N0}."; return; }

        busy = true;
        try
        {
            var http = HttpClientFactory.CreateClient("ApiClient");
            var dto = new ShareTransferDto { FromMemberId = from.MemberId, ToMemberId = to.MemberId, Units = units, ShareType = shareType, Remarks = remarks };
            var r = await http.PostAsJsonAsync("api/shares/transfer", dto);
            if (r.IsSuccessStatusCode)
            {
                await JS.InvokeVoidAsync("ms.toast", "success", "Shares transferred", $"{units:N0} units to {to.FullName}");
                CloseTransfer();
                await Load();
            }
            else
            {
                tError = await r.Content.ReadAsStringAsync();
                if (string.IsNullOrWhiteSpace(tError)) tError = $"The server answered {(int)r.StatusCode}.";
            }
        }
        catch (Exception ex) { tError = ex.Message; }
        finally { busy = false; }
    }
}

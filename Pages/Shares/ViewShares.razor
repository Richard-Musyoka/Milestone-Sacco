@page "/shares/member/{MemberId:int}"
@using SaccoManagementSystem.Models
@using static Sacco_Management_System.Pages.Members.ListMember
@inject NavigationManager NavigationManager
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS

<PageTitle>@(member?.FullName ?? "Shares") · @Brand.Name</PageTitle>

<div class="ms-page">
    <button type="button" class="ms-back" @onclick="Back"><i class="bi bi-arrow-left"></i> Shares</button>

    @if (loading)
    {
        <div class="ms-skel" style="height:150px;border-radius:20px"></div>
        <div class="ms-grid stats ms-mt">@for (int i = 0; i < 4; i++) { <div class="ms-skel" style="height:110px"></div> }</div>
    }
    else if (member == null)
    {
        <div class="ms-card"><EmptyState Icon="bi-person-x" Title="Member not found" Text="@(string.IsNullOrEmpty(error) ? "We couldn't load this member's shares." : error)">
            <div style="margin-top:14px"><button class="ms-btn" @onclick="Back">Back to shares</button></div></EmptyState></div>
    }
    else
    {
        <section class="ms-hero">
            <Avatar Name="@member.FullName" ImageUrl="@member.ProfileImageUrl" Size="xl" />
            <div style="position:relative;z-index:1">
                <h2>@member.FullName</h2>
                <div class="meta"><span><i class="bi bi-person-vcard"></i>@member.MemberNo</span><span><i class="bi bi-pie-chart"></i>@Active.Sum(s => s.Units).ToString("N0") active units</span></div>
            </div>
            <div class="ms-hero-actions">
                <a class="ms-btn primary" href="shares/purchase/@member.MemberId"><i class="bi bi-plus-lg"></i> Buy shares</a>
                <a class="ms-btn" href="members/view/@member.MemberId"><i class="bi bi-person"></i> Member profile</a>
            </div>
        </section>

        <div class="ms-grid stats ms-mt">
            <StatCard Label="Active units" Icon="bi-pie-chart" Value="@Active.Sum(s => s.Units).ToString("N0")" />
            <StatCard Label="Current value" Icon="bi-graph-up-arrow" Tone="blue" Prefix="KES" Value="@Active.Sum(s => s.TotalValue).ToString("N0")" />
            <StatCard Label="Average price" Icon="bi-tag" Tone="gold" Prefix="KES" Value="@AvgPrice.ToString("N2")" />
            <StatCard Label="Holdings" Icon="bi-collection" Tone="red" Value="@shares.Count.ToString()" Foot="@($"{shares.Count(s => s.Status != "Active")} inactive")" />
        </div>

        <div class="ms-card ms-mt">
            <div class="ms-card-head"><div><h3>Purchase history</h3></div></div>
            @if (shares.Count == 0)
            {
                <EmptyState Icon="bi-pie-chart" Title="No shares yet" Text="This member hasn't bought any shares.">
                    <div style="margin-top:14px"><a class="ms-btn primary" href="shares/purchase/@member.MemberId">Buy shares</a></div>
                </EmptyState>
            }
            else
            {
                <div class="ms-table-wrap">
                    <table class="ms-table">
                        <thead><tr><th>Purchased</th><th>Type</th><th class="r">Units</th><th class="r">Unit price</th><th class="r">Value</th><th>Status</th><th>Remarks</th><th class="r" style="width:110px"></th></tr></thead>
                        <tbody>
                            @foreach (var s in shares.OrderByDescending(x => x.PurchaseDate))
                            {
                                <tr>
                                    <td class="ms-num">@s.PurchaseDate.ToString("d MMM yyyy")</td>
                                    <td>@s.ShareType</td>
                                    <td class="r ms-num">@s.Units.ToString("N0")</td>
                                    <td class="r ms-num">KES @s.UnitPrice.ToString("N2")</td>
                                    <td class="r ms-num"><b>KES @s.TotalValue.ToString("N0")</b></td>
                                    <td><StatusPill Status="@s.Status" /></td>
                                    <td style="max-width:240px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="@s.Remarks">@(string.IsNullOrWhiteSpace(s.Remarks) ? "—" : s.Remarks)</td>
                                    <td class="r">@if (s.Status == "Active") { <button class="ms-btn sm" @onclick="() => AskCancel(s)">Cancel</button> }</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
</div>

<Modal Open="toCancel != null" OnClose="CloseCancel" Title="Cancel this holding?" Subtitle="@(toCancel == null ? "" : $"{toCancel.Units:N0} units · KES {toCancel.TotalValue:N0}")">
    <ChildContent>
        <Field Label="Reason" Hint="Kept on the record for audit."><textarea class="ms-input" @bind="reason"></textarea></Field>
    </ChildContent>
    <Footer>
        <button type="button" class="ms-btn" @onclick="CloseCancel">Keep it</button>
        <button type="button" class="ms-btn danger @(busy ? "busy" : "")" @onclick="DoCancel">@if (busy) { <span class="ms-spin"></span> }Cancel holding</button>
    </Footer>
</Modal>

@code {
    [Parameter] public int MemberId { get; set; }

    private Member? member;
    private List<ShareViewModel> shares = new();
    private bool loading = true, busy;
    private string error = "", reason = "";
    private ShareViewModel? toCancel;

    private IEnumerable<ShareViewModel> Active => shares.Where(s => s.Status == "Active");
    private decimal AvgPrice => Active.Sum(s => s.Units) == 0 ? 0 : Active.Sum(s => s.TotalValue) / Active.Sum(s => s.Units);

    protected override async Task OnParametersSetAsync() => await Load();

    private async Task Load()
    {
        loading = true; error = "";
        try
        {
            var http = HttpClientFactory.CreateClient("ApiClient");
            var m = http.GetAsync($"api/members/get/{MemberId}");
            var s = http.GetAsync($"api/shares/member/{MemberId}");
            await Task.WhenAll(m, s);
            member = m.Result.IsSuccessStatusCode ? await m.Result.Content.ReadFromJsonAsync<Member>() : null;
            shares = s.Result.IsSuccessStatusCode ? await s.Result.Content.ReadFromJsonAsync<List<ShareViewModel>>() ?? new() : new();
            if (member == null && shares.Count > 0)
            {
                var parts = (shares[0].MemberName ?? "").Split(' ', 2, StringSplitOptions.RemoveEmptyEntries);
                member = new Member { MemberId = MemberId, MemberNo = shares[0].MemberNumber, FirstName = parts.Length > 0 ? parts[0] : "", LastName = parts.Length > 1 ? parts[1] : "" };
            }
        }
        catch (Exception ex) { error = ex.Message; }
        finally { loading = false; }
    }

    private void AskCancel(ShareViewModel s) { toCancel = s; reason = ""; }
    private void CloseCancel() { toCancel = null; }
    private void Back() => NavigationManager.NavigateTo("/shares");

    private async Task DoCancel()
    {
        if (toCancel == null) return;
        busy = true;
        try
        {
            var http = HttpClientFactory.CreateClient("ApiClient");
            // The API expects the reason as a JSON string in the body of a DELETE.
            var req = new HttpRequestMessage(HttpMethod.Delete, $"api/shares/cancel/{toCancel.ShareId}") { Content = JsonContent.Create(reason ?? "") };
            var r = await http.SendAsync(req);
            if (r.IsSuccessStatusCode)
            {
                await JS.InvokeVoidAsync("ms.toast", "success", "Holding cancelled");
                toCancel = null;
                await Load();
            }
            else await JS.InvokeVoidAsync("ms.toast", "error", "Couldn't cancel holding", $"The server answered {(int)r.StatusCode}.");
        }
        catch (Exception ex) { await JS.InvokeVoidAsync("ms.toast", "error", "Couldn't cancel holding", ex.Message); }
        finally { busy = false; }
    }
}

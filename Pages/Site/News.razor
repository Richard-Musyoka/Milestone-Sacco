@page "/news"
@page "/news/{Id}"
@inject SiteStore Site

@if (Item != null)
{
    <PageTitle>@Item.Title · @Brand.Name</PageTitle>
    <section class="ws-sec">
        <div class="ws-wrap ws-article ws-reveal">
            <div class="ws-crumb"><a href="">Home</a> / <a href="news">News</a></div>
            <h1>@Item.Title</h1>
            <p style="color:var(--ms-accent);font-weight:800;text-transform:uppercase;letter-spacing:.08em;font-size:13px">@Item.Date.ToString("dddd, d MMMM yyyy")</p>
            @if (!string.IsNullOrWhiteSpace(Item.Summary)) { <p style="font-size:19px;font-weight:600;line-height:1.6">@Item.Summary</p> }
            <div class="body">@Item.Body</div>
            <a class="ws-btn" style="margin-top:28px" href="news"><i class="bi bi-arrow-left"></i> All news</a>
        </div>
    </section>
}
else
{
    <PageTitle>News · @Brand.Name</PageTitle>
    <SitePageHead Title="News and notices" Text="AGM notices, dividend announcements and updates for members." Image="@Site.Photo("news.head")" Alt="Members at a meeting" />
    <section class="ws-sec">
        <div class="ws-wrap">
            @if (!string.IsNullOrEmpty(Id)) { <div class="ws-msg bad" style="margin-bottom:18px"><i class="bi bi-exclamation-circle-fill"></i><div>That story isn't available any more.</div></div> }
            @if (All.Count == 0)
            {
                <div class="ws-card" style="text-align:center;padding:48px"><div class="ic" style="margin:0 auto 14px"><i class="bi bi-newspaper"></i></div><h3>No news yet</h3><p>Check back soon for updates.</p></div>
            }
            else
            {
                <div class="ws-news">
                    @foreach (var n in All)
                    {
                        <a class="ws-card" href="@("news/" + n.Id)"><time>@n.Date.ToString("d MMM yyyy")</time><h3>@n.Title</h3><p>@n.Summary</p><span class="more">Read more <i class="bi bi-arrow-right"></i></span></a>
                    }
                </div>
            }
        </div>
    </section>
}

@code {
    [Parameter] public string? Id { get; set; }
    private List<SiteContent.NewsItem> All => Site.Current.News.Where(n => n.Published).OrderByDescending(n => n.Date).ToList();
    private SiteContent.NewsItem? Item => string.IsNullOrEmpty(Id) ? null : All.FirstOrDefault(n => n.Id == Id);
}

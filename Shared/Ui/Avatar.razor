<span class="ms-avatar @Size">
    @if (!string.IsNullOrWhiteSpace(ImageUrl)) { <img src="@ImageUrl" alt="@Name" loading="lazy" @onerror="() => _broken = true" style="@(_broken ? "display:none" : null)" /> }
    @if (string.IsNullOrWhiteSpace(ImageUrl) || _broken) { @Initials }
</span>

@code {
    private bool _broken;
    [Parameter] public string? Name { get; set; }
    [Parameter] public string? ImageUrl { get; set; }
    /// <summary>"", "sm" or "xl"</summary>
    [Parameter] public string Size { get; set; } = "";

    private string Initials
    {
        get
        {
            var p = (Name ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
            if (p.Length == 0) return "?";
            return p.Length == 1 ? p[0][..1].ToUpperInvariant() : $"{p[0][0]}{p[^1][0]}".ToUpperInvariant();
        }
    }
}

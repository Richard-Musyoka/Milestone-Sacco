<Modal Open="Open" OnClose="OnCancel" Title="@Title">
    <ChildContent>
        <div class="ms-confirm-ico" style="@(Danger ? null : "background:var(--ms-accent-soft);color:var(--ms-accent)")"><i class="bi @(Danger ? "bi-trash3" : "bi-question-circle")"></i></div>
        @ChildContent
    </ChildContent>
    <Footer>
        <button type="button" class="ms-btn" @onclick="OnCancel">Cancel</button>
        <button type="button" class="ms-btn @(Danger ? "danger" : "primary") @(Busy ? "busy" : "")" @onclick="OnConfirm">@if (Busy) { <span class="ms-spin"></span> }@ConfirmText</button>
    </Footer>
</Modal>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public string Title { get; set; } = "Are you sure?";
    [Parameter] public string ConfirmText { get; set; } = "Confirm";
    [Parameter] public bool Danger { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}

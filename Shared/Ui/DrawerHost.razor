@using System.Security.Claims
@using SaccoManagementSystem.Security
@implements IDisposable
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthState
@using Microsoft.AspNetCore.Components.Routing

@if (open)
{
    <div class="ms-drawer-bg @(closing ? "out" : "")" @onclick="Close"></div>
    <aside class="ms-drawer @def!.Size @(closing ? "out" : "")" role="dialog" aria-modal="true" aria-label="@def.Title" @key="openId">
        <header class="ms-drawer-head">
            <span class="ms-hub-ico" style="@def.Style"><i class="bi @def.Icon"></i></span>
            <div class="ms-drawer-title"><h3>@def.Title</h3><p>@def.Subtitle</p></div>
            <button type="button" class="ms-icon-btn" @onclick="Close" aria-label="Close"><i class="bi bi-x-lg"></i></button>
        </header>
        <div class="ms-drawer-body ms-body">
            <CascadingValue Value="ctx" IsFixed="true">
                <DynamicComponent Type="def.Type" Parameters="parms" />
            </CascadingValue>
        </div>
    </aside>
}

@code {
    [Parameter] public EventCallback OnSaved { get; set; }

    /// <summary>Route is a pattern: "{id}" matches digits and is passed to the page as <c>Param</c> (int), "{*}" matches one segment (string).</summary>
    private sealed record Def(string Route, Type Type, string Title, string Subtitle, string Icon, string Size, string C1, string C2, string? Param = null)
    {
        public string Style => "--c1:" + C1 + ";--c2:" + C2;
        public System.Text.RegularExpressions.Regex Rx { get; } = new("^" + System.Text.RegularExpressions.Regex.Escape(Route).Replace("\\{id}", "(?<v>[0-9]+)").Replace("\\{\\*}", "(?<v>[^/]+)") + "$", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
    }

    private static readonly Def[] Defs =
    {
        new("members/add-member", typeof(global::Sacco_Management_System.Pages.Members.AddMember), "Add a member", "Create a new member profile. You can edit it any time.", "bi-person-plus-fill", "mid", "#14a173", "#0B7A52"),
        new("members/edit/{id}", typeof(global::Sacco_Management_System.Pages.Members.EditMember), "Edit member", "Update details, photo, KRA PIN and next of kin.", "bi-person-gear", "mid", "#14a173", "#0B7A52", "MemberId"),
        new("contributions/add", typeof(global::Sacco_Management_System.Pages.Contributions.AddContribution), "Record a contribution", "Log a payment made by a member.", "bi-piggy-bank-fill", "", "#2559C7", "#1b3f94"),
        new("contributions/edit/{id}", typeof(global::Sacco_Management_System.Pages.Contributions.EditContribution), "Edit contribution", "Correct the amount, method or status.", "bi-piggy-bank", "", "#2559C7", "#1b3f94", "ContributionId"),
        new("loans/apply", typeof(global::Sacco_Management_System.Pages.Loans.ApplyLoan), "New loan application", "Member, terms and guarantors. Approval happens afterwards.", "bi-cash-coin", "wide", "#D4A62A", "#a67c12"),
        new("shares/purchase", typeof(global::Sacco_Management_System.Pages.Shares.PurchaseShares), "Purchase shares", "Record a share purchase for a member.", "bi-graph-up-arrow", "", "#0ea5b7", "#0b7285"),
        new("shares/purchase/{*}", typeof(global::Sacco_Management_System.Pages.Shares.PurchaseShares), "Purchase shares", "Record a share purchase for a member.", "bi-graph-up-arrow", "", "#0ea5b7", "#0b7285", "MemberId:s"),
        new("guarantors/add", typeof(global::Sacco_Management_System.Pages.Guarantors.AddGuarantor), "Add a guarantor", "Someone who can stand behind a member's loan.", "bi-shield-plus", "", "#8b5cf6", "#5b34c9"),
        new("guarantors/edit/{id}", typeof(global::Sacco_Management_System.Pages.Guarantors.EditGuarantor), "Edit guarantor", "Update the guarantor's details.", "bi-shield-check", "", "#8b5cf6", "#5b34c9", "GuarantorId"),
        new("dividends/declare", typeof(global::Sacco_Management_System.Pages.Dividends.DividendsDeclaration), "Declare a dividend", "Set the rate and dates, review the impact, then confirm.", "bi-percent", "mid", "#ec4899", "#b8236b"),
        new("payments/record", typeof(global::Sacco_Management_System.Pages.Payments.RecordPayment), "Receive a payment", "M-Pesa, bank, cash or check-off. We'll post it where it belongs.", "bi-wallet2", "mid", "#16a34a", "#0f7a37"),
        new("chamas/add", typeof(global::Sacco_Management_System.Pages.Chamas.ChamaEditor), "Start a chama", "A group that saves together, runs a merry-go-round or does table banking.", "bi-people-fill", "mid", "#f97316", "#c2410c"),
        new("chamas/{id}/edit", typeof(global::Sacco_Management_System.Pages.Chamas.ChamaEditor), "Edit chama", "Name, type, contribution amount and meeting schedule.", "bi-people", "mid", "#f97316", "#c2410c", "ChamaId"),
    };

    private (Def Def, Dictionary<string, object?>? Parms)? Match(string path)
    {
        var p = (path ?? "").Split('?', '#')[0].Trim('/');
        foreach (var d in Defs)
        {
            var m = d.Rx.Match(p);
            if (!m.Success) continue;
            if (d.Param == null) return (d, null);
            var v = m.Groups["v"].Value;
            if (d.Param.EndsWith(":s")) return (d, new Dictionary<string, object?> { [d.Param[..^2]] = v });
            return (d, new Dictionary<string, object?> { [d.Param] = int.Parse(v) });
        }
        return null;
    }

    private bool open, closing;
    private int openId;
    private Def? def;
    private Dictionary<string, object?>? parms;
    private DrawerContext ctx = default!;
    private DotNetObjectReference<DrawerHost>? self;

    protected override void OnInitialized()
    {
        ctx = new DrawerContext { Close = () => Close(), Saved = () => SavedAsync() };
        Nav.LocationChanged += OnLocation;
        changing = Nav.RegisterLocationChangingHandler(OnChanging);
    }

    private IDisposable? changing;
    private bool bypass;

    // Buttons that call NavigationManager.NavigateTo("members/edit/5") land here too: open the drawer instead of leaving the page.
    private async ValueTask OnChanging(LocationChangingContext c)
    {
        if (bypass) { bypass = false; return; }
        try
        {
            // TargetLocation can be relative ("/members/view/4", "chamas/1") - normalise before comparing.
            var abs = Nav.ToAbsoluteUri(c.TargetLocation).ToString();
            if (!abs.StartsWith(Nav.BaseUri, StringComparison.OrdinalIgnoreCase)) return;
            var rel = Nav.ToBaseRelativePath(abs);
            if (Match(rel) == null) return;
            var here = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Trim('/');
            if (string.Equals(here, rel.Split('?', '#')[0].Trim('/'), StringComparison.OrdinalIgnoreCase)) return;
            c.PreventNavigation();
            if (!await TryOpen(rel)) { bypass = true; Nav.NavigateTo(abs); }
        }
        catch (Exception) { /* never let the drawer interceptor kill the circuit - let navigation proceed */ }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        self = DotNetObjectReference.Create(this);
        try { await JS.InvokeVoidAsync("ms.drawer.init", self); } catch { /* prerender / disconnected */ }
    }

    /// <summary>Called from JS when a link to an "add" page is clicked. Returns false when the link should navigate normally.</summary>
    [JSInvokable]
    public async Task<bool> TryOpen(string path)
    {
        var found = Match(path);
        if (found == null) return false;
        var hit = found.Value.Def;
        var state = await AuthState.GetAuthenticationStateAsync();
        var role = state.User.FindFirstValue(ClaimTypes.Role) ?? "";
        if (!Access.CanViewPage(role, hit.Route))
        {
            await JS.InvokeVoidAsync("ms.toast", "warning", "Not available for your role", "Ask an administrator if you need this.");
            return true;
        }

        def = hit;
        parms = found.Value.Parms;
        closing = false; open = true; openId++;
        await InvokeAsync(StateHasChanged);
        await JS.InvokeVoidAsync("ms.drawer.opened", true);
        return true;
    }

    [JSInvokable] public Task CloseFromJs() => Close();

    private async Task Close()
    {
        if (!open || closing) return;
        closing = true;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(280);
        open = false; closing = false;
        try { await JS.InvokeVoidAsync("ms.drawer.opened", false); } catch { }
        await InvokeAsync(StateHasChanged);
    }

    private async Task SavedAsync()
    {
        await Close();
        await OnSaved.InvokeAsync();
    }

    private void OnLocation(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (open) { open = false; closing = false; _ = InvokeAsync(StateHasChanged); }
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocation;
        changing?.Dispose();
        self?.Dispose();
    }
}

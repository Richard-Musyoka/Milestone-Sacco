@page "/loans/apply"
@using System.ComponentModel.DataAnnotations
@inject NavigationManager NavigationManager
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS

<PageTitle>New loan application · @Brand.Name</PageTitle>

<div class="ms-page">
    <button type="button" class="ms-back" @onclick="Cancel"><i class="bi bi-arrow-left"></i> Loans</button>
    <PageHeader Title="New loan application" Subtitle="Capture the member, loan terms and guarantors. Approval happens afterwards." />

    <EditForm Model="app" OnValidSubmit="Submit">
        <DataAnnotationsValidator />

        @if (!string.IsNullOrEmpty(error))
        {
            <div class="ms-alert bad" role="alert"><i class="bi bi-exclamation-circle-fill"></i><div>@error</div></div>
        }

        <div class="ms-split">
            <div class="ms-form" style="max-width:none">
                <section class="ms-fs">
                    <div class="ms-fs-head"><i class="bi bi-person"></i><div><h3>Applicant</h3><small>Who is borrowing</small></div></div>
                    <div class="ms-fs-body">
                        <Field Label="Member" Required="true" Hint="Search by name, member number or phone">
                            <SearchPicker TItem="MemberDto" Id="memberSearch" Items="members" Title="@(m => $"{m.FirstName} {m.LastName}")" Sub="@(m => m.MemberNo)"
                                          Match="@((m, q) => $"{m.FirstName} {m.LastName}".Contains(q, StringComparison.OrdinalIgnoreCase) || (m.MemberNo ?? "").Contains(q, StringComparison.OrdinalIgnoreCase) || (m.PhoneNumber ?? "").Contains(q))"
                                          Placeholder="Start typing to find a member…" @bind-Selected="member" />
                        </Field>
                    </div>
                </section>

                <section class="ms-fs">
                    <div class="ms-fs-head"><i class="bi bi-cash-coin"></i><div><h3>Loan terms</h3><small>Amount, rate and repayment period</small></div></div>
                    <div class="ms-fs-body">
                        <div class="ms-grid-form">
                            <Field Class="c6" Label="Loan type" Required="true" For="@(() => app.LoanType)">
                                <InputSelect id="loanType" class="ms-select" @bind-Value="app.LoanType">
                                    <option value="">Select loan type</option>
                                    <option value="Emergency">Emergency loan</option>
                                    <option value="Education">Education loan</option>
                                    <option value="Business">Business loan</option>
                                    <option value="Personal">Personal loan</option>
                                </InputSelect>
                            </Field>
                            <Field Class="c6" Label="Loan amount (KES)" Required="true" For="@(() => app.PrincipalAmount)">
                                <div class="ms-input-icon"><span>KES</span><InputNumber id="amount" class="ms-input" @bind-Value="app.PrincipalAmount" /></div>
                            </Field>
                            <Field Class="c6" Label="Interest rate (% per year)" Required="true" For="@(() => app.InterestRate)"><InputNumber id="rate" class="ms-input" @bind-Value="app.InterestRate" /></Field>
                            <Field Class="c6" Label="Repayment term (months)" Required="true" For="@(() => app.TermMonths)"><InputNumber id="term" class="ms-input" @bind-Value="app.TermMonths" /></Field>
                            <Field Class="c12" Label="Purpose of loan" Required="true" For="@(() => app.Purpose)"><InputTextArea id="purpose" class="ms-input" placeholder="What will the money be used for?" @bind-Value="app.Purpose" /></Field>
                        </div>
                    </div>
                </section>

                <section class="ms-fs">
                    <div class="ms-fs-head"><i class="bi bi-person-check"></i><div><h3>Guarantors</h3><small>Who stands behind this loan</small></div></div>
                    <div class="ms-fs-body">
                        <div class="ms-seg" role="group" aria-label="Guarantor type" style="margin-bottom:16px">
                            <button type="button" class="@(!external ? "on" : "")" @onclick="() => external = false">Existing guarantors</button>
                            <button type="button" class="@(external ? "on" : "")" @onclick="() => external = true">New external guarantor</button>
                        </div>

                        @if (!external)
                        {
                            <div class="ms-grid-form">
                                <Field Class="c6" Label="Primary guarantor" Required="true">
                                    <SearchPicker TItem="GuarantorDto" Items="guarantors" Title="@(g => $"{g.FirstName} {g.LastName}")" Sub="@(g => g.PhoneNumber)"
                                                  Match="@((g, q) => $"{g.FirstName} {g.LastName}".Contains(q, StringComparison.OrdinalIgnoreCase) || (g.IDNumber ?? "").Contains(q) || (g.PhoneNumber ?? "").Contains(q))"
                                                  Placeholder="Search guarantors…" @bind-Selected="g1" />
                                </Field>
                                <Field Class="c6" Label="Secondary guarantor" Hint="Optional">
                                    <SearchPicker TItem="GuarantorDto" Items="guarantors" Title="@(g => $"{g.FirstName} {g.LastName}")" Sub="@(g => g.PhoneNumber)"
                                                  Match="@((g, q) => $"{g.FirstName} {g.LastName}".Contains(q, StringComparison.OrdinalIgnoreCase) || (g.IDNumber ?? "").Contains(q) || (g.PhoneNumber ?? "").Contains(q))"
                                                  Placeholder="Search guarantors…" @bind-Selected="g2" />
                                </Field>
                            </div>
                        }
                        else
                        {
                            <div class="ms-grid-form">
                                <Field Class="c6" Label="First name" Required="true" For="@(() => ext.FirstName)"><InputText class="ms-input" @bind-Value="ext.FirstName" /></Field>
                                <Field Class="c6" Label="Last name" Required="true" For="@(() => ext.LastName)"><InputText class="ms-input" @bind-Value="ext.LastName" /></Field>
                                <Field Class="c6" Label="ID number" Required="true" For="@(() => ext.IDNumber)"><InputText class="ms-input" @bind-Value="ext.IDNumber" /></Field>
                                <Field Class="c6" Label="Phone number" Required="true" For="@(() => ext.PhoneNumber)"><InputText class="ms-input" type="tel" @bind-Value="ext.PhoneNumber" /></Field>
                                <Field Class="c6" Label="Email" For="@(() => ext.Email)"><InputText class="ms-input" type="email" @bind-Value="ext.Email" /></Field>
                                <Field Class="c6" Label="Physical address" For="@(() => ext.PhysicalAddress)"><InputText class="ms-input" @bind-Value="ext.PhysicalAddress" /></Field>
                                <Field Class="c12" Label="Remarks" For="@(() => ext.Remarks)"><InputTextArea class="ms-input" @bind-Value="ext.Remarks" /></Field>
                            </div>
                        }
                    </div>
                </section>

                <section class="ms-fs">
                    <div class="ms-fs-head"><i class="bi bi-chat-left-text"></i><div><h3>Notes</h3><small>Anything the approver should know</small></div></div>
                    <div class="ms-fs-body"><Field Label="Remarks"><InputTextArea id="remarks" class="ms-input" @bind-Value="app.Remarks" /></Field></div>
                </section>

                <div class="ms-formbar">
                    <span class="sp">Fields marked * are required</span>
                    <button type="button" class="ms-btn" @onclick="Cancel" disabled="@busy">Cancel</button>
                    <button type="submit" class="ms-btn primary @(busy ? "busy" : "")">@if (busy) { <span class="ms-spin"></span> } else { <i class="bi bi-send"></i> } Submit application</button>
                </div>
            </div>

            <aside class="ms-card ms-calc" aria-live="polite">
                <div><small style="color:var(--ms-text-3);font-weight:700;text-transform:uppercase;letter-spacing:.06em;font-size:11px">Estimated monthly repayment</small></div>
                <div class="big">@(Monthly > 0 ? "KES " + Monthly.ToString("N0") : "—")</div>
                <div class="row"><span>Principal</span><b>KES @app.PrincipalAmount.ToString("N0")</b></div>
                <div class="row"><span>Total interest</span><b>@(Monthly > 0 ? "KES " + (Total - app.PrincipalAmount).ToString("N0") : "—")</b></div>
                <div class="row"><span>Total payable</span><b>@(Monthly > 0 ? "KES " + Total.ToString("N0") : "—")</b></div>
                <div class="row"><span>Term</span><b>@app.TermMonths months @@ @app.InterestRate.ToString("0.##")%</b></div>
                @if (member != null)
                {
                    <div class="row"><span>Applicant</span><b>@member.FirstName @member.LastName</b></div>
                }
                <small class="ms-hint">Reducing-balance estimate. The approver can adjust rate and term.</small>
            </aside>
        </div>
    </EditForm>
</div>

<Modal Open="done" OnClose="Finish" Title="Application submitted" Subtitle="It now waits for approval.">
    <ChildContent>
        <div style="text-align:center;padding:8px 0">
            <div class="ms-confirm-ico" style="margin:0 auto 12px;background:var(--ms-accent-soft);color:var(--ms-accent)"><i class="bi bi-check2-circle"></i></div>
            <div class="ms-hint">Loan number</div>
            <div style="font-size:24px;font-weight:800;letter-spacing:-.01em">@app.LoanNumber</div>
        </div>
    </ChildContent>
    <Footer>
        <button type="button" class="ms-btn" @onclick="Print"><i class="bi bi-printer"></i> Print</button>
        <button type="button" class="ms-btn primary" @onclick="Finish">Back to loans</button>
    </Footer>
</Modal>

@code {
    private LoanApplicationDto app = new();
    private ExternalGuarantorDto ext = new();
    private List<MemberDto> members = new();
    private List<GuarantorDto> guarantors = new();
    private MemberDto? member;
    private GuarantorDto? g1, g2;
    private bool external, busy, done;
    private string error = "";

    private decimal Monthly => Calc(app.PrincipalAmount, app.InterestRate, app.TermMonths);
    private decimal Total => Monthly * Math.Max(app.TermMonths, 0);

    private static decimal Calc(decimal p, decimal annualRate, int n)
    {
        if (p <= 0 || n <= 0) return 0;
        var r = annualRate / 100m / 12m;
        if (r <= 0) return p / n;
        var f = (decimal)Math.Pow((double)(1 + r), n);
        return p * r * f / (f - 1);
    }

    protected override async Task OnInitializedAsync()
    {
        var http = HttpClientFactory.CreateClient("ApiClient");
        try { members = await http.GetFromJsonAsync<List<MemberDto>>("api/members") ?? new(); }
        catch (Exception ex) { error = $"Couldn't load members: {ex.Message}"; }
        try { guarantors = await http.GetFromJsonAsync<List<GuarantorDto>>("api/guarantors") ?? new(); }
        catch (Exception ex) { error += $" Couldn't load guarantors: {ex.Message}"; }
    }

    private async Task Submit()
    {
        error = "";
        if (member == null) { error = "Please select the member applying for the loan."; return; }
        if (!external)
        {
            if (g1 == null) { error = "Please select at least one guarantor, or add an external guarantor."; return; }
            if (g2 != null && g1.GuarantorId == g2.GuarantorId) { error = "The two guarantors must be different people."; return; }
            if (g1.MemberId == member.MemberId || g2?.MemberId == member.MemberId) { error = "A member can't guarantee their own loan."; return; }
        }
        else
        {
            if (string.IsNullOrWhiteSpace(ext.FirstName) || string.IsNullOrWhiteSpace(ext.LastName) || string.IsNullOrWhiteSpace(ext.IDNumber) || string.IsNullOrWhiteSpace(ext.PhoneNumber))
            { error = "Please complete the external guarantor's name, ID number and phone."; return; }
        }

        busy = true;
        try
        {
            var http = HttpClientFactory.CreateClient("ApiClient");
            app.MemberId = member.MemberId;
            app.LoanNumber = $"LN-{DateTime.Now:yyyyMMdd}-{Random.Shared.Next(1000, 9999)}";
            app.ApplicationDate = DateTime.Now;
            app.CreatedDate = DateTime.Now;
            app.Status = "Pending";

            if (external)
            {
                var gr = await http.PostAsJsonAsync("api/guarantors", new
                {
                    ext.FirstName, ext.LastName, ext.IDNumber, ext.PhoneNumber, ext.Email, ext.PhysicalAddress,
                    IsExternal = true, ext.Remarks,
                    CreatedBy = 1 // TODO Phase 2b: signed-in user id
                });
                if (!gr.IsSuccessStatusCode) { error = "Couldn't create the guarantor: " + await gr.Content.ReadAsStringAsync(); return; }
                app.Guarantor1Id = (await gr.Content.ReadFromJsonAsync<GuarantorResult>())?.GuarantorId;
                app.Guarantor2Id = null;
            }
            else
            {
                app.Guarantor1Id = g1!.GuarantorId;
                app.Guarantor2Id = g2?.GuarantorId;
            }

            var r = await http.PostAsJsonAsync("api/loans/add", app);
            if (r.IsSuccessStatusCode)
            {
                var res = await r.Content.ReadFromJsonAsync<LoanApplicationResult>();
                if (res != null && !string.IsNullOrEmpty(res.LoanNumber)) app.LoanNumber = res.LoanNumber;
                await JS.InvokeVoidAsync("ms.toast", "success", "Application submitted", app.LoanNumber);
                done = true;
            }
            else
            {
                var body = await r.Content.ReadAsStringAsync();
                error = string.IsNullOrWhiteSpace(body) ? "The server couldn't save this application." : body;
            }
        }
        catch (Exception ex) { error = $"Something went wrong: {ex.Message}"; }
        finally { busy = false; }
    }

    private void Cancel() => NavigationManager.NavigateTo("/loans");
    private void Finish() { done = false; NavigationManager.NavigateTo("/loans"); }
    private async Task Print() => await JS.InvokeVoidAsync("print");

    // Model classes (kept public: other pages may reference them)
    public class LoanApplicationDto
    {
        [Required(ErrorMessage = "Member is required")]
        public int MemberId { get; set; }

        [Required(ErrorMessage = "Loan type is required")]
        public string LoanType { get; set; } = string.Empty;

        [Required(ErrorMessage = "Principal amount is required")]
        [Range(1000, 1000000, ErrorMessage = "Amount must be between 1,000 and 1,000,000")]
        public decimal PrincipalAmount { get; set; }

        [Required(ErrorMessage = "Interest rate is required")]
        [Range(1, 30, ErrorMessage = "Interest rate must be between 1% and 30%")]
        public decimal InterestRate { get; set; } = 12;

        [Required(ErrorMessage = "Term is required")]
        [Range(1, 60, ErrorMessage = "Term must be between 1 and 60 months")]
        public int TermMonths { get; set; } = 12;

        [Required(ErrorMessage = "Purpose is required")]
        [StringLength(500, ErrorMessage = "Purpose cannot exceed 500 characters")]
        public string Purpose { get; set; } = string.Empty;

        public int? Guarantor1Id { get; set; }
        public int? Guarantor2Id { get; set; }
        public string? Remarks { get; set; }

        public string LoanNumber { get; set; } = string.Empty;
        public DateTime ApplicationDate { get; set; }
        public DateTime CreatedDate { get; set; }
        public string Status { get; set; } = string.Empty;
    }

    public class MemberDto
    {
        public int MemberId { get; set; }
        public string MemberNo { get; set; } = string.Empty;
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string PhoneNumber { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public decimal SavingsBalance { get; set; }
    }

    public class GuarantorDto
    {
        public int GuarantorId { get; set; }
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string IDNumber { get; set; } = string.Empty;
        public string PhoneNumber { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string PhysicalAddress { get; set; } = string.Empty;
        public bool IsExternal { get; set; }
        public int? MemberId { get; set; }
    }

    public class ExternalGuarantorDto
    {
        [Required(ErrorMessage = "First name is required")]
        [StringLength(100, ErrorMessage = "First name cannot exceed 100 characters")]
        public string FirstName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Last name is required")]
        [StringLength(100, ErrorMessage = "Last name cannot exceed 100 characters")]
        public string LastName { get; set; } = string.Empty;

        [Required(ErrorMessage = "ID number is required")]
        [StringLength(50, ErrorMessage = "ID number cannot exceed 50 characters")]
        public string IDNumber { get; set; } = string.Empty;

        [Required(ErrorMessage = "Phone number is required")]
        [StringLength(20, ErrorMessage = "Phone number cannot exceed 20 characters")]
        public string PhoneNumber { get; set; } = string.Empty;

        [EmailAddress(ErrorMessage = "Invalid email address")]
        public string Email { get; set; } = string.Empty;

        [StringLength(200, ErrorMessage = "Address cannot exceed 200 characters")]
        public string PhysicalAddress { get; set; } = string.Empty;

        [StringLength(500, ErrorMessage = "Remarks cannot exceed 500 characters")]
        public string Remarks { get; set; } = string.Empty;
    }

    public class GuarantorResult { public int GuarantorId { get; set; } }

    public class LoanApplicationResult
    {
        public string LoanNumber { get; set; } = string.Empty;
        public int LoanId { get; set; }
    }
}

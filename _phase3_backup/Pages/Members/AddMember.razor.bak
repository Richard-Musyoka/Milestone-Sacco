@page "/members/add-member"
@using SaccoManagementSystem.Models
@inject NavigationManager NavigationManager
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JSRuntime

<PageTitle>Add member · @Brand.Name</PageTitle>

<div class="ms-page">
    <button type="button" class="ms-back" @onclick="Back"><i class="bi bi-arrow-left"></i> Members</button>
    <PageHeader Title="Add a member" Subtitle="Create a new member profile. You can edit it any time." />

    <MemberForm Model="newMember" Busy="isSaving" ErrorMessage="@errorMessage" OnValidSubmit="HandleValidSubmit" OnCancel="Back" OnReset="ResetForm" />
</div>

@code {
    private MemberModel newMember = NewModel();
    private bool isSaving;
    private string errorMessage = string.Empty;

    private static MemberModel NewModel() => new() { Status = "Active", JoinDate = DateTime.Today };

    protected override async Task OnInitializedAsync() => await GenerateMemberNumber();

    private async Task GenerateMemberNumber()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("ApiClient");
            var response = await client.GetAsync("api/members/get-last-member-number");

            if (response.IsSuccessStatusCode)
            {
                var lastNumber = await response.Content.ReadAsStringAsync();
                int nextNumber = 1;

                if (!string.IsNullOrEmpty(lastNumber) && lastNumber.StartsWith("TSC"))
                {
                    if (int.TryParse(lastNumber.Substring(3), out int num)) nextNumber = num + 1;
                }

                newMember.MemberNo = $"TSC{nextNumber:D4}";
            }
            else newMember.MemberNo = $"TSC{DateTime.Now:yyyyMMddHHmmss}";
        }
        catch
        {
            newMember.MemberNo = $"TSC{DateTime.Now:yyyyMMddHHmmss}";
        }
    }

    private async Task HandleValidSubmit()
    {
        isSaving = true;
        errorMessage = string.Empty;

        try
        {
            newMember.CreatedDate = DateTime.Now;
            newMember.CreatedBy = 1; // TODO Phase 2b: use the signed-in user's id

            var client = HttpClientFactory.CreateClient("ApiClient");
            var response = await client.PostAsJsonAsync("api/members/add", newMember);

            if (response.IsSuccessStatusCode)
            {
                await JSRuntime.InvokeVoidAsync("ms.toast", "success", "Member added", $"{newMember.FirstName} {newMember.LastName} is now a member.");
                NavigationManager.NavigateTo("/members");
            }
            else
            {
                errorMessage = await response.Content.ReadAsStringAsync();
                if (string.IsNullOrWhiteSpace(errorMessage)) errorMessage = "The server couldn't save this member.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Something went wrong: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ResetForm()
    {
        newMember = NewModel();
        errorMessage = string.Empty;
        _ = GenerateMemberNumber().ContinueWith(_ => InvokeAsync(StateHasChanged));
    }

    private void Back() => NavigationManager.NavigateTo("/members");
}

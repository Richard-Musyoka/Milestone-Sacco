@page "/contributions/add"
@using SaccoManagementSystem.Models
@inject NavigationManager NavigationManager
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS

<PageTitle>Record contribution · @Brand.Name</PageTitle>

<div class="ms-page">
    <button type="button" class="ms-back" @onclick="Back"><i class="bi bi-arrow-left"></i> Contributions</button>
    <PageHeader Title="Record a contribution" Subtitle="Log a payment made by a member." />
    <ContributionForm Model="contribution" Members="members" LoadingMembers="loadingMembers" Busy="saving" ErrorMessage="@error" OnValidSubmit="Save" OnCancel="Back" />
</div>

@code {
    private Contribution contribution = new() { Status = "Paid", DateContributed = DateTime.Today };
    private List<ContributionForm.MemberOption> members = new();
    private bool loadingMembers = true, saving;
    private string error = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var http = HttpClientFactory.CreateClient("ApiClient");
            var r = await http.GetAsync("api/members/get-dropdown");
            if (r.IsSuccessStatusCode) members = await r.Content.ReadFromJsonAsync<List<ContributionForm.MemberOption>>() ?? new();
            else error = "Couldn't load the member list.";
        }
        catch (Exception ex) { error = $"Couldn't load the member list: {ex.Message}"; }
        finally { loadingMembers = false; }
    }

    private async Task Save()
    {
        error = string.Empty;
        if (contribution.MemberId <= 0) { error = "Please select a member."; return; }
        saving = true;
        try
        {
            contribution.CreatedDate = DateTime.Now;
            if (contribution.Status == "Paid") contribution.Status = "Confirmed";
            var http = HttpClientFactory.CreateClient("ApiClient");
            var r = await http.PostAsJsonAsync("api/contributions/add", contribution);
            if (r.IsSuccessStatusCode)
            {
                await JS.InvokeVoidAsync("ms.toast", "success", "Contribution recorded", $"KES {contribution.Amount:N0}");
                NavigationManager.NavigateTo("/contributions");
                return;
            }
            var body = await r.Content.ReadAsStringAsync();
            error = string.IsNullOrWhiteSpace(body) ? "The server couldn't save this contribution." : body;
        }
        catch (Exception ex) { error = $"Something went wrong: {ex.Message}"; }
        finally
        {
            saving = false;
            if (contribution.Status == "Confirmed") contribution.Status = "Paid"; // keep the form consistent if we stay on the page
        }
    }

    private void Back() => NavigationManager.NavigateTo("/contributions");
}

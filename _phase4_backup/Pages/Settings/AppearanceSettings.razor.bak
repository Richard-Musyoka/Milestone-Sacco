@using System.Text.Json
@inject IJSRuntime JS

<div class="ms-section" style="padding-top:22px">
    <h4>Theme</h4>
    <p class="sub">Saved on this device. Pages that haven't been redesigned yet show on a light sheet in dark mode.</p>
    <div class="ms-choice-grid">
        @foreach (var t in Themes)
        {
            <button type="button" class="ms-choice @(theme == t.Key ? "sel" : "")" @onclick="() => Set(nameof(theme), t.Key)">
                <span class="sw" style="background:@t.Bg"><i style="background:@t.Panel;margin:6px 4px 6px 6px;border-radius:6px"></i><i style="background:@t.Panel2;margin:6px 6px 6px 0;border-radius:6px;flex:2"></i></span>
                <b>@t.Label</b>
            </button>
        }
    </div>
</div>

<div class="ms-section">
    <h4>Accent colour</h4>
    <p class="sub">Buttons, highlights and charts.</p>
    <div class="ms-choice-grid">
        @foreach (var a in Accents)
        {
            <button type="button" class="ms-choice @(accent == a.Key ? "sel" : "")" @onclick="() => Set(nameof(accent), a.Key)">
                <span class="sw"><i style="background:@a.Color"></i><i style="background:@a.Soft"></i></span>
                <b>@a.Label</b>
            </button>
        }
    </div>
</div>

<div class="ms-section">
    <h4>Layout</h4>
    <div class="ms-row">
        <div class="ms-row-main"><b>Compact spacing</b><small>Tighter padding so more fits on screen.</small></div>
        <div class="ms-row-end"><ToggleSwitch Value='@(density == "compact")' ValueChanged='@((bool v) => Set(nameof(density), v ? "compact" : "comfortable"))' AriaLabel="Compact spacing" /></div>
    </div>
    <div class="ms-row">
        <div class="ms-row-main"><b>Collapse the sidebar</b><small>Icons only. On phones the menu always slides in.</small></div>
        <div class="ms-row-end"><ToggleSwitch Value="collapsed" ValueChanged='@((bool v) => Set(nameof(collapsed), v ? "1" : "0"))' AriaLabel="Collapse the sidebar" /></div>
    </div>
</div>

@code {
    private string theme = "light", accent = "emerald", density = "comfortable";
    private bool collapsed;

    private record ThemeOpt(string Key, string Label, string Bg, string Panel, string Panel2);
    private record AccentOpt(string Key, string Label, string Color, string Soft);

    private static readonly ThemeOpt[] Themes =
    {
        new("light", "Light", "#F4F6F9", "#0B1F3A", "#ffffff"),
        new("dark", "Dark", "#0A1424", "#070f1d", "#101d33"),
        new("system", "Match my device", "linear-gradient(90deg,#F4F6F9 50%,#0A1424 50%)", "#0B1F3A", "#101d33"),
    };

    private static readonly AccentOpt[] Accents =
    {
        new("emerald", "Emerald", "#0B7A52", "#E3F4EC"),
        new("blue", "Blue", "#2559C7", "#E6EDFB"),
        new("navy", "Navy", "#12305a", "#E4EAF3"),
        new("gold", "Gold", "#B7861A", "#FBF3DC"),
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var p = await JS.InvokeAsync<JsonElement>("ms.getPrefs");
            if (p.ValueKind == JsonValueKind.Object)
            {
                if (p.TryGetProperty("theme", out var t) && t.ValueKind == JsonValueKind.String) theme = t.GetString()!;
                if (p.TryGetProperty("accent", out var a) && a.ValueKind == JsonValueKind.String) accent = a.GetString()!;
                if (p.TryGetProperty("density", out var d) && d.ValueKind == JsonValueKind.String) density = d.GetString()!;
                if (p.TryGetProperty("collapsed", out var c)) collapsed = c.ValueKind == JsonValueKind.True;
            }
            StateHasChanged();
        }
        catch { }
    }

    private async Task Set(string what, string value)
    {
        switch (what)
        {
            case nameof(theme): theme = value; break;
            case nameof(accent): accent = value; break;
            case nameof(density): density = value; break;
            case nameof(collapsed): collapsed = value == "1"; break;
        }
        await JS.InvokeVoidAsync("ms.setPrefs", new { theme, accent, density, collapsed });
    }
}

@using System.ComponentModel.DataAnnotations
@using Sacco_Management_System.Models

<div class="ms-section" style="padding-top:22px">
    <h4>Sign-in requirements</h4>
    <p class="sub">Applies to everyone who signs in. Each person sets up their own methods in the Security Center.</p>

    <div class="ms-row">
        <div class="ms-row-main">
            <b>Require two-step verification</b>
            <small>Everyone must use an authenticator app or passkey. Anyone without one is asked to set it up right after signing in.</small>
        </div>
        <div class="ms-row-end">
            <ToggleSwitch Value="Settings.TwoFactorAuthenticationRequired" ValueChanged="SetTwoFactor" AriaLabel="Require two-step verification" />
        </div>
    </div>
</div>

<div class="ms-section">
    <h4>Passwords</h4>
    <p class="sub">Existing passwords are checked at the next change.</p>

    <div class="ms-row">
        <div class="ms-row-main"><b>Complexity</b><small>@ComplexityHelp</small></div>
        <div class="ms-row-end" style="min-width:230px">
            <InputSelect Value="Settings.PasswordComplexity" ValueChanged="@((string v) => Update(() => Settings.PasswordComplexity = v))" ValueExpression="@(() => Settings.PasswordComplexity)" class="ms-select">
                <option value="Low">Low</option>
                <option value="Medium">Medium</option>
                <option value="High">High</option>
            </InputSelect>
        </div>
    </div>
    <div class="ms-row">
        <div class="ms-row-main"><b>Password expires after</b><small>Days before people must choose a new password (30–365).</small></div>
        <div class="ms-row-end"><InputNumber Value="Settings.PasswordExpiryDays" ValueChanged="@((int v) => Update(() => Settings.PasswordExpiryDays = v))" ValueExpression="@(() => Settings.PasswordExpiryDays)" class="ms-input" style="width:110px" /><span class="ms-muted">days</span></div>
    </div>
    <div class="ms-row">
        <div class="ms-row-main"><b>Remember previous passwords</b><small>Blocks reuse of the last few (0–24).</small></div>
        <div class="ms-row-end"><InputNumber Value="Settings.PasswordHistoryCount" ValueChanged="@((int v) => Update(() => Settings.PasswordHistoryCount = v))" ValueExpression="@(() => Settings.PasswordHistoryCount)" class="ms-input" style="width:110px" /></div>
    </div>
    <ValidationMessage For="@(() => Settings.PasswordExpiryDays)" />
    <ValidationMessage For="@(() => Settings.PasswordHistoryCount)" />
</div>

<div class="ms-section">
    <h4>Protection</h4>
    <div class="ms-row">
        <div class="ms-row-main"><b>Lock the account after</b><small>Failed password attempts before a 15-minute lockout (1–10).</small></div>
        <div class="ms-row-end"><InputNumber Value="Settings.FailedAttemptsBeforeLockout" ValueChanged="@((int v) => Update(() => Settings.FailedAttemptsBeforeLockout = v))" ValueExpression="@(() => Settings.FailedAttemptsBeforeLockout)" class="ms-input" style="width:110px" /><span class="ms-muted">attempts</span></div>
    </div>
    <div class="ms-row">
        <div class="ms-row-main"><b>Sign out after inactivity</b><small>Idle minutes before a session ends (5–1440).</small></div>
        <div class="ms-row-end"><InputNumber Value="Settings.SessionTimeoutMinutes" ValueChanged="@((int v) => Update(() => Settings.SessionTimeoutMinutes = v))" ValueExpression="@(() => Settings.SessionTimeoutMinutes)" class="ms-input" style="width:110px" /><span class="ms-muted">minutes</span></div>
    </div>
    <ValidationMessage For="@(() => Settings.FailedAttemptsBeforeLockout)" />
    <ValidationMessage For="@(() => Settings.SessionTimeoutMinutes)" />
</div>

@code {
    [Parameter] public SaccoSettings Settings { get; set; } = new();
    [Parameter] public Action? OnSettingsChanged { get; set; }

    private string ComplexityHelp => Settings.PasswordComplexity switch
    {
        "Low" => "At least 6 characters.",
        "High" => "At least 12 characters with upper case, lower case, a number and a symbol.",
        _ => "At least 8 characters with upper case, lower case and a number."
    };

    private void Update(Action set) { set(); OnSettingsChanged?.Invoke(); }
    private void SetTwoFactor(bool v) => Update(() => Settings.TwoFactorAuthenticationRequired = v);
}

@page "/shares/purchase"
@page "/shares/purchase/{MemberId}"
@using System.ComponentModel.DataAnnotations
@using SaccoManagementSystem.Models
@using static Sacco_Management_System.Pages.Members.ListMember
@inject NavigationManager NavigationManager
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS

<PageTitle>Purchase shares · @Brand.Name</PageTitle>

<div class="ms-page">
    <button type="button" class="ms-back" @onclick="Back"><i class="bi bi-arrow-left"></i> Shares</button>
    <PageHeader Title="Purchase shares" Subtitle="Record a share purchase for a member." />

    @if (loading)
    {
        <div class="ms-skel" style="height:260px;max-width:980px"></div>
    }
    else
    {
        <EditForm Model="dto" OnValidSubmit="Save">
            <DataAnnotationsValidator />
            @if (!string.IsNullOrEmpty(error)) { <div class="ms-alert bad" role="alert"><i class="bi bi-exclamation-circle-fill"></i><div>@error</div></div> }

            <div class="ms-split">
                <div class="ms-form" style="max-width:none">
                    <section class="ms-fs">
                        <div class="ms-fs-head"><i class="bi bi-person"></i><div><h3>Shareholder</h3><small>Who is buying</small></div></div>
                        <div class="ms-fs-body">
                            <Field Label="Member" Required="true">
                                <SearchPicker TItem="Member" Items="members" Title="@(m => m.FullName)" Sub="@(m => m.MemberNo)"
                                              Match="@((m, q) => m.FullName.Contains(q, StringComparison.OrdinalIgnoreCase) || (m.MemberNo ?? "").Contains(q, StringComparison.OrdinalIgnoreCase))"
                                              Placeholder="Search by name or member number…" @bind-Selected="member" />
                            </Field>
                        </div>
                    </section>
                    <section class="ms-fs">
                        <div class="ms-fs-head"><i class="bi bi-pie-chart"></i><div><h3>Purchase</h3><small>Units, price and type</small></div></div>
                        <div class="ms-fs-body">
                            <div class="ms-grid-form">
                                <Field Class="c6" Label="Units" Required="true" For="@(() => dto.Units)"><InputNumber id="units" class="ms-input" @bind-Value="dto.Units" /></Field>
                                <Field Class="c6" Label="Unit price (KES)" Required="true" For="@(() => dto.UnitPrice)" Hint="Defaults to the latest active price">
                                    <div class="ms-input-icon"><span>KES</span><InputNumber id="price" class="ms-input" @bind-Value="dto.UnitPrice" /></div>
                                </Field>
                                <Field Class="c6" Label="Share type" Required="true">
                                    <InputSelect id="shareType" class="ms-select" @bind-Value="dto.ShareType">@foreach (var t in ShareTypes.All) { <option value="@t">@t</option> }</InputSelect>
                                </Field>
                                <Field Class="c6" Label="Purchase date" Required="true" For="@(() => dto.PurchaseDate)"><InputDate id="date" class="ms-input" @bind-Value="dto.PurchaseDate" /></Field>
                                <Field Class="c12" Label="Remarks"><InputTextArea id="remarks" class="ms-input" @bind-Value="dto.Remarks" /></Field>
                            </div>
                        </div>
                    </section>
                    <div class="ms-formbar">
                        <span class="sp">Fields marked * are required</span>
                        <button type="button" class="ms-btn" @onclick="Back" disabled="@busy">Cancel</button>
                        <button type="submit" class="ms-btn primary @(busy ? "busy" : "")">@if (busy) { <span class="ms-spin"></span> } else { <i class="bi bi-check2"></i> } Record purchase</button>
                    </div>
                </div>

                <aside class="ms-card ms-calc" aria-live="polite">
                    <div><small style="color:var(--ms-text-3);font-weight:700;text-transform:uppercase;letter-spacing:.06em;font-size:11px">Total cost</small></div>
                    <div class="big">KES @((dto.Units * dto.UnitPrice).ToString("N0"))</div>
                    <div class="row"><span>Units</span><b>@dto.Units.ToString("N0")</b></div>
                    <div class="row"><span>Unit price</span><b>KES @dto.UnitPrice.ToString("N2")</b></div>
                    <div class="row"><span>Type</span><b>@dto.ShareType</b></div>
                    @if (member != null) { <div class="row"><span>Buyer</span><b>@member.FullName</b></div> }
                </aside>
            </div>
        </EditForm>
    }
</div>

@code {
    [Parameter] public string? MemberId { get; set; }

    private SharePurchaseDto dto = new() { Units = 1, PurchaseDate = DateTime.Today, Status = "Active", ShareType = "Ordinary", UnitPrice = 100m };
    private List<Member> members = new();
    private Member? member;
    private bool loading = true, busy;
    private string error = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var http = HttpClientFactory.CreateClient("ApiClient");
            var m = http.GetAsync("api/members");
            var s = http.GetAsync("api/shares/summary");
            await Task.WhenAll(m, s);
            if (m.Result.IsSuccessStatusCode) members = await m.Result.Content.ReadFromJsonAsync<List<Member>>() ?? new();
            if (s.Result.IsSuccessStatusCode)
            {
                var sum = await s.Result.Content.ReadFromJsonAsync<ShareSummaryDto>();
                if (sum != null && sum.CurrentSharePrice > 0) dto.UnitPrice = sum.CurrentSharePrice;
            }
            if (int.TryParse(MemberId, out var id) && id > 0) member = members.FirstOrDefault(x => x.MemberId == id);
        }
        catch (Exception ex) { error = $"Failed to load data: {ex.Message}"; }
        finally { loading = false; }
    }

    private async Task Save()
    {
        error = "";
        if (member == null) { error = "Please select a member."; return; }
        busy = true;
        try
        {
            dto.MemberId = member.MemberId;
            var http = HttpClientFactory.CreateClient("ApiClient");
            var r = await http.PostAsJsonAsync("api/shares/add", dto);
            if (r.IsSuccessStatusCode)
            {
                await JS.InvokeVoidAsync("ms.toast", "success", "Purchase recorded", $"{dto.Units:N0} units for {member.FullName}");
                NavigationManager.NavigateTo($"/shares/member/{member.MemberId}");
                return;
            }
            var body = await r.Content.ReadAsStringAsync();
            error = string.IsNullOrWhiteSpace(body) ? "The server couldn't record this purchase." : body;
        }
        catch (Exception ex) { error = $"Purchase failed: {ex.Message}"; }
        finally { busy = false; }
    }

    private void Back() => NavigationManager.NavigateTo("/shares");
}

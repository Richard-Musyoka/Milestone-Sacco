<div class="ms-card ms-stat">
    <div class="ms-stat-top">
        <span class="ms-stat-ico @Tone"><i class="bi @Icon"></i></span>
        <span>@Label</span>
    </div>
    <div class="ms-stat-val">@if (!string.IsNullOrEmpty(Prefix)) { <small>@Prefix</small> }@Value</div>
    <div class="ms-stat-foot">
        @if (!string.IsNullOrEmpty(Delta)) { <span class="ms-delta @(DeltaDown ? "down" : "")"><i class="bi @(DeltaDown ? "bi-arrow-down-right" : "bi-arrow-up-right")"></i>@Delta</span> }
        @if (!string.IsNullOrEmpty(Foot)) { <span>@Foot</span> }
    </div>
    @if (Spark is { Length: > 1 })
    {
        <svg class="ms-spark" viewBox="0 0 100 34" preserveAspectRatio="none" aria-hidden="true">
            <polyline fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="color:var(--ms-accent)" points="@SparkPoints" />
        </svg>
    }
</div>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public string? Prefix { get; set; }
    [Parameter] public string Icon { get; set; } = "bi-graph-up";
    [Parameter] public string Tone { get; set; } = "";
    [Parameter] public string? Delta { get; set; }
    [Parameter] public bool DeltaDown { get; set; }
    [Parameter] public string? Foot { get; set; }
    [Parameter] public double[]? Spark { get; set; }

    private string SparkPoints
    {
        get
        {
            if (Spark == null || Spark.Length < 2) return "";
            var min = Spark.Min(); var max = Spark.Max(); var span = max - min == 0 ? 1 : max - min;
            return string.Join(' ', Spark.Select((v, i) =>
                $"{(i * 100.0 / (Spark.Length - 1)).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)},{(30 - (v - min) / span * 26).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)}"));
        }
    }
}

/* =====================================================================
   Sign-in / access experience (au-*). Loaded after milestone.css.
   ===================================================================== */
.au{min-height:100vh;display:grid;grid-template-columns:minmax(0,1.08fr) minmax(0,1fr);background:var(--ms-bg);font-family:var(--ms-font);color:var(--ms-text)}
.au *{box-sizing:border-box}

/* ---------- hero ---------- */
.au-hero{position:relative;overflow:hidden;isolation:isolate;color:#fff;padding:44px 56px;display:flex;flex-direction:column;background:#071428}
.au-hero::before{content:"";position:absolute;inset:-20%;z-index:-2;background:
  radial-gradient(40% 40% at 15% 15%,rgba(47,111,235,.55),transparent 70%),
  radial-gradient(38% 38% at 90% 20%,rgba(63,203,149,.38),transparent 70%),
  radial-gradient(45% 45% at 70% 95%,rgba(212,166,42,.28),transparent 70%),
  radial-gradient(40% 40% at 10% 90%,rgba(13,107,75,.55),transparent 70%);
  filter:blur(30px);animation:au-drift 18s ease-in-out infinite alternate}
.au-hero::after{content:"";position:absolute;inset:0;z-index:-1;opacity:.55;
  background-image:linear-gradient(rgba(255,255,255,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.05) 1px,transparent 1px);
  background-size:44px 44px;-webkit-mask-image:radial-gradient(80% 70% at 30% 30%,#000 30%,transparent 100%);mask-image:radial-gradient(80% 70% at 30% 30%,#000 30%,transparent 100%)}
@keyframes au-drift{from{transform:translate3d(-2%,-1%,0) scale(1)}to{transform:translate3d(3%,2%,0) scale(1.08)}}
.au-brand{display:flex;align-items:center;gap:12px}
.au-mark{width:44px;height:44px;border-radius:13px;display:grid;place-items:center;font-size:21px;color:#06281c;background:linear-gradient(135deg,#7ff0c3,#3FCB95);box-shadow:0 8px 24px rgba(63,203,149,.35)}
.au-brand b{display:block;font-size:18px;letter-spacing:-.01em}.au-brand small{color:#9fb1cc;font-weight:600}
.au-copy{margin:auto 0 0;max-width:560px}
.au-eyebrow{display:inline-flex;gap:8px;align-items:center;padding:6px 12px;border-radius:99px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.14);font-size:12.5px;font-weight:700;color:#cfe0f7;backdrop-filter:blur(8px)}
.au-eyebrow i{color:#3FCB95}
.au-copy h1{font-size:clamp(34px,4vw,52px);line-height:1.04;letter-spacing:-.035em;font-weight:800;margin:18px 0 14px}
.au-copy h1 em{font-style:normal;background:linear-gradient(90deg,#7ff0c3,#f6d38c);-webkit-background-clip:text;background-clip:text;color:transparent}
.au-copy p{color:#b8c8e0;font-size:16.5px;line-height:1.6;max-width:480px;margin:0}
.au-tiles{display:grid;gap:12px;margin:34px 0 26px;max-width:520px}
.au-tile{display:flex;gap:14px;align-items:center;padding:14px 16px;border-radius:16px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);backdrop-filter:blur(14px);transition:transform .25s,background .25s;animation:au-rise .7s both}
.au-tile:nth-child(2){animation-delay:.1s}.au-tile:nth-child(3){animation-delay:.2s}
.au-tile:hover{transform:translateX(6px);background:rgba(255,255,255,.11)}
.au-tile i{flex:none;width:42px;height:42px;border-radius:12px;display:grid;place-items:center;font-size:19px;background:rgba(255,255,255,.1);color:#7ff0c3}
.au-tile:nth-child(2) i{color:#8db3ff}.au-tile:nth-child(3) i{color:#f6d38c}
.au-tile b{display:block;font-size:14.5px}.au-tile span{color:#a9bad3;font-size:13px}
@keyframes au-rise{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
.au-trust{display:flex;flex-wrap:wrap;gap:8px 22px;color:#8fa4c4;font-size:12.5px;font-weight:600;margin-top:auto;padding-top:20px}
.au-trust span{display:inline-flex;gap:7px;align-items:center}.au-trust i{color:#3FCB95}

/* ---------- panel ---------- */
.au-side{position:relative;display:flex;flex-direction:column;padding:22px 28px 26px}
.au-top{display:flex;justify-content:flex-end;gap:10px;align-items:center}
.au-top .ms-icon-btn{width:38px;height:38px}
.au-center{flex:1;display:grid;place-items:center;padding:18px 0}
.au-card{width:100%;max-width:436px;animation:au-rise .5s both}
.au-mobile-brand{display:none;align-items:center;gap:10px;margin-bottom:22px;font-weight:800;font-size:17px}
.au-mobile-brand .au-mark{width:38px;height:38px;font-size:18px;border-radius:11px}
.au-card h2{font-size:29px;font-weight:800;letter-spacing:-.025em;margin:0 0 6px}
.au-lead{color:var(--ms-text-3);margin:0 0 24px;font-size:14.5px;line-height:1.55}
.au-badge{width:54px;height:54px;border-radius:16px;display:grid;place-items:center;font-size:24px;background:var(--ms-accent-soft);color:var(--ms-accent);margin-bottom:16px}
.au-badge.ok{animation:au-pop .5s both}
@keyframes au-pop{0%{transform:scale(.4);opacity:0}70%{transform:scale(1.12)}100%{transform:scale(1);opacity:1}}

.au-tabs{position:relative;display:grid;grid-template-columns:1fr 1fr;padding:4px;margin-bottom:26px;background:var(--ms-surface-2);border:1px solid var(--ms-border);border-radius:14px}
.au-tabs::before{content:"";position:absolute;top:4px;bottom:4px;left:4px;width:calc(50% - 4px);border-radius:10px;background:var(--ms-surface);box-shadow:var(--ms-shadow-2);transition:transform .28s cubic-bezier(.4,.1,.2,1)}
.au-tabs[data-pos="1"]::before{transform:translateX(100%)}
.au-tabs button{position:relative;z-index:1;height:40px;border:0;background:none;font:inherit;font-weight:700;font-size:14px;color:var(--ms-text-3);cursor:pointer;transition:color .2s}
.au-tabs button.on{color:var(--ms-text)}

.au-field{margin-bottom:16px}
.au-field>label{display:flex;justify-content:space-between;font-size:13px;font-weight:700;color:var(--ms-text-2);margin-bottom:7px}
.au-field>label a,.au-link{color:var(--ms-accent);font-weight:700;text-decoration:none;cursor:pointer;background:none;border:0;padding:0;font:inherit;font-weight:700;font-size:13px}
.au-link:hover,.au-field>label a:hover{text-decoration:underline}
.au-in{position:relative}
.au-in>i.lead{position:absolute;left:14px;top:50%;transform:translateY(-50%);color:var(--ms-text-3);font-size:16px;pointer-events:none;transition:color .15s}
.au-in input{width:100%;height:50px;padding:0 44px 0 42px;border-radius:13px;border:1.5px solid var(--ms-border);background:var(--ms-surface);color:var(--ms-text);font:inherit;font-size:15px;transition:border-color .15s,box-shadow .15s}
.au-in input::placeholder{color:var(--ms-text-3);opacity:.7}
.au-in input:hover{border-color:var(--ms-border-strong)}
.au-in input:focus{outline:0;border-color:var(--ms-accent);box-shadow:0 0 0 4px var(--ms-accent-soft)}
.au-in:focus-within>i.lead{color:var(--ms-accent)}
.au-in .eye{position:absolute;right:6px;top:50%;transform:translateY(-50%);width:38px;height:38px;border:0;background:none;color:var(--ms-text-3);cursor:pointer;border-radius:10px}
.au-in .eye:hover{color:var(--ms-text);background:var(--ms-surface-2)}
.au-row2{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.au-opts{display:flex;align-items:center;justify-content:space-between;margin:2px 0 20px;font-size:13.5px}
.au-btn{width:100%;height:52px;border-radius:14px;border:1.5px solid var(--ms-border);background:var(--ms-surface);color:var(--ms-text);font:inherit;font-weight:700;font-size:15px;cursor:pointer;display:inline-flex;gap:9px;align-items:center;justify-content:center;transition:transform .12s,box-shadow .2s,background .2s,border-color .2s}
.au-btn:hover{border-color:var(--ms-border-strong);box-shadow:var(--ms-shadow-2)}
.au-btn:active{transform:translateY(1px)}
.au-btn.primary{border:0;color:#fff;background:linear-gradient(135deg,#0d8a5e,#0B7A52 55%,#0a6a48);box-shadow:0 10px 24px rgba(11,122,82,.32)}
.au-btn.primary:hover{box-shadow:0 14px 30px rgba(11,122,82,.42);filter:brightness(1.05)}
.au-btn[disabled]{opacity:.6;cursor:not-allowed;box-shadow:none}
.au-btn.ghost{border-color:transparent;background:none;height:44px;color:var(--ms-text-2)}
.au-btn.ghost:hover{background:var(--ms-surface-2);box-shadow:none}
.au-or{display:flex;align-items:center;gap:12px;color:var(--ms-text-3);font-size:12.5px;font-weight:700;margin:20px 0}
.au-or::before,.au-or::after{content:"";flex:1;height:1px;background:var(--ms-border)}
.au-note{display:flex;gap:10px;align-items:flex-start;padding:12px 14px;border-radius:12px;font-size:13.5px;font-weight:600;line-height:1.45;margin-bottom:18px}
.au-note.bad{background:var(--ms-red-soft);color:var(--ms-red)}.au-note.ok{background:var(--ms-accent-soft);color:var(--ms-accent)}
.au-note.warn{background:var(--ms-amber-soft);color:var(--ms-amber)}.au-note.info{background:var(--ms-blue-soft);color:var(--ms-blue)}
.au-note i{margin-top:2px}
.au-methods{display:grid;grid-template-columns:repeat(auto-fit,minmax(88px,1fr));gap:8px;margin-bottom:20px}
.au-method{display:flex;flex-direction:column;align-items:center;gap:6px;padding:12px 6px;border-radius:13px;border:1.5px solid var(--ms-border);background:var(--ms-surface);font:inherit;font-size:12.5px;font-weight:700;color:var(--ms-text-2);cursor:pointer;transition:all .15s}
.au-method i{font-size:19px;color:var(--ms-text-3)}
.au-method:hover{border-color:var(--ms-border-strong)}
.au-method.on{border-color:var(--ms-accent);background:var(--ms-accent-soft);color:var(--ms-accent)}.au-method.on i{color:var(--ms-accent)}
.au-otp input{width:100%;height:64px;text-align:center;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:30px;font-weight:800;letter-spacing:.5em;padding-left:.5em;border-radius:14px;border:1.5px solid var(--ms-border);background:var(--ms-surface);color:var(--ms-text)}
.au-otp input:focus{outline:0;border-color:var(--ms-accent);box-shadow:0 0 0 4px var(--ms-accent-soft)}
.au-strength{display:flex;gap:5px;margin-top:9px}.au-strength i{flex:1;height:5px;border-radius:99px;background:var(--ms-border);transition:background .2s}
.au-strength i.s1{background:var(--ms-red)}.au-strength i.s2{background:var(--ms-amber)}.au-strength i.s3{background:var(--ms-gold)}.au-strength i.s4{background:var(--ms-accent)}
.au-hint{font-size:12.5px;color:var(--ms-text-3);margin-top:6px;display:block}
.au-foot{text-align:center;color:var(--ms-text-3);font-size:12px;padding-top:10px}
.au-center-text{text-align:center}.au-center-text .au-badge{margin-inline:auto}
.au-spin{width:18px;height:18px;border-radius:50%;border:2.5px solid rgba(255,255,255,.4);border-top-color:#fff;animation:au-rot .7s linear infinite}
.au-btn:not(.primary) .au-spin{border-color:var(--ms-border-strong);border-top-color:var(--ms-accent)}
@keyframes au-rot{to{transform:rotate(360deg)}}
.au-check{display:flex;gap:9px;align-items:center;font-weight:600;color:var(--ms-text-2);cursor:pointer;font-size:13.5px}
.au-check input{width:18px;height:18px;accent-color:var(--ms-accent)}

[data-theme="dark"] .au-in input,[data-theme="dark"] .au-otp input{background:var(--ms-surface-2)}
@media (max-width:992px){.au{grid-template-columns:1fr}.au-hero{display:none}.au-mobile-brand{display:flex}.au-side{padding:18px 18px 24px}}
@media (max-width:480px){.au-row2{grid-template-columns:1fr}.au-card h2{font-size:25px}}
@media (prefers-reduced-motion:reduce){.au-hero::before,.au-tile,.au-card,.au-badge.ok{animation:none}}

@page "/settings"
@using System.Security.Claims
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Sacco_Management_System.Models
@using SaccoManagementSystem.Security
@using SaccoManagementSystem.Services
@inject HttpClient Http
@inject IJSRuntime JsRuntime
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthState

<PageTitle>Settings · @Brand.Name</PageTitle>

<div class="ms-page">
    @if (isLoading)
    {
        <div class="ms-skel" style="height:190px;border-radius:26px;margin-bottom:18px"></div>
        <div class="ms-skel" style="height:420px;border-radius:24px"></div>
    }
    else
    {
        <section class="cc-hero">
            <div class="cc-logo">@if (!string.IsNullOrEmpty(cfg.LogoDataUrl)) { <img src="@cfg.LogoDataUrl" alt="" /> } else { <b>@Initial</b> }</div>
            <div>
                <span class="cc-kicker"><i class="bi bi-sliders2-vertical"></i> Control centre</span>
                <h1>@(string.IsNullOrWhiteSpace(cfg.Name) ? Brand.Name : cfg.Name) settings</h1>
                <p>Everything about how your SACCO looks, behaves and protects itself, in one place. Changes apply to everyone once saved.</p>
                <div class="cc-actions">
                    <button type="button" class="ms-btn" @onclick="ExportConfig"><i class="bi bi-download"></i> Export configuration</button>
                    <label class="ms-btn" style="cursor:@(ReadOnly ? "not-allowed" : "pointer")"><i class="bi bi-upload"></i> Import<InputFile OnChange="ImportConfig" accept=".json" disabled="@ReadOnly" /></label>
                    <button type="button" class="ms-btn" @onclick='() => JsRuntime.InvokeVoidAsync("ms.focus", "cc-q")'><i class="bi bi-search"></i> Find a setting</button>
                </div>
            </div>
            <div class="cc-health">
                <div class="cc-ring" style="--v:@Pct"><b>@Pct%</b></div>
                <div>
                    <b class="big">@Done of @Checks.Count</b>
                    <small>recommended settings in place</small>
                    @if (Missing.Any())
                    {
                        <ul>@foreach (var m in Missing.Take(2)) { <li><i class="bi bi-dot"></i>@m</li> }</ul>
                    }
                    else { <small style="color:var(--ms-accent);margin-top:6px">Nicely set up.</small> }
                </div>
            </div>
        </section>

        <div class="cc-chips">
            <div class="cc-chip"><span class="cc-ico" style="--t:#ef4444"><i class="bi bi-shield-check"></i></span><div><small>Security score</small><b>@SecuritySettingsTab.ScoreOf(cfg, settings) / 100</b></div></div>
            <div class="cc-chip"><span class="cc-ico" style="--t:#0ea5b7"><i class="bi bi-cash-coin"></i></span><div><small>Currency</small><b>@settings.Currency (@cfg.CurrencySymbol)</b></div></div>
            <div class="cc-chip"><span class="cc-ico" style="--t:#2559C7"><i class="bi bi-calendar3"></i></span><div><small>Financial year</small><b>@settings.FiscalYearStart.ToString("MMM") to @settings.FiscalYearEnd.ToString("MMM")</b></div></div>
            <div class="cc-chip"><span class="cc-ico" style="--t:#D4A62A"><i class="bi bi-bank2"></i></span><div><small>Loan interest</small><b>@settings.LoanInterestRate.ToString("0.##")% a year</b></div></div>
        </div>

        <div class="cc-shell">
            <nav class="cc-rail" aria-label="Settings sections">
                <div class="cc-search"><i class="bi bi-search"></i><input id="cc-q" type="search" placeholder="Search settings" autocomplete="off" @bind="filter" @bind:event="oninput" /></div>
                @foreach (var g in Groups)
                {
                    var items = Tabs.Where(t => t.Group == g && Matches(t)).ToList();
                    if (items.Count == 0) { continue; }
                    <div class="cc-group">@g</div>
                    @foreach (var t in items)
                    {
                        <button type="button" class="cc-item @(activeTab == t.Key ? "on" : "")" @onclick="() => SetActiveTab(t.Key)" aria-current="@(activeTab == t.Key ? "page" : null)">
                            <span class="cc-ico" style="--t:@t.Color"><i class="bi @t.Icon"></i></span>
                            <span><b>@t.Title</b><small>@t.Hint</small></span>
                        </button>
                    }
                }
                <div class="cc-foot">
                    @if (cfg.UpdatedUtc.HasValue) { <span>Last changed @cfg.UpdatedUtc.Value.ToLocalTime().ToString("d MMM yyyy") by @cfg.UpdatedBy</span> } else { <span>No changes saved yet</span> }
                    <br /><a href="audit-trail">View history</a>
                </div>
            </nav>

            <div class="cc-main" @key="activeTab">
                <div class="cc-head">
                    <span class="cc-big" style="--t:@Current.Color"><i class="bi @Current.Icon"></i></span>
                    <div><small>@Current.Group</small><h2>@Current.Title</h2><p>@Current.Description</p></div>
                    @if (IsPolicyTab)
                    {
                        <span class="ms-pill @(isDirty ? "warn dot" : "ok dot")" style="margin-left:auto">@(isDirty ? "Unsaved changes" : "All changes saved")</span>
                    }
                </div>

                @if (ReadOnly && IsPolicyTab)
                {
                    <div class="cc-viewonly"><i class="bi bi-eye"></i> You can view these settings. Only administrators can change them.</div>
                }
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="ms-alert bad"><i class="bi bi-exclamation-triangle-fill"></i><div>@errorMessage</div></div>
                }

                @if (activeTab == "security-center") { <SecurityCenter /> }
                else if (activeTab == "account") { <AccountTab /> }
                else if (activeTab == "about") { <AboutTab Cfg="cfg" /> }
                else
                {
                    <EditForm Model="settings" OnValidSubmit="Save" OnInvalidSubmit="HandleInvalid" @ref="editForm">
                        <DataAnnotationsValidator />
                        <CascadingValue Value="editForm?.EditContext">
                            <div class="cc-main">
                                @if (activeTab == "general") { <GeneralSettingsTab Cfg="cfg" Settings="settings" ReadOnly="ReadOnly" OnChanged="Changed" /> }
                                else if (activeTab == "branding") { <BrandingTab Cfg="cfg" ReadOnly="ReadOnly" OnChanged="Changed" /> }
                                else if (activeTab == "regional") { <RegionalTab Cfg="cfg" Settings="settings" ReadOnly="ReadOnly" OnChanged="Changed" /> }
                                else if (activeTab == "appearance") { <AppearanceSettings Cfg="cfg" ReadOnly="ReadOnly" OnChanged="Changed" /> }
                                else if (activeTab == "security") { <SecuritySettingsTab Cfg="cfg" Settings="settings" ReadOnly="ReadOnly" OnChanged="Changed" /> }
                                else
                                {
                                    <fieldset class="cc-fs" disabled="@ReadOnly"><div class="cc-card cc-legacy">
                                        @if (activeTab == "financial") { <FinancialSettingsTab Settings="settings" OnSettingsChanged="Changed" /> }
                                        else if (activeTab == "loan") { <LoanSettingsTab Settings="settings" OnSettingsChanged="Changed" /> }
                                        else if (activeTab == "notification") { <NotificationSettingsTab Settings="settings" OnSettingsChanged="Changed" /> }
                                    </div></fieldset>
                                }
                            </div>
                            @if (isDirty && !ReadOnly)
                            {
                                <div class="ms-savebar" role="status">
                                    <i class="bi bi-pencil-square"></i>
                                    <span>You have unsaved changes</span>
                                    <button type="button" class="ms-btn" @onclick="Discard">Discard</button>
                                    <button type="submit" class="ms-btn primary @(isSaving ? "busy" : "")" disabled="@isSaving">@if (isSaving) { <span class="ms-spin"></span> } Save changes</button>
                                </div>
                            }
                        </CascadingValue>
                    </EditForm>
                }
            </div>
        </div>
    }
</div>

@code {
    private sealed record Tab(string Key, string Group, string Title, string Hint, string Icon, string Description, string Color, string Words);

    private static readonly string[] Groups = { "Organization", "Experience", "Sacco rules", "Communication", "Security & access", "You", "System" };

    private static readonly Tab[] Tabs =
    {
        new("general", "Organization", "General", "Name, contact, financial year", "bi-building", "Your SACCO's identity, contact details and financial year.", "#0B7A52", "name registration tagline email phone address fiscal year"),
        new("branding", "Organization", "Branding", "Logo and brand colour", "bi-palette2", "Your logo and colour, shown across the app and on the sign-in page.", "#ec4899", "logo colour color brand favicon"),
        new("regional", "Organization", "Regional", "Currency, format, time zone", "bi-globe2", "Currency, number and date formats and time zone.", "#0ea5b7", "currency kes symbol locale timezone date format"),
        new("appearance", "Experience", "Appearance", "Theme, density, sidebar", "bi-sliders", "Default look for everyone, plus your own theme on this device.", "#8b5cf6", "theme dark light density corners sidebar compact"),
        new("financial", "Sacco rules", "Shares & finance", "Share price, dividends, fees", "bi-cash-stack", "Share pricing, limits, dividend and penalty rates.", "#2559C7", "share price dividend penalty interest method minimum maximum"),
        new("loan", "Sacco rules", "Loans", "Limits, rates, guarantors", "bi-bank2", "Lending rules used when members apply for loans.", "#D4A62A", "loan rate multiple repayment guarantor eligibility fee"),
        new("notification", "Communication", "Notifications", "Email and SMS", "bi-bell", "How the SACCO talks to members and staff.", "#f97316", "email sms reminder sender notification"),
        new("security", "Security & access", "Security policy", "Passwords, lockout, 2-step", "bi-shield-lock", "Sign-in rules for everyone in the organisation.", "#ef4444", "password mfa two step 2fa lockout session expiry registration otp"),
        new("security-center", "Security & access", "My security", "Authenticator, passkeys, devices", "bi-fingerprint", "How you sign in: authenticator app, passkeys, biometrics and trusted devices.", "#0b7285", "biometric passkey fingerprint authenticator devices sessions backup codes"),
        new("account", "You", "My account", "Profile and password", "bi-person-circle", "Your own details.", "#6366f1", "profile password name"),
        new("about", "System", "About", "Version and history", "bi-info-circle", "Version details and where changes are recorded.", "#64748b", "version about audit history"),
    };

    private string activeTab = "general";
    private string filter = "";
    private bool isDirty, isLoading = true, isSaving, isAdmin;
    private string errorMessage = "";
    private SaccoSettings settings = new(), origSettings = new();
    private OrgConfig cfg = new(), origCfg = new();
    private EditForm? editForm;

    [SupplyParameterFromQuery(Name = "tab")] public string? TabParam { get; set; }

    private Tab Current => Tabs.FirstOrDefault(t => t.Key == activeTab) ?? Tabs[0];
    private bool ReadOnly => !isAdmin;
    private bool IsPolicyTab => activeTab is not ("security-center" or "account" or "about");
    private string Initial => string.IsNullOrWhiteSpace(cfg.Name) ? "S" : cfg.Name.Trim().Substring(0, 1).ToUpperInvariant();
    private bool Matches(Tab t) => string.IsNullOrWhiteSpace(filter) ||
        t.Title.Contains(filter, StringComparison.OrdinalIgnoreCase) || t.Hint.Contains(filter, StringComparison.OrdinalIgnoreCase) || t.Words.Contains(filter, StringComparison.OrdinalIgnoreCase);

    // ---------------------------------------------------------------- setup health
    private List<(string Label, bool Ok)> Checks => new()
    {
        ("Upload your logo", !string.IsNullOrEmpty(cfg.LogoDataUrl)),
        ("Add a tagline", !string.IsNullOrWhiteSpace(cfg.Tagline)),
        ("Add a contact email", !string.IsNullOrWhiteSpace(cfg.Email)),
        ("Add a contact phone", !string.IsNullOrWhiteSpace(cfg.Phone)),
        ("Enter your registration number", !string.IsNullOrWhiteSpace(settings.RegistrationNumber)),
        ("Set a real notification email", !string.IsNullOrWhiteSpace(settings.DefaultNotificationEmail) && settings.DefaultNotificationEmail != "admin@sacco.com"),
        ("Strengthen password rules", SecuritySettingsTab.ScoreOf(cfg, settings) >= 75),
        ("Require two-step verification", settings.TwoFactorAuthenticationRequired),
    };
    private int Done => Checks.Count(c => c.Ok);
    private int Pct => Checks.Count == 0 ? 0 : (int)Math.Round(100.0 * Done / Checks.Count);
    private IEnumerable<string> Missing => Checks.Where(c => !c.Ok).Select(c => c.Label);

    protected override void OnParametersSet()
    {
        activeTab = !string.IsNullOrEmpty(TabParam) && Tabs.Any(t => t.Key == TabParam) ? TabParam : (string.IsNullOrEmpty(TabParam) ? "general" : "general");
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var st = await AuthState.GetAuthenticationStateAsync();
            isAdmin = (st.User.FindFirstValue(ClaimTypes.Role) ?? "") == Roles.Admin;
        }
        catch { }

        try
        {
            var r = await Http.GetAsync($"{NavigationManager.BaseUri}api/settings");
            if (r.IsSuccessStatusCode) settings = await r.Content.ReadFromJsonAsync<SaccoSettings>() ?? SaccoSettings.GetDefaultSettings();
            else { settings = SaccoSettings.GetDefaultSettings(); errorMessage = "Couldn't load settings from the server, so defaults are shown."; }
        }
        catch (Exception ex) { errorMessage = "Couldn't load settings: " + ex.Message; settings = SaccoSettings.GetDefaultSettings(); }

        try
        {
            var r = await Http.GetAsync($"{NavigationManager.BaseUri}api/config");
            if (r.IsSuccessStatusCode) cfg = await r.Content.ReadFromJsonAsync<OrgConfig>() ?? new OrgConfig();
        }
        catch { }
        if (string.IsNullOrWhiteSpace(cfg.Name)) cfg.Name = settings.SACCOName;

        origSettings = (SaccoSettings)settings.Clone();
        origCfg = cfg with { };
        isLoading = false;
    }

    private void SetActiveTab(string tab)
    {
        activeTab = tab;
        NavigationManager.NavigateTo("settings?tab=" + tab, replace: true);
    }

    private async void Changed()
    {
        isDirty = !settings.Equals(origSettings) || cfg != origCfg;
        StateHasChanged();
        await PreviewLive();
    }

    private async Task PreviewLive()
    {
        try { await JsRuntime.InvokeVoidAsync("ms.applyOrg", OrgShape(cfg), ConfigStore.ThemeCss(cfg)); } catch { }
    }

    private static object OrgShape(OrgConfig c) => new { theme = c.DefaultTheme, density = c.Density, corners = c.Corners, banners = c.PageBanners, sidebar = c.SidebarStyle };

    private void HandleInvalid()
    {
        errorMessage = "Some settings need attention. Check the highlighted fields.";
    }

    private async Task Discard()
    {
        settings = (SaccoSettings)origSettings.Clone();
        cfg = origCfg with { };
        isDirty = false;
        errorMessage = "";
        await PreviewLive();
    }

    private async Task Save()
    {
        isSaving = true; errorMessage = "";
        try
        {
            if (cfg.Name != settings.SACCOName && !string.IsNullOrWhiteSpace(cfg.Name)) settings.SACCOName = cfg.Name;

            if (cfg != origCfg)
            {
                var r = await Http.PutAsJsonAsync($"{NavigationManager.BaseUri}api/config", cfg);
                if (!r.IsSuccessStatusCode)
                {
                    errorMessage = await ReadError(r);
                    await JsRuntime.InvokeVoidAsync("ms.toast", "error", "Couldn't save settings");
                    return;
                }
                var saved = await r.Content.ReadFromJsonAsync<OrgConfig>();
                if (saved != null) cfg = saved;
                origCfg = cfg with { };
            }
            if (!settings.Equals(origSettings))
            {
                var r = await Http.PutAsJsonAsync($"{NavigationManager.BaseUri}api/settings", settings);
                if (!r.IsSuccessStatusCode)
                {
                    errorMessage = await ReadError(r);
                    await JsRuntime.InvokeVoidAsync("ms.toast", "error", "Couldn't save settings");
                    return;
                }
                origSettings = (SaccoSettings)settings.Clone();
            }
            isDirty = false;
            await PreviewLive();
            await JsRuntime.InvokeVoidAsync("ms.toast", "success", "Settings saved");
        }
        catch (Exception ex)
        {
            errorMessage = "Network error: " + ex.Message;
            await JsRuntime.InvokeVoidAsync("ms.toast", "error", "Couldn't save settings");
        }
        finally { isSaving = false; }
    }

    private static async Task<string> ReadError(HttpResponseMessage r)
    {
        var body = await r.Content.ReadAsStringAsync();
        try
        {
            using var d = JsonDocument.Parse(body);
            if (d.RootElement.ValueKind == JsonValueKind.Object && d.RootElement.TryGetProperty("message", out var m)) return m.GetString() ?? "The server rejected the change.";
        }
        catch { }
        return "The server rejected the change (" + (int)r.StatusCode + "). " + (body.Length > 200 ? "" : body);
    }

    // ---------------------------------------------------------------- export / import
    private async Task ExportConfig()
    {
        var json = JsonSerializer.Serialize(new { exportedUtc = DateTime.UtcNow, organisation = cfg, settings }, new JsonSerializerOptions { WriteIndented = true });
        await JsRuntime.InvokeVoidAsync("ms.download", "sacco-configuration-" + DateTime.Now.ToString("yyyyMMdd") + ".json", json);
        await JsRuntime.InvokeVoidAsync("ms.toast", "success", "Configuration exported");
    }

    private async Task ImportConfig(InputFileChangeEventArgs e)
    {
        if (ReadOnly) return;
        try
        {
            using var s = e.File.OpenReadStream(2_000_000);
            using var doc = await JsonDocument.ParseAsync(s);
            var web = new JsonSerializerOptions(JsonSerializerDefaults.Web);
            if (doc.RootElement.TryGetProperty("organisation", out var o))
            {
                var c = o.Deserialize<OrgConfig>(web);
                if (c != null) { c.UpdatedUtc = cfg.UpdatedUtc; c.UpdatedBy = cfg.UpdatedBy; cfg = c; }
            }
            if (doc.RootElement.TryGetProperty("settings", out var st))
            {
                var x = st.Deserialize<SaccoSettings>(web);
                if (x != null) settings = x;
            }
            Changed();
            await JsRuntime.InvokeVoidAsync("ms.toast", "success", "Configuration loaded", "Review it, then save to apply.");
        }
        catch { await JsRuntime.InvokeVoidAsync("ms.toast", "error", "That file isn't a valid configuration export"); }
    }
}

@using System.Security.Claims
@using SaccoManagementSystem.Security
@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@Brand.Name</PageTitle>

<div class="ms-app">
    <aside class="ms-sidebar" aria-label="Sidebar">
        <NavMenu />
    </aside>
    <div class="ms-scrim"></div>

    <div class="ms-main">
        <header class="ms-topbar">
            <button type="button" class="ms-icon-btn" data-ms-nav-toggle aria-label="Toggle navigation"><i class="bi bi-list" style="font-size:20px"></i></button>

            <div class="ms-crumbs">
                <span class="ms-crumb-ico"><i class="bi @CrumbIcon"></i></span>
                @if (CrumbParent != null) { <span class="ms-crumb-parent"><a href="@CrumbParentHref" style="color:inherit">@CrumbParent</a></span><i class="bi bi-chevron-right"></i> }
                <b>@CrumbTitle</b>
            </div>

            <div class="ms-top-spacer"></div>

            <button type="button" class="ms-search" data-ms-cmd aria-label="Search" style="flex:0 1 320px">
                <i class="bi bi-search"></i><span>Search or jump to…</span><kbd>Ctrl K</kbd>
            </button>

            <button type="button" class="ms-icon-btn ms-theme-btn" data-ms-theme title="Switch light / dark" aria-label="Switch light or dark theme"><i class="bi bi-moon-stars ms-t-dark"></i><i class="bi bi-sun ms-t-light"></i></button>

            @if (CanSeeAudit)
            {
                <a class="ms-icon-btn" href="audit-trail" title="Activity" aria-label="Activity"><i class="bi bi-bell"></i></a>
            }

            <div class="ms-dd" data-ms-dd>
                <button type="button" class="ms-user-btn ms-dd-trigger" aria-haspopup="menu">
                    <span class="ms-avatar">@Initials</span>
                    <span class="ms-user-meta"><b>@DisplayName</b><small>@Role</small></span>
                    <i class="bi bi-chevron-down ms-muted" style="font-size:12px"></i>
                </button>
                <div class="ms-dd-menu" role="menu">
                    <div class="ms-dd-head"><b>@DisplayName</b><small>@Email</small></div>
                    <a class="ms-dd-item" href="profile"><i class="bi bi-person"></i> My profile</a>
                    <a class="ms-dd-item" href="settings?tab=security-center"><i class="bi bi-shield-lock"></i> Security Center</a>
                    <a class="ms-dd-item" href="settings?tab=appearance"><i class="bi bi-palette"></i> Appearance</a>
                    <a class="ms-dd-item" href="settings"><i class="bi bi-sliders"></i> Settings</a>
                    <div class="ms-dd-sep"></div>
                    <button type="button" class="ms-dd-item danger" @onclick="Logout"><i class="bi bi-box-arrow-right"></i> Sign out</button>
                </div>
            </div>
        </header>

        @if (PasswordExpired)
        {
            <div class="ms-banner warn"><i class="bi bi-exclamation-triangle-fill"></i> Your password has expired under your organisation's policy. <a href="settings?tab=security-center">Change it now</a></div>
        }
        else if (MustEnroll)
        {
            <div class="ms-banner warn"><i class="bi bi-shield-exclamation"></i> Your organisation requires two-step verification. <a href="settings?tab=security-center">Set it up</a></div>
        }

        <main class="ms-content">
            <div class="ms-body" @key="refreshKey">
                @if (Denied)
                {
                    <div class="ms-page">
                        <div class="ms-card ms-card-pad ms-empty">
                            <i class="bi bi-lock"></i>
                            <b>Your role doesn't include this page</b>
                            You're signed in as @Role. Ask an administrator if you need access. <a href="dashboard">Back to the dashboard</a>
                        </div>
                    </div>
                }
                else
                {
                    @Body
                }
            </div>
        </main>
    </div>
</div>

<DrawerHost OnSaved="RefreshPage" />

@code {
    private int refreshKey;
    private void RefreshPage() { refreshKey++; StateHasChanged(); }

    [CascadingParameter] private Task<AuthenticationState>? Auth { get; set; }

    private string DisplayName = "Guest";
    private string FirstName = "there";
    private string Email = "";
    private string Role = "";
    private string Initials = "?";
    private bool PasswordExpired;
    private bool MustEnroll;
    private bool Denied;
    private bool CanSeeAudit;

    private string CrumbTitle = "Dashboard";
    private string CrumbIcon = "bi-grid-1x2-fill";
    private string? CrumbParent;
    private string CrumbParentHref = "";

    private static readonly Dictionary<string, (string Title, string Icon)> Sections = new()
    {
        ["dashboard"] = ("Dashboard", "bi-grid-1x2-fill"), ["members"] = ("Members", "bi-people"), ["guarantors"] = ("Guarantors", "bi-shield-check"),
        ["contributions"] = ("Contributions", "bi-piggy-bank"), ["loans"] = ("Loans", "bi-cash-coin"), ["shares"] = ("Shares", "bi-graph-up-arrow"),
        ["dividends"] = ("Dividends", "bi-percent"), ["reports"] = ("Reports", "bi-bar-chart-line"), ["audit-trail"] = ("Audit trail", "bi-journal-text"),
        ["users"] = ("Users & roles", "bi-person-gear"), ["settings"] = ("Settings", "bi-sliders"), ["profile"] = ("My profile", "bi-person-circle"),
    };

    private void ComputeCrumbs()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/').ToLowerInvariant();
        var segs = path.Split('/', StringSplitOptions.RemoveEmptyEntries);
        CrumbParent = null;
        if (segs.Length == 0) { CrumbTitle = "Dashboard"; CrumbIcon = "bi-grid-1x2-fill"; return; }
        if (Sections.TryGetValue(segs[0], out var sec)) { CrumbTitle = sec.Title; CrumbIcon = sec.Icon; }
        else { CrumbTitle = Pretty(segs[0]); CrumbIcon = "bi-app"; }
        if (segs.Length > 1)
        {
            CrumbParent = CrumbTitle; CrumbParentHref = segs[0];
            var last = segs.Last();
            CrumbTitle = last.All(char.IsDigit) ? "Details" : Pretty(last);
        }
    }

    private static string Pretty(string s)
    {
        var t = s.Replace('-', ' ');
        return t.Length == 0 ? t : char.ToUpperInvariant(t[0]) + t[1..];
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Auth == null) return;
        var u = (await Auth).User;
        if (u.Identity?.IsAuthenticated != true) return;
        DisplayName = u.FindFirstValue(ClaimTypes.Name) ?? "User";
        FirstName = DisplayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? DisplayName;
        Email = u.FindFirstValue(ClaimTypes.Email) ?? "";
        Role = u.FindFirstValue(ClaimTypes.Role) ?? "";
        var parts = DisplayName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        Initials = parts.Length >= 2 ? $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant() : DisplayName[..Math.Min(2, DisplayName.Length)].ToUpperInvariant();
        PasswordExpired = u.HasClaim(AuthDefaults.PasswordExpiredClaim, "1");
        MustEnroll = u.HasClaim(AuthDefaults.EnrollClaim, "1");
        Denied = !Access.CanViewPage(Role, Navigation.ToBaseRelativePath(Navigation.Uri));
        CanSeeAudit = Access.CanViewPage(Role, "audit-trail");
        ComputeCrumbs();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await JS.InvokeVoidAsync("ms.afterShell");
    }

    private async Task Logout()
    {
        try { await JS.InvokeAsync<System.Text.Json.JsonElement>("ms.api", "POST", "/api/auth/logout", null); }
        catch { /* fall through to the login page regardless */ }
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}

@page "/"
@using Microsoft.AspNetCore.Components.Web
@namespace Sacco_Management_System.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@inject SaccoManagementSystem.Services.ConfigStore Cfg
@{ var org = Cfg.Current; }

<!DOCTYPE html>
<html lang="en" data-corners="@org.Corners" data-banners="@(org.PageBanners ? "on" : "off")" data-sidebar="@org.SidebarStyle" data-header="@org.HeaderStyle">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="@org.BrandColor" />
    <base href="~/" />

    <script>window.__msOrg = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { theme = org.DefaultTheme, density = org.Density, corners = org.Corners, banners = org.PageBanners, sidebar = org.SidebarStyle, header = org.HeaderStyle }));</script>
    <script>
        // Apply saved appearance before first paint (no flash of the wrong theme). Personal choice wins over the organisation default.
        (function () {
            try {
                var o = window.__msOrg || {};
                var p = JSON.parse(localStorage.getItem('ms.prefs') || '{}');
                var t = p.theme || o.theme || 'light';
                if (t === 'system') t = (window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light';
                var r = document.documentElement;
                r.setAttribute('data-theme', t);
                r.removeAttribute('data-accent');
                r.setAttribute('data-density', p.density || o.density || 'comfortable');
            } catch (e) { }
        })();
    </script>

    <link rel="preload" href="lib/fonts/plus-jakarta-sans-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link href="lib/fonts/fonts.css" rel="stylesheet" />
    <link rel="stylesheet" href="css/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="lib/bootstrap-icons/bootstrap-icons.css" />
    <link href="css/site.css" rel="stylesheet" />
    <link href="css/milestone.css" rel="stylesheet" />
    <link href="css/milestone.p2.css" rel="stylesheet" />
    <link href="css/milestone.p3.css" rel="stylesheet" />
    <link href="css/milestone.auth.css" rel="stylesheet" />
    <link href="css/milestone.v2.css" rel="stylesheet" />
    <link href="css/milestone.control.css" rel="stylesheet" />
    <link href="css/milestone.site.css" rel="stylesheet" />
    <style id="ms-brand">@Html.Raw(SaccoManagementSystem.Services.ConfigStore.ThemeCss(org))</style>
    <link href="Sacco Management System.styles.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="icon" href="@(string.IsNullOrEmpty(org.LogoDataUrl) ? "favicon.png" : "media/logo?v=" + Cfg.Ver)" />

    <component type="typeof(HeadOutlet)" render-mode="ServerPrerendered" />
</head>
<body>
    <component type="typeof(App)" render-mode="ServerPrerendered" />

    <div id="blazor-error-ui">
        <environment include="Staging,Production">
            An error has occurred. This application may no longer respond until reloaded.
        </environment>
        <environment include="Development">
            An unhandled exception has occurred. See browser dev tools for details.
        </environment>
        <a href="" class="reload">Reload</a>
        <a class="dismiss">🗙</a>
    </div>

    <script src="_framework/blazor.server.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="js/interop.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@2.9.4/dist/Chart.min.js"></script>
    <script src="_content/ChartJs.Blazor/ChartJsBlazorInterop.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <script src="js/milestone.js"></script>
</body>
</html>

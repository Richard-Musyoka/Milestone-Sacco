using System.Globalization;
using System.Text.Json;
using System.Text.RegularExpressions;
using Sacco_Management_System.Shared;
using SaccoManagementSystem.Security;

namespace SaccoManagementSystem.Services;

/// <summary>Everything about the look, feel and sign-in behaviour of the whole app that an administrator can change in Settings.</summary>
public sealed record OrgConfig
{
    // identity
    public string Name { get; set; } = "";
    public string Tagline { get; set; } = "";
    public string Email { get; set; } = "";
    public string Phone { get; set; } = "";
    public string Website { get; set; } = "";
    public string Address { get; set; } = "";
    public string PostalAddress { get; set; } = "";          // "P.O. Box 1234-00100, Nairobi"
    public string County { get; set; } = "Nairobi";
    public int? FoundedYear { get; set; }
    // branding
    public string LogoDataUrl { get; set; } = "";
    public string LoginImageDataUrl { get; set; } = "";
    public string BrandColor { get; set; } = "#0B7A52";
    // regional
    public string CurrencySymbol { get; set; } = "KSh";
    public string Locale { get; set; } = "en-KE";
    // appearance (organisation defaults; people can still pick their own theme)
    public string DefaultTheme { get; set; } = "light";      // light | dark | system
    public string Density { get; set; } = "comfortable";     // comfortable | compact
    public string Corners { get; set; } = "soft";            // sharp | rounded | soft
    public string SidebarStyle { get; set; } = "tint";       // tint | light | dark | brand
    public string HeaderStyle { get; set; } = "soft";        // soft | dark
    public bool PageBanners { get; set; } = true;
    // password rules
    public int PwMinLength { get; set; } = 8;
    public bool PwLower { get; set; } = true;
    public bool PwUpper { get; set; } = true;
    public bool PwNumber { get; set; } = true;
    public bool PwSymbol { get; set; } = false;
    // sign-in
    public bool? EmailOtpOnLogin { get; set; }               // null = follow appsettings.json
    public bool? AllowSelfRegistration { get; set; }         // null = follow appsettings.json
    public int LockMinutes { get; set; } = 15;
    public int TrustDays { get; set; } = 30;

    // ---- Kenya: registration and regulation
    public string SaccoType { get; set; } = "Non-withdrawable deposit-taking (NWDT)";
    public string CommonBond { get; set; } = "Community based";
    public string SasraLicenceNo { get; set; } = "";
    public string KraPin { get; set; } = "";
    public int AgmMonth { get; set; } = 4;
    public decimal StatutoryReservePct { get; set; } = 20;   // Co-operative Societies Act: at least 20% of surplus
    public decimal WhtDividendPct { get; set; } = 5;
    public decimal WhtInterestPct { get; set; } = 5;
    public decimal ExciseDutyPct { get; set; } = 20;         // on fees and commissions
    // ---- membership
    public string MemberNoPrefix { get; set; } = "M";
    public decimal EntranceFee { get; set; } = 1000;
    public decimal MinMonthlyDeposit { get; set; } = 1000;
    public decimal MinShareCapital { get; set; } = 5000;
    public int ShareCapitalMonths { get; set; } = 12;
    public decimal DepositInterestPct { get; set; } = 8;
    public int WithdrawalNoticeDays { get; set; } = 60;
    public int MinMemberAge { get; set; } = 18;
    public bool RequireKraPin { get; set; } = true;
    public bool RequireNextOfKin { get; set; } = true;
    public bool CheckOffEnabled { get; set; } = true;
    public bool AllowGroupAccounts { get; set; } = true;     // chamas, SHGs
    // ---- lending (Kenyan practice)
    public decimal LoanInsurancePct { get; set; } = 1;       // loan protection / risk fund
    public decimal OneThirdRulePct { get; set; } = 33.3m;    // net pay left after deductions
    public int TopUpAfterPct { get; set; } = 50;             // % repaid before a top-up
    public int GraceMonths { get; set; } = 1;
    public int CrbListingDays { get; set; } = 90;
    public List<LoanProduct> LoanProducts { get; set; } = LoanProduct.Defaults();
    // ---- payments
    public string MpesaPaybill { get; set; } = "";
    public string MpesaAccountRef { get; set; } = "Member number";
    public string MpesaTill { get; set; } = "";
    public string BankName { get; set; } = "";
    public string BankBranch { get; set; } = "";
    public string BankAccountName { get; set; } = "";
    public string BankAccountNo { get; set; } = "";

    // audit
    public DateTime? UpdatedUtc { get; set; }
    public string UpdatedBy { get; set; } = "";
}

public sealed class LoanProduct
{
    public string Name { get; set; } = "";
    public string Summary { get; set; } = "";
    public decimal RatePct { get; set; } = 12;               // per year
    public int MaxMonths { get; set; } = 12;
    public decimal Multiple { get; set; } = 3;               // times deposits (0 = not tied to deposits)
    public string Method { get; set; } = "Reducing balance"; // Reducing balance | Flat rate
    public string Icon { get; set; } = "bi-cash-coin";
    public bool OnWebsite { get; set; } = true;

    public static List<LoanProduct> Defaults() => new()
    {
        new() { Name = "Development loan", Summary = "For building, land, farming or long-term plans.", RatePct = 12, MaxMonths = 48, Multiple = 3, Icon = "bi-house-door" },
        new() { Name = "Emergency loan", Summary = "Fast help with medical bills and the unexpected.", RatePct = 12, MaxMonths = 12, Multiple = 1, Icon = "bi-heart-pulse" },
        new() { Name = "School fees loan", Summary = "Pay fees on time and repay across the term.", RatePct = 10, MaxMonths = 12, Multiple = 2, Icon = "bi-mortarboard" },
        new() { Name = "Biashara loan", Summary = "Stock, equipment and working capital for your business.", RatePct = 13, MaxMonths = 36, Multiple = 3, Icon = "bi-shop" },
        new() { Name = "Asset financing", Summary = "Motorbikes, vehicles and machinery.", RatePct = 14, MaxMonths = 36, Multiple = 0, Icon = "bi-truck" },
    };
}

public sealed class ConfigStore
{
    private sealed record Row(string Value, DateTime? When, string By);

    private static readonly Regex Hex = new("^#[0-9a-fA-F]{6}$", RegexOptions.Compiled);
    private static readonly Regex LogoRx = new(@"^data:image/(png|jpeg|jpg|webp|gif|svg\+xml);base64,[A-Za-z0-9+/=]+$", RegexOptions.Compiled);
    private static readonly Regex Digits = new("^[0-9]{5,7}$", RegexOptions.Compiled);
    private static readonly Regex Pin = new("^[AP][0-9]{9}[A-Z]$", RegexOptions.Compiled);
    private static readonly JsonSerializerOptions Json = new(JsonSerializerDefaults.Web);

    private readonly IDbFactory _db;
    private readonly ILogger<ConfigStore> _log;
    private OrgConfig _current = new();

    public ConfigStore(IDbFactory db, ILogger<ConfigStore> log) { _db = db; _log = log; Apply(_current); }

    public OrgConfig Current => _current;
    public event Action? Changed;

    public async Task EnsureSchemaAsync()
    {
        await using var c = await _db.OpenAsync();
        await c.ExecAsync(@"IF OBJECT_ID('dbo.SystemConfig') IS NULL
            CREATE TABLE dbo.SystemConfig ([Key] NVARCHAR(100) NOT NULL PRIMARY KEY, [Value] NVARCHAR(MAX) NOT NULL, UpdatedUtc DATETIME2 NOT NULL DEFAULT SYSUTCDATETIME(), UpdatedBy NVARCHAR(200) NULL)");
    }

    public async Task LoadAsync()
    {
        try
        {
            await EnsureSchemaAsync();
            await using var c = await _db.OpenAsync();
            var row = await c.FirstAsync("SELECT [Value], UpdatedUtc, UpdatedBy FROM dbo.SystemConfig WHERE [Key] = 'org'",
                r => new Row(r.Str("Value"), r.DateN("UpdatedUtc"), r.Str("UpdatedBy")));
            if (row != null)
            {
                var cfg = JsonSerializer.Deserialize<OrgConfig>(row.Value, Json) ?? new OrgConfig();
                cfg.UpdatedUtc = row.When; cfg.UpdatedBy = row.By ?? "";
                _current = cfg;
            }
        }
        catch (Exception ex) { _log.LogWarning(ex, "Could not load system configuration; using defaults."); }
        Apply(_current);
        Changed?.Invoke();
    }

    /// <summary>Validates, saves and applies. Returns the saved config or an error message.</summary>
    public async Task<(OrgConfig? Saved, string? Error)> SaveAsync(OrgConfig cfg, string? by)
    {
        var err = Validate(cfg);
        if (err != null) return (null, err);
        cfg.UpdatedUtc = DateTime.UtcNow; cfg.UpdatedBy = by ?? "";
        var json = JsonSerializer.Serialize(cfg, Json);
        await using var c = await _db.OpenAsync();
        await c.ExecAsync(@"MERGE dbo.SystemConfig AS t USING (SELECT 'org' AS [Key]) s ON t.[Key] = s.[Key]
            WHEN MATCHED THEN UPDATE SET [Value] = @v, UpdatedUtc = SYSUTCDATETIME(), UpdatedBy = @by
            WHEN NOT MATCHED THEN INSERT ([Key], [Value], UpdatedBy) VALUES ('org', @v, @by);", ("v", json), ("by", by ?? ""));
        _current = cfg;
        Apply(cfg);
        Changed?.Invoke();
        return (cfg, null);
    }

    public static string? Validate(OrgConfig c)
    {
        c.Name = (c.Name ?? "").Trim(); c.Tagline = (c.Tagline ?? "").Trim(); c.Email = (c.Email ?? "").Trim();
        c.Phone = (c.Phone ?? "").Trim(); c.Website = (c.Website ?? "").Trim(); c.Address = (c.Address ?? "").Trim();
        if (c.Name.Length == 0) return "Organisation name is required.";
        if (c.Name.Length > 80 || c.Tagline.Length > 120 || c.Email.Length > 200 || c.Phone.Length > 40 || c.Website.Length > 200 || c.Address.Length > 400) return "One of the text fields is too long.";
        if (!Hex.IsMatch(c.BrandColor ?? "")) return "Brand colour must look like #0B7A52.";
        if (!string.IsNullOrEmpty(c.LogoDataUrl) && (c.LogoDataUrl.Length > 900_000 || !LogoRx.IsMatch(c.LogoDataUrl))) return "The logo must be a PNG, JPG, WebP, GIF or SVG under 600 KB.";
        if (string.IsNullOrWhiteSpace(c.CurrencySymbol) || c.CurrencySymbol.Length > 8) return "Currency symbol is required (up to 8 characters).";
        try { CultureInfo.GetCultureInfo(c.Locale); } catch { return "That number and date format isn't supported."; }
        if (c.DefaultTheme is not ("light" or "dark" or "system")) return "Unknown theme.";
        if (c.Density is not ("comfortable" or "compact")) return "Unknown density.";
        if (c.Corners is not ("sharp" or "rounded" or "soft")) return "Unknown corner style.";
        if (c.SidebarStyle is not ("tint" or "dark" or "light" or "brand")) return "Unknown sidebar style.";
        if (c.HeaderStyle is not ("soft" or "dark")) return "Unknown header style.";
        if (!string.IsNullOrEmpty(c.LoginImageDataUrl) && (c.LoginImageDataUrl.Length > 2_100_000 || !LogoRx.IsMatch(c.LoginImageDataUrl))) return "The sign-in image must be a PNG, JPG, WebP or GIF under 1.5 MB.";
        c.MpesaPaybill = (c.MpesaPaybill ?? "").Trim(); c.MpesaTill = (c.MpesaTill ?? "").Trim(); c.KraPin = (c.KraPin ?? "").Trim().ToUpperInvariant();
        if (c.MpesaPaybill.Length > 0 && !Digits.IsMatch(c.MpesaPaybill)) return "M-Pesa Paybill must be 5 to 7 digits.";
        if (c.MpesaTill.Length > 0 && !Digits.IsMatch(c.MpesaTill)) return "M-Pesa Till must be 5 to 7 digits.";
        if (c.KraPin.Length > 0 && !Pin.IsMatch(c.KraPin)) return "KRA PIN looks wrong. It is 11 characters, like P051234567X.";
        foreach (var pct in new[] { c.StatutoryReservePct, c.WhtDividendPct, c.WhtInterestPct, c.ExciseDutyPct, c.DepositInterestPct, c.LoanInsurancePct, c.OneThirdRulePct })
            if (pct is < 0 or > 100) return "Percentages must be between 0 and 100.";
        if (c.EntranceFee < 0 || c.MinMonthlyDeposit < 0 || c.MinShareCapital < 0) return "Fees and minimum amounts can't be negative.";
        if (c.AgmMonth is < 1 or > 12) return "Pick the month the AGM is usually held.";
        if (c.ShareCapitalMonths is < 0 or > 120 || c.WithdrawalNoticeDays is < 0 or > 365 || c.MinMemberAge is < 0 or > 30) return "One of the membership numbers is out of range.";
        if (c.TopUpAfterPct is < 0 or > 100 || c.GraceMonths is < 0 or > 24 || c.CrbListingDays is < 0 or > 365) return "One of the lending numbers is out of range.";
        c.LoanProducts ??= new();
        if (c.LoanProducts.Count > 20) return "Up to 20 loan products.";
        foreach (var lp in c.LoanProducts)
        {
            lp.Name = (lp.Name ?? "").Trim(); lp.Summary = (lp.Summary ?? "").Trim();
            if (lp.Name.Length == 0) return "Every loan product needs a name.";
            if (lp.Name.Length > 60 || lp.Summary.Length > 200) return "A loan product name or summary is too long.";
            if (lp.RatePct is < 0 or > 100 || lp.MaxMonths is < 1 or > 120 || lp.Multiple is < 0 or > 10) return "Check the numbers on " + lp.Name + ".";
            if (lp.Method is not ("Reducing balance" or "Flat rate")) lp.Method = "Reducing balance";
            if (string.IsNullOrWhiteSpace(lp.Icon) || !lp.Icon.StartsWith("bi-")) lp.Icon = "bi-cash-coin";
        }
        if (c.PwMinLength is < 6 or > 64) return "Minimum password length must be between 6 and 64.";
        if (c.LockMinutes is < 1 or > 1440) return "Lock time must be between 1 and 1,440 minutes.";
        if (c.TrustDays is < 0 or > 90) return "Trusted-device days must be between 0 and 90.";
        c.BrandColor = c.BrandColor!.ToUpperInvariant();
        return null;
    }

    private static void Apply(OrgConfig c)
    {
        if (!string.IsNullOrWhiteSpace(c.Name)) Brand.Name = c.Name;
        if (!string.IsNullOrWhiteSpace(c.Tagline)) Brand.Tagline = c.Tagline;
        PasswordHasher.Custom = new PasswordHasher.Rules(c.PwMinLength, c.PwLower, c.PwUpper, c.PwNumber, c.PwSymbol);
    }

    // ------------------------------------------------------------ presentation helpers
    public static string ThemeCss(OrgConfig c)
    {
        var hex = Hex.IsMatch(c.BrandColor ?? "") ? c.BrandColor! : "#0B7A52";
        var ink = Contrast(hex, "#FFFFFF") >= 4.5 ? "#FFFFFF" : "#0B1220";
        return ":root{--ms-accent:" + hex + ";--ms-accent-600:color-mix(in srgb," + hex + " 84%,#000);--ms-accent-soft:color-mix(in srgb," + hex + " 13%,#fff);--ms-accent-ink:" + ink + ";--ms-brand:" + hex + ";}" +
               "[data-theme=\"dark\"]{--ms-accent:color-mix(in srgb," + hex + " 70%,#fff);--ms-accent-600:color-mix(in srgb," + hex + " 55%,#fff);--ms-accent-soft:color-mix(in srgb," + hex + " 24%,transparent);--ms-accent-ink:#06101F;}";
    }

    public static double Contrast(string a, string b)
    {
        static double Lum(string h)
        {
            double Ch(int v) { var s = v / 255.0; return s <= 0.03928 ? s / 12.92 : Math.Pow((s + 0.055) / 1.055, 2.4); }
            var r = Convert.ToInt32(h.Substring(1, 2), 16); var g = Convert.ToInt32(h.Substring(3, 2), 16); var bl = Convert.ToInt32(h.Substring(5, 2), 16);
            return 0.2126 * Ch(r) + 0.7152 * Ch(g) + 0.0722 * Ch(bl);
        }
        var l1 = Lum(a); var l2 = Lum(b);
        return (Math.Max(l1, l2) + 0.05) / (Math.Min(l1, l2) + 0.05);
    }

    /// <summary>Cache-busting token for images served from /media.</summary>
    public string Ver => (_current.UpdatedUtc?.Ticks ?? 0).ToString();

    public CultureInfo Culture
    {
        get { try { return CultureInfo.GetCultureInfo(_current.Locale); } catch { return CultureInfo.InvariantCulture; } }
    }

    /// <summary>"KSh 125,000.00" using the organisation's symbol and number format.</summary>
    public string Money(decimal v, int decimals = 2) => _current.CurrencySymbol + " " + v.ToString("N" + decimals, Culture);
}

@using System.Security.Claims
@using SaccoManagementSystem.Security
@implements IDisposable
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthState

@if (open)
{
    <div class="ms-drawer-bg @(closing ? "out" : "")" @onclick="Close"></div>
    <aside class="ms-drawer @def!.Size @(closing ? "out" : "")" role="dialog" aria-modal="true" aria-label="@def.Title" @key="openId">
        <header class="ms-drawer-head">
            <span class="ms-hub-ico" style="@def.Style"><i class="bi @def.Icon"></i></span>
            <div class="ms-drawer-title"><h3>@def.Title</h3><p>@def.Subtitle</p></div>
            <button type="button" class="ms-icon-btn" @onclick="Close" aria-label="Close"><i class="bi bi-x-lg"></i></button>
        </header>
        <div class="ms-drawer-body ms-body">
            <CascadingValue Value="ctx" IsFixed="true">
                <DynamicComponent Type="def.Type" Parameters="parms" />
            </CascadingValue>
        </div>
    </aside>
}

@code {
    [Parameter] public EventCallback OnSaved { get; set; }

    private sealed record Def(string Route, Type Type, string Title, string Subtitle, string Icon, string Size, string C1, string C2)
    {
        public string Style => "--c1:" + C1 + ";--c2:" + C2;
    }

    private static readonly Def[] Defs =
    {
        new("members/add-member", typeof(global::Sacco_Management_System.Pages.Members.AddMember), "Add a member", "Create a new member profile. You can edit it any time.", "bi-person-plus-fill", "mid", "#14a173", "#0B7A52"),
        new("contributions/add", typeof(global::Sacco_Management_System.Pages.Contributions.AddContribution), "Record a contribution", "Log a payment made by a member.", "bi-piggy-bank-fill", "", "#2559C7", "#1b3f94"),
        new("loans/apply", typeof(global::Sacco_Management_System.Pages.Loans.ApplyLoan), "New loan application", "Member, terms and guarantors. Approval happens afterwards.", "bi-cash-coin", "wide", "#D4A62A", "#a67c12"),
        new("shares/purchase", typeof(global::Sacco_Management_System.Pages.Shares.PurchaseShares), "Purchase shares", "Record a share purchase for a member.", "bi-graph-up-arrow", "", "#0ea5b7", "#0b7285"),
        new("guarantors/add", typeof(global::Sacco_Management_System.Pages.Guarantors.AddGuarantor), "Add a guarantor", "Someone who can stand behind a member's loan.", "bi-shield-plus", "", "#8b5cf6", "#5b34c9"),
        new("dividends/declare", typeof(global::Sacco_Management_System.Pages.Dividends.DividendsDeclaration), "Declare a dividend", "Set the rate and dates, review the impact, then confirm.", "bi-percent", "mid", "#ec4899", "#b8236b"),
    };

    private bool open, closing;
    private int openId;
    private Def? def;
    private Dictionary<string, object?>? parms;
    private DrawerContext ctx = default!;
    private DotNetObjectReference<DrawerHost>? self;

    protected override void OnInitialized()
    {
        ctx = new DrawerContext { Close = () => Close(), Saved = () => SavedAsync() };
        Nav.LocationChanged += OnLocation;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        self = DotNetObjectReference.Create(this);
        try { await JS.InvokeVoidAsync("ms.drawer.init", self); } catch { /* prerender / disconnected */ }
    }

    /// <summary>Called from JS when a link to an "add" page is clicked. Returns false when the link should navigate normally.</summary>
    [JSInvokable]
    public async Task<bool> TryOpen(string path)
    {
        var p = (path ?? "").Split('?', '#')[0].Trim('/');
        Def? hit = null; string? id = null;
        foreach (var d in Defs)
        {
            if (string.Equals(p, d.Route, StringComparison.OrdinalIgnoreCase)) { hit = d; break; }
            if (d.Route == "shares/purchase" && p.StartsWith("shares/purchase/", StringComparison.OrdinalIgnoreCase)) { hit = d; id = p.Substring("shares/purchase/".Length); break; }
        }
        if (hit == null) return false;

        var state = await AuthState.GetAuthenticationStateAsync();
        var role = state.User.FindFirstValue(ClaimTypes.Role) ?? "";
        if (!Access.CanViewPage(role, hit.Route))
        {
            await JS.InvokeVoidAsync("ms.toast", "warning", "Not available for your role", "Ask an administrator if you need this.");
            return true;
        }

        def = hit;
        parms = id != null ? new Dictionary<string, object?> { ["MemberId"] = id } : null;
        closing = false; open = true; openId++;
        await InvokeAsync(StateHasChanged);
        await JS.InvokeVoidAsync("ms.drawer.opened", true);
        return true;
    }

    [JSInvokable] public Task CloseFromJs() => Close();

    private async Task Close()
    {
        if (!open || closing) return;
        closing = true;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(280);
        open = false; closing = false;
        try { await JS.InvokeVoidAsync("ms.drawer.opened", false); } catch { }
        await InvokeAsync(StateHasChanged);
    }

    private async Task SavedAsync()
    {
        await Close();
        await OnSaved.InvokeAsync();
    }

    private void OnLocation(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (open) { open = false; closing = false; _ = InvokeAsync(StateHasChanged); }
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocation;
        self?.Dispose();
    }
}

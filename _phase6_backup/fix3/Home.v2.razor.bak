@page "/"
@inject ConfigStore Cfg
@inject SiteStore Site

<PageTitle>@Brand.Name · @Brand.Tagline</PageTitle>
<HeadContent><meta name="description" content="@S.HeroText" /></HeadContent>

<section class="ws-hero">
    <div class="ws-wrap">
        <div class="ws-hero-grid">
            <div class="ws-reveal">
                <span class="ws-kicker"><i class="bi bi-sun"></i> @S.HeroKicker</span>
                <h1>@Lead<span class="ws-ul">@LastWord<svg viewBox="0 0 220 18" preserveAspectRatio="none" aria-hidden="true"><path d="M3 12 C 60 3, 140 3, 217 10" /></svg></span></h1>
                <p class="lead">@S.HeroText</p>
                <div class="ws-hero-actions">
                    <a class="ws-btn primary lg" href="membership#join">Become a member <i class="bi bi-arrow-right"></i></a>
                    <a class="ws-btn lg" href="products#calculator"><i class="bi bi-calculator"></i> What could I borrow?</a>
                </div>
                <div class="ws-trust">
                    @if (!string.IsNullOrWhiteSpace(C.MpesaPaybill))
                    {
                        <div class="ws-paybill">
                            <span class="ic"><i class="bi bi-phone"></i></span>
                            <div><small>M-Pesa Paybill</small><b>@C.MpesaPaybill</b></div>
                            <div style="padding-left:12px;border-left:1px solid var(--ms-border)"><small>Account</small><b style="font-size:14px;letter-spacing:0">Your @C.MpesaAccountRef.ToLowerInvariant()</b></div>
                        </div>
                    }
                    <p class="ws-reg"><i class="bi bi-patch-check-fill"></i> Registered under the Co-operative Societies Act@(string.IsNullOrWhiteSpace(C.SasraLicenceNo) ? "" : " · SASRA " + C.SasraLicenceNo)</p>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(S.HeroImage))
            {
                <div class="ws-hero-art ws-reveal">
                    <img src="@("media/hero?v=" + Site.Ver)" alt="@Brand.Name members" />
                    @if (Top != null)
                    {
                        <div class="ws-float a"><i class="bi @Top.Icon"></i><div>@Top.Name<small>@Top.RatePct.ToString("0.#")% a year · up to @Top.MaxMonths months</small></div></div>
                    }
                </div>
            }
            else
            {
                <div class="ws-reveal"><RateBoard Loans="Loans" Dividend="rules.DividendRate" Paybill="@C.MpesaPaybill" Hours="@S.OfficeHours" /></div>
            }
        </div>

        @if (S.ShowStats && Stats.Count > 0)
        {
            <div class="ws-stats">@foreach (var st in Stats) { <div class="ws-stat"><b>@st.Value</b><span>@st.Label</span></div> }</div>
        }
    </div>
</section>

<section class="ws-sec alt">
    <div class="ws-wrap">
        <div class="ws-head"><span class="ws-eyebrow">How it works</span><h2>Your first year with us</h2><p>No surprises. These are the real rules members agreed on.</p></div>
        <FirstYear Cfg="C" Rules="rules" />
    </div>
</section>

<section class="ws-sec">
    <div class="ws-wrap">
        <div class="ws-head"><span class="ws-eyebrow">Why members stay</span><h2>Four things people tell us they like</h2></div>
        <div class="ws-why">
            @for (var i = 0; i < S.Why.Count; i++)
            {
                var w = S.Why[i];
                <div class="ws-why-item"><span class="num">@((i + 1).ToString("00"))</span><div><h3><i class="bi @w.Icon"></i> @w.Title</h3><p>@w.Text</p></div></div>
            }
        </div>
    </div>
</section>

@if (Loans.Count > 0)
{
    <section class="ws-sec brand">
        <div class="ws-wrap">
            <div class="ws-head"><span class="ws-eyebrow">Loans</span><h2>Borrow for the things that matter</h2><p>Rates are set by members, not shareholders. Most loans are up to @rules.MaxMultiple× your deposits.</p></div>
            <div class="ws-grid three">
                @foreach (var p in Loans.Take(6))
                {
                    <div class="ws-card">
                        <div class="rate"><b>@p.RatePct.ToString("0.#")%</b><small>a year</small></div>
                        <div class="ic"><i class="bi @p.Icon"></i></div>
                        <h3>@p.Name</h3>
                        <p>@p.Summary</p>
                        <div class="facts"><span>Up to @p.MaxMonths months</span>@if (p.Multiple > 0) { <span>@p.Multiple.ToString("0.#")× deposits</span> }</div>
                    </div>
                }
            </div>
            <div style="margin-top:22px"><a class="ws-btn" href="products">See every product and the calculator <i class="bi bi-arrow-right"></i></a></div>
        </div>
    </section>
}

<section class="ws-sec">
    <div class="ws-wrap">
        <div class="ws-head"><span class="ws-eyebrow">Plan it</span><h2>See how small savings add up</h2><p>Move the sliders. Everything is worked out from our current rates.</p></div>
        <SavingsCalculator Cfg="C" Multiple="rules.MaxMultiple" />
    </div>
</section>

@if (S.Journey.Count > 0)
{
    <section class="ws-sec alt">
        <div class="ws-wrap">
            <div class="ws-head"><span class="ws-eyebrow">Our journey</span><h2>From a notebook to a co-operative</h2></div>
            <div class="ws-journey">
                @foreach (var m in S.Journey) { <div class="ws-mile"><span class="yr">@m.Year</span><b>@m.Title</b><p>@m.Text</p></div> }
            </div>
            <div style="margin-top:22px"><a class="ws-btn" href="about">Read our story <i class="bi bi-arrow-right"></i></a></div>
        </div>
    </section>
}

@if (S.Voices.Count > 0)
{
    <section class="ws-sec">
        <div class="ws-wrap">
            <div class="ws-head"><span class="ws-eyebrow">In their words</span><h2>Members on Tajiri</h2></div>
            <div class="ws-voices">
                @foreach (var v in S.Voices) { <figure class="ws-voice"><blockquote>@v.Quote</blockquote><figcaption><span class="av">@Ini(v.Name)</span><b>@v.Name</b><small>@v.Role</small></figcaption></figure> }
            </div>
        </div>
    </section>
}

@if (!string.IsNullOrWhiteSpace(S.ChairNote))
{
    <section class="ws-sec">
        <div class="ws-wrap">
            <div class="ws-letter">
                <i class="bi bi-quote"></i>
                <p>@S.ChairNote</p>
                <div class="sig"><b>@(string.IsNullOrWhiteSpace(S.ChairName) ? "The Chairperson" : S.ChairName)</b><small>@(string.IsNullOrWhiteSpace(S.ChairName) ? "On behalf of the board" : "Chairperson, on behalf of the board")</small></div>
            </div>
        </div>
    </section>
}

@if (LatestNews.Count > 0)
{
    <section class="ws-sec">
        <div class="ws-wrap">
            <div class="ws-head"><span class="ws-eyebrow">Notice board</span><h2>What's happening</h2></div>
            <div class="ws-news">
                @foreach (var n in LatestNews)
                {
                    <a class="ws-card" href="@("news/" + n.Id)"><time>@n.Date.ToString("d MMM yyyy")</time><h3>@n.Title</h3><p>@n.Summary</p><span class="more">Read more <i class="bi bi-arrow-right"></i></span></a>
                }
            </div>
        </div>
    </section>
}

<section class="ws-sec">
    <div class="ws-wrap">
        <div class="ws-cta-band">
            <div><h2>Come and see us</h2><p>Talk to our member services team or visit @(string.IsNullOrWhiteSpace(C.Address) ? "our office" : C.Address). Karibu.</p></div>
            <div class="actions">
                <a class="ws-btn gold lg" href="membership#join">Become a member</a>
                <a class="ws-btn lg" href="contact">Find us</a>
            </div>
        </div>
    </div>
</section>

@code {
    private SiteContent S => Site.Current;
    private OrgConfig C => Cfg.Current;
    private SiteStore.Rules rules = new(6, 3, 100, 5, 12, 2);
    private List<LoanProduct> Loans => C.LoanProducts.Where(p => p.OnWebsite).ToList();
    private LoanProduct? Top => Loans.FirstOrDefault();
    private List<SiteContent.NewsItem> LatestNews => S.News.Where(n => n.Published).OrderByDescending(n => n.Date).Take(3).ToList();
    private List<SiteContent.Stat> Stats = new();
    private string Lead { get { var t = (S.HeroTitle ?? "").TrimEnd(); var i = t.LastIndexOf(' '); return i < 0 ? "" : t[..(i + 1)]; } }
    private string LastWord { get { var t = (S.HeroTitle ?? "").TrimEnd(); var i = t.LastIndexOf(' '); return i < 0 ? t : t[(i + 1)..]; } }
    private static string Ini(string n) { var p = n.Split(' ', StringSplitOptions.RemoveEmptyEntries); return p.Length == 0 ? "?" : (p[0][..1] + (p.Length > 1 ? p[^1][..1] : "")).ToUpperInvariant(); }

    protected override async Task OnInitializedAsync()
    {
        rules = await Site.RulesAsync();
        var tokens = await Site.LiveTokensAsync(C);
        Stats = S.Stats.Select(s => new SiteContent.Stat { Label = s.Label, Value = tokens.Aggregate(s.Value ?? "", (acc, kv) => acc.Replace(kv.Key, kv.Value)) })
                       .Where(s => !string.IsNullOrWhiteSpace(s.Value)).ToList();
    }
}

/* =====================================================================
   Sign-in page (v3), brand illustration, and the public SACCO website.
   Solid colours only. Loaded last.
   ===================================================================== */

/* ------------------------------------------------------------ illustration */
.sa-art { display: block; width: 100%; height: 100%; }
.sa-sky { fill: color-mix(in srgb, var(--ms-accent) 10%, #fff); }
.sa-sun { fill: #F4C95D; }
.sa-sun2 { fill: #F4C95D; opacity: .18; }
.sa-birds path { fill: none; stroke: #0B1F3A; stroke-width: 3; stroke-linecap: round; opacity: .55; }
.sa-hill3 { fill: color-mix(in srgb, var(--ms-accent) 30%, #fff); }
.sa-hill2 { fill: color-mix(in srgb, var(--ms-accent) 55%, #fff); }
.sa-hill1 { fill: var(--ms-accent); }
.sa-tree path { fill: none; stroke: #3b2a1a; stroke-width: 7; stroke-linecap: round; stroke-linejoin: round; }
.sa-tree ellipse { fill: color-mix(in srgb, var(--ms-accent) 75%, #0B1F3A); }
.sa-wall { fill: #fff; }
.sa-roof { fill: #0B1F3A; }
.sa-sign { fill: var(--ms-accent); }
.sa-door { fill: color-mix(in srgb, var(--ms-accent) 70%, #0B1F3A); }
.sa-win { fill: color-mix(in srgb, var(--ms-accent) 18%, #fff); stroke: color-mix(in srgb, var(--ms-accent) 40%, #fff); stroke-width: 3; }
.sa-coin-ico { fill: #F4C95D; }
.sa-bars rect { fill: #F4C95D; }
.sa-bars rect:nth-child(odd) { fill: #E3B341; }
.sa-arrow { fill: none; stroke: #0B1F3A; stroke-width: 5; stroke-linecap: round; stroke-linejoin: round; }
.sa-arrow-head { fill: #0B1F3A; }
.sa-people .p1 * { fill: #0B1F3A; } .sa-people .p2 * { fill: #C2540A; } .sa-people .p3 * { fill: #2559C7; }
.sa-coins ellipse { fill: #F4C95D; stroke: #C99A2E; stroke-width: 2; }
[data-theme="dark"] .sa-sky { fill: color-mix(in srgb, var(--ms-accent) 14%, #0A1424); }
[data-theme="dark"] .sa-wall { fill: #e7edf6; }
@media (prefers-reduced-motion: no-preference) {
  .sa-sun2 { animation: sa-pulse 6s ease-in-out infinite; transform-origin: 620px 150px; }
  .sa-birds { animation: sa-drift 14s ease-in-out infinite alternate; }
  .sa-bars rect { animation: sa-grow 1.2s var(--ms-ease, ease) both; transform-box: fill-box; transform-origin: bottom; }
  .sa-bars rect:nth-child(2) { animation-delay: .15s } .sa-bars rect:nth-child(3) { animation-delay: .3s } .sa-bars rect:nth-child(4) { animation-delay: .45s }
}
@keyframes sa-pulse { 50% { transform: scale(1.12); } }
@keyframes sa-drift { to { transform: translateX(40px); } }
@keyframes sa-grow { from { transform: scaleY(0); } }

/* ---------------------------------------------------------------- sign-in */
.au.lg { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); padding: 16px; gap: 16px; background: var(--ms-bg); }
.lg-art { position: relative; overflow: hidden; border-radius: 28px; min-height: calc(100vh - 32px); background: color-mix(in srgb, var(--ms-accent) 10%, #fff); isolation: isolate; }
.lg-photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
.lg-shade { position: absolute; inset: auto 0 0 0; height: 55%; background: rgba(7, 18, 36, .0); z-index: -1; }
img.lg-photo ~ .lg-shade { background: rgba(7, 18, 36, .38); height: 100%; }
.lg-brand { position: absolute; top: 24px; left: 24px; display: flex; align-items: center; gap: 12px; padding: 8px 16px 8px 8px; border-radius: 18px; background: rgba(255,255,255,.88); backdrop-filter: blur(12px); color: #0B1F3A; box-shadow: 0 8px 24px rgba(7,18,36,.12); }
.lg-brand .au-mark { width: 42px; height: 42px; border-radius: 13px; background: var(--ms-accent); color: var(--ms-accent-ink); font-size: 20px; box-shadow: none; }
.lg-brand .au-mark.logo { background: #fff; padding: 4px; }
.lg-brand b { display: block; font-size: 15.5px; } .lg-brand small { color: #5b6b82; font-weight: 700; font-size: 12px; }
.lg-caption { position: absolute; left: 24px; right: 24px; bottom: 24px; padding: 26px 28px; border-radius: 24px; background: rgba(255,255,255,.9); backdrop-filter: blur(16px); color: #0B1F3A; box-shadow: 0 18px 40px rgba(7,18,36,.16); max-width: 620px; animation: au-rise .6s both; }
.lg-kicker { display: inline-flex; align-items: center; gap: 8px; font-size: 11.5px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: var(--ms-accent); }
.lg-caption h1 { margin: 8px 0 8px; font-size: clamp(26px, 2.6vw, 38px); font-weight: 800; letter-spacing: -.03em; line-height: 1.12; }
.lg-caption p { margin: 0 0 16px; color: #4a5a70; font-size: 14.5px; line-height: 1.55; max-width: 520px; }
.lg-chips { display: flex; gap: 8px; flex-wrap: wrap; }
.lg-chips span { display: inline-flex; align-items: center; gap: 7px; padding: 7px 12px; border-radius: 99px; background: color-mix(in srgb, var(--ms-accent) 10%, #fff); color: #0B1F3A; font-size: 12.5px; font-weight: 700; }
.lg-chips i { color: var(--ms-accent); }
[data-theme="dark"] .lg-brand, [data-theme="dark"] .lg-caption { background: rgba(13,26,48,.88); color: #e7edf6; }
[data-theme="dark"] .lg-caption p, [data-theme="dark"] .lg-brand small { color: #a9b7cc; }
[data-theme="dark"] .lg-chips span { background: rgba(255,255,255,.08); color: #e7edf6; }

.lg-side { display: flex; flex-direction: column; padding: 10px 28px 18px; min-width: 0; }
.lg-top { display: flex; justify-content: space-between; align-items: center; gap: 10px; }
.lg-back { display: inline-flex; align-items: center; gap: 8px; padding: 9px 14px; border-radius: 12px; color: var(--ms-text-2); font-weight: 700; font-size: 13.5px; text-decoration: none; transition: background .2s; }
.lg-back:hover { background: var(--ms-surface); color: var(--ms-text); }
.lg-side .au-card { max-width: 420px; }
.lg-side .au-card h2 { font-size: 30px; }
.lg-hello { display: inline-block; margin-bottom: 6px; padding: 6px 12px; border-radius: 99px; background: var(--ms-accent-soft); color: var(--ms-accent); font-size: 12.5px; font-weight: 800; }
.lg .au-in input { background: var(--ms-surface); }
@media (max-width: 992px) {
  .au.lg { grid-template-columns: 1fr; padding: 0; }
  .lg-art { display: none; }
  .lg-side { padding: 14px 18px 22px; }
}

/* =====================================================================
   Public website
   ===================================================================== */
.ws { --ws-max: 1180px; background: var(--ms-bg); color: var(--ms-text); font-family: var(--ms-font); min-height: 100vh; display: flex; flex-direction: column; }
.ws * { box-sizing: border-box; }
.ws a { color: inherit; }
.ws-wrap { width: 100%; max-width: var(--ws-max); margin: 0 auto; padding: 0 20px; }
.ws-ann { background: #0B1F3A; color: #fff; font-size: 13.5px; font-weight: 600; text-align: center; padding: 9px 16px; }
.ws-ann a { color: #F4C95D; font-weight: 800; margin-left: 8px; }
.ws-top { position: sticky; top: 0; z-index: 50; background: rgba(255,255,255,.9); backdrop-filter: blur(14px); border-bottom: 1px solid var(--ms-border); }
[data-theme="dark"] .ws-top { background: rgba(10,20,36,.88); }
.ws-nav { display: flex; align-items: center; gap: 20px; height: 72px; }
.ws-logo { display: flex; align-items: center; gap: 10px; text-decoration: none; font-weight: 800; font-size: 17px; letter-spacing: -.01em; }
.ws-logo span.mk { width: 40px; height: 40px; border-radius: 12px; display: grid; place-items: center; background: var(--ms-accent); color: var(--ms-accent-ink); font-size: 19px; overflow: hidden; flex: none; }
.ws-logo span.mk.img { background: #fff; border: 1px solid var(--ms-border); padding: 3px; }
.ws-logo span.mk img { width: 100%; height: 100%; object-fit: contain; }
.ws-logo small { display: block; font-size: 11.5px; font-weight: 600; color: var(--ms-text-3); }
.ws-links { display: flex; gap: 4px; margin-left: auto; }
.ws-links a { text-decoration: none; padding: 9px 13px; border-radius: 11px; font-weight: 700; font-size: 14px; color: var(--ms-text-2); transition: background .2s, color .2s; }
.ws-links a:hover { background: var(--ms-accent-soft); color: var(--ms-accent); }
.ws-links a.active { color: var(--ms-accent); background: var(--ms-accent-soft); }
.ws-cta { display: flex; gap: 8px; }
.ws-btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; height: 44px; padding: 0 20px; border-radius: 13px; font: inherit; font-weight: 800; font-size: 14.5px; text-decoration: none; border: 1.5px solid var(--ms-border-strong, #cbd5e1); background: var(--ms-surface); color: var(--ms-text); cursor: pointer; transition: transform .2s var(--ms-ease, ease), background .2s, box-shadow .2s; white-space: nowrap; }
.ws-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(15,23,42,.08); }
.ws-btn.primary { background: var(--ms-accent); border-color: var(--ms-accent); color: var(--ms-accent-ink); }
.ws-btn.primary:hover { background: var(--ms-accent-600); }
.ws-btn.gold { background: #F4C95D; border-color: #F4C95D; color: #1f1604; }
.ws-btn.ghost { background: transparent; }
.ws-btn.lg { height: 52px; padding: 0 26px; font-size: 15.5px; border-radius: 15px; }
.ws-menu { display: none; margin-left: auto; width: 44px; height: 44px; border-radius: 12px; border: 1px solid var(--ms-border); background: var(--ms-surface); font-size: 20px; color: var(--ms-text); }
.ws-mobile { display: none; }

.ws-hero { padding: 56px 0 40px; }
.ws-hero-grid { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 44px; align-items: center; }
.ws-kicker { display: inline-flex; align-items: center; gap: 8px; padding: 7px 14px; border-radius: 99px; background: var(--ms-accent-soft); color: var(--ms-accent); font-size: 12.5px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; }
.ws-hero h1 { font-size: clamp(34px, 4.6vw, 58px); line-height: 1.05; letter-spacing: -.035em; font-weight: 800; margin: 18px 0 16px; }
.ws-hero h1 em { font-style: normal; color: var(--ms-accent); }
.ws-hero p.lead { font-size: 18px; line-height: 1.6; color: var(--ms-text-2); margin: 0 0 26px; max-width: 560px; }
.ws-hero-actions { display: flex; gap: 12px; flex-wrap: wrap; }
.ws-paybill { display: inline-flex; align-items: center; gap: 12px; margin-top: 26px; padding: 12px 18px 12px 12px; border-radius: 16px; background: var(--ms-surface); border: 1px solid var(--ms-border); }
.ws-paybill .ic { width: 42px; height: 42px; border-radius: 12px; background: #16a34a; color: #fff; display: grid; place-items: center; font-size: 20px; }
.ws-paybill small { display: block; color: var(--ms-text-3); font-weight: 700; font-size: 12px; }
.ws-paybill b { font-size: 18px; letter-spacing: .04em; }
.ws-hero-art { position: relative; aspect-ratio: 4 / 3.3; border-radius: 30px; overflow: hidden; background: color-mix(in srgb, var(--ms-accent) 10%, #fff); box-shadow: 0 30px 60px rgba(15,23,42,.12); }
.ws-hero-art img, .ws-hero-art svg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
.ws-float { position: absolute; display: flex; align-items: center; gap: 10px; padding: 10px 14px; border-radius: 16px; background: rgba(255,255,255,.94); color: #0B1F3A; box-shadow: 0 12px 30px rgba(15,23,42,.14); font-size: 13px; font-weight: 700; animation: ms-float 6s ease-in-out infinite; }
.ws-float i { width: 34px; height: 34px; border-radius: 10px; display: grid; place-items: center; background: var(--ms-accent); color: var(--ms-accent-ink); font-size: 16px; }
.ws-float small { display: block; color: #5b6b82; font-weight: 600; font-size: 11.5px; }
.ws-float.a { left: 18px; top: 18px; } .ws-float.b { right: 18px; bottom: 18px; animation-delay: -3s; }
.ws-float.b i { background: #F4C95D; color: #1f1604; }

.ws-stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; margin-top: 40px; }
.ws-stat { padding: 20px 22px; border-radius: 20px; background: var(--ms-surface); border: 1px solid var(--ms-border); }
.ws-stat b { display: block; font-size: 32px; font-weight: 800; letter-spacing: -.03em; color: var(--ms-accent); font-variant-numeric: tabular-nums; }
.ws-stat span { color: var(--ms-text-3); font-weight: 700; font-size: 13.5px; }

.ws-sec { padding: 64px 0; }
.ws-sec.alt { background: var(--ms-surface); border-top: 1px solid var(--ms-border); border-bottom: 1px solid var(--ms-border); }
.ws-sec.brand { background: color-mix(in srgb, var(--ms-accent) 8%, #fff); }
[data-theme="dark"] .ws-sec.brand { background: color-mix(in srgb, var(--ms-accent) 10%, #0A1424); }
.ws-head { max-width: 680px; margin-bottom: 34px; }
.ws-head.center { margin-inline: auto; text-align: center; }
.ws-eyebrow { font-size: 12px; letter-spacing: .16em; text-transform: uppercase; font-weight: 800; color: var(--ms-accent); }
.ws-head h2 { margin: 8px 0 10px; font-size: clamp(28px, 3vw, 40px); font-weight: 800; letter-spacing: -.03em; line-height: 1.12; }
.ws-head p { margin: 0; color: var(--ms-text-2); font-size: 16.5px; line-height: 1.6; }
.ws-grid { display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); }
.ws-grid.three { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.ws-card { position: relative; padding: 24px; border-radius: 22px; background: var(--ms-surface); border: 1px solid var(--ms-border); transition: transform .3s var(--ms-ease, ease), box-shadow .3s, border-color .3s; }
.ws-sec.alt .ws-card { background: var(--ms-bg); }
.ws-card:hover { transform: translateY(-4px); box-shadow: 0 18px 40px rgba(15,23,42,.08); border-color: color-mix(in srgb, var(--ms-accent) 30%, transparent); }
.ws-card .ic { width: 50px; height: 50px; border-radius: 15px; display: grid; place-items: center; font-size: 22px; background: var(--ms-accent-soft); color: var(--ms-accent); margin-bottom: 16px; }
.ws-card h3 { margin: 0 0 6px; font-size: 18px; font-weight: 800; letter-spacing: -.01em; }
.ws-card p { margin: 0; color: var(--ms-text-2); font-size: 14.5px; line-height: 1.55; }
.ws-card .facts { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 16px; }
.ws-card .facts span { padding: 5px 10px; border-radius: 99px; background: var(--ms-accent-soft); color: var(--ms-accent); font-size: 12px; font-weight: 800; }
.ws-card .rate { position: absolute; top: 22px; right: 22px; text-align: right; }
.ws-card .rate b { display: block; font-size: 24px; font-weight: 800; letter-spacing: -.02em; color: var(--ms-text); }
.ws-card .rate small { color: var(--ms-text-3); font-weight: 700; font-size: 11.5px; }

.ws-steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; counter-reset: st; }
.ws-step { padding: 22px; border-radius: 20px; background: var(--ms-surface); border: 1px solid var(--ms-border); counter-increment: st; }
.ws-step::before { content: counter(st); display: grid; place-items: center; width: 40px; height: 40px; border-radius: 12px; background: #0B1F3A; color: #fff; font-weight: 800; margin-bottom: 14px; }
.ws-step p { margin: 0; font-weight: 700; line-height: 1.5; }

.ws-split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 40px; align-items: center; }
.ws-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
.ws-list li { display: flex; gap: 12px; align-items: flex-start; font-weight: 600; line-height: 1.5; }
.ws-list li i { color: var(--ms-accent); font-size: 18px; margin-top: 1px; }

.ws-fees { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
.ws-fee { padding: 18px 20px; border-radius: 18px; background: var(--ms-surface); border: 1px solid var(--ms-border); }
.ws-fee small { display: block; color: var(--ms-text-3); font-weight: 700; font-size: 12.5px; }
.ws-fee b { font-size: 22px; font-weight: 800; letter-spacing: -.02em; }

.ws-cta-band { border-radius: 28px; padding: 40px; background: var(--ms-accent); color: var(--ms-accent-ink); display: flex; align-items: center; gap: 24px; flex-wrap: wrap; }
.ws-cta-band h2 { margin: 0 0 6px; font-size: 30px; font-weight: 800; letter-spacing: -.03em; }
.ws-cta-band p { margin: 0; opacity: .88; font-size: 16px; }
.ws-cta-band .ws-btn { border-color: transparent; }
.ws-cta-band .actions { margin-left: auto; display: flex; gap: 10px; flex-wrap: wrap; }

.ws-news { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
.ws-news a.ws-card { text-decoration: none; display: flex; flex-direction: column; }
.ws-news time { font-size: 12.5px; font-weight: 800; color: var(--ms-accent); text-transform: uppercase; letter-spacing: .08em; }
.ws-news h3 { margin: 8px 0; }
.ws-news .more { margin-top: auto; padding-top: 14px; font-weight: 800; color: var(--ms-accent); font-size: 14px; }
.ws-article { max-width: 760px; }
.ws-article h1 { font-size: clamp(30px, 4vw, 46px); letter-spacing: -.03em; line-height: 1.1; margin: 12px 0 18px; }
.ws-article .body { font-size: 17px; line-height: 1.75; color: var(--ms-text-2); white-space: pre-line; }

.ws-faq details { border-radius: 16px; background: var(--ms-surface); border: 1px solid var(--ms-border); padding: 0 20px; margin-bottom: 10px; }
.ws-faq summary { cursor: pointer; list-style: none; padding: 18px 0; font-weight: 800; font-size: 15.5px; display: flex; align-items: center; gap: 12px; }
.ws-faq summary::-webkit-details-marker { display: none; }
.ws-faq summary::after { content: "\F4FE"; font-family: "bootstrap-icons"; margin-left: auto; color: var(--ms-accent); transition: transform .25s; }
.ws-faq details[open] summary::after { transform: rotate(45deg); }
.ws-faq details p { margin: 0 0 18px; color: var(--ms-text-2); line-height: 1.6; }

.ws-team { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 14px; }
.ws-person { display: flex; align-items: center; gap: 12px; padding: 16px; border-radius: 18px; background: var(--ms-surface); border: 1px solid var(--ms-border); }
.ws-person .av { width: 48px; height: 48px; border-radius: 50%; display: grid; place-items: center; background: var(--ms-accent-soft); color: var(--ms-accent); font-weight: 800; flex: none; }
.ws-person b { display: block; } .ws-person small { color: var(--ms-text-3); font-weight: 700; }
.ws-values { display: flex; flex-wrap: wrap; gap: 10px; }
.ws-values span { padding: 10px 16px; border-radius: 99px; background: var(--ms-surface); border: 1px solid var(--ms-border); font-weight: 800; }
.ws-vm { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.ws-vm .ws-card { background: #0B1F3A; color: #fff; border: 0; }
.ws-vm .ws-card p { color: #c3d0e4; font-size: 16px; }
.ws-vm .ws-card .ic { background: rgba(255,255,255,.1); color: #F4C95D; }

/* forms and calculator */
.ws-form { display: grid; gap: 14px; }
.ws-form .two { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
.ws-form label { display: block; font-weight: 700; font-size: 13.5px; margin-bottom: 6px; }
.ws-form input, .ws-form select, .ws-form textarea { width: 100%; height: 48px; border-radius: 13px; border: 1.5px solid var(--ms-border); background: var(--ms-surface); color: var(--ms-text); padding: 0 14px; font: inherit; font-size: 15px; }
.ws-form textarea { height: auto; min-height: 110px; padding: 12px 14px; resize: vertical; }
.ws-form input:focus, .ws-form select:focus, .ws-form textarea:focus { outline: none; border-color: var(--ms-accent); box-shadow: 0 0 0 4px var(--ms-accent-soft); }
.ws-form .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
.ws-msg { display: flex; gap: 10px; align-items: flex-start; padding: 12px 14px; border-radius: 14px; font-weight: 700; font-size: 14px; }
.ws-msg.ok { background: var(--ms-accent-soft); color: var(--ms-accent); }
.ws-msg.bad { background: #fdecea; color: #b42318; }
.ws-calc { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, .8fr); gap: 0; border-radius: 26px; overflow: hidden; border: 1px solid var(--ms-border); background: var(--ms-surface); }
.ws-calc .in { padding: 28px; display: grid; gap: 18px; }
.ws-calc .out { padding: 28px; background: #0B1F3A; color: #fff; display: flex; flex-direction: column; gap: 14px; }
.ws-calc .out small { color: #a9b7cc; font-weight: 700; font-size: 12.5px; text-transform: uppercase; letter-spacing: .08em; }
.ws-calc .out b.big { font-size: 40px; font-weight: 800; letter-spacing: -.03em; color: #F4C95D; line-height: 1; }
.ws-calc .out .row { display: flex; justify-content: space-between; padding-top: 12px; border-top: 1px solid rgba(255,255,255,.12); font-weight: 700; }
.ws-calc .out .row span { color: #a9b7cc; }
.ws-calc .rng { display: flex; align-items: center; gap: 12px; }
.ws-calc .rng input[type=range] { flex: 1; accent-color: var(--ms-accent); height: 6px; padding: 0; border: 0; }
.ws-calc .rng b { min-width: 120px; text-align: right; font-variant-numeric: tabular-nums; }
.ws-calc .note { font-size: 12px; color: #a9b7cc; margin-top: auto; }

.ws-contact { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: 24px; align-items: start; }
.ws-info { display: grid; gap: 12px; }
.ws-info > div { display: flex; gap: 14px; align-items: flex-start; padding: 16px 18px; border-radius: 18px; background: var(--ms-surface); border: 1px solid var(--ms-border); }
.ws-info i { width: 42px; height: 42px; border-radius: 12px; display: grid; place-items: center; background: var(--ms-accent-soft); color: var(--ms-accent); font-size: 18px; flex: none; }
.ws-info small { display: block; color: var(--ms-text-3); font-weight: 700; font-size: 12px; }
.ws-info b { font-size: 15px; }
.ws-map { border-radius: 20px; overflow: hidden; border: 1px solid var(--ms-border); height: 260px; }
.ws-map iframe { width: 100%; height: 100%; border: 0; }

.ws-page-head { padding: 54px 0 34px; background: color-mix(in srgb, var(--ms-accent) 8%, #fff); border-bottom: 1px solid var(--ms-border); }
[data-theme="dark"] .ws-page-head { background: color-mix(in srgb, var(--ms-accent) 10%, #0A1424); }
.ws-page-head h1 { margin: 8px 0 10px; font-size: clamp(32px, 4vw, 50px); letter-spacing: -.035em; font-weight: 800; line-height: 1.08; }
.ws-page-head p { margin: 0; color: var(--ms-text-2); font-size: 17px; max-width: 640px; line-height: 1.6; }
.ws-crumb { font-size: 13px; font-weight: 700; color: var(--ms-text-3); }
.ws-crumb a { text-decoration: none; color: var(--ms-accent); }

.ws-foot { margin-top: auto; background: #0B1F3A; color: #c3d0e4; padding: 54px 0 24px; }
.ws-foot-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1.2fr; gap: 30px; }
.ws-foot h4 { color: #fff; font-size: 14px; letter-spacing: .08em; text-transform: uppercase; margin: 0 0 14px; }
.ws-foot a { display: block; text-decoration: none; padding: 4px 0; color: #c3d0e4; font-weight: 600; }
.ws-foot a:hover { color: #fff; }
.ws-foot .ws-logo { color: #fff; margin-bottom: 12px; }
.ws-foot .ws-logo small { color: #8fa0b8; }
.ws-foot p { margin: 0 0 8px; line-height: 1.6; font-size: 14px; }
.ws-social { display: flex; gap: 8px; margin-top: 12px; }
.ws-social a { width: 38px; height: 38px; border-radius: 11px; display: grid; place-items: center; background: rgba(255,255,255,.08); font-size: 16px; padding: 0; }
.ws-legal { margin-top: 34px; padding-top: 18px; border-top: 1px solid rgba(255,255,255,.1); display: flex; gap: 12px; flex-wrap: wrap; justify-content: space-between; font-size: 13px; color: #8fa0b8; }
.ws-preview { position: fixed; left: 50%; bottom: 18px; transform: translateX(-50%); z-index: 60; padding: 10px 16px; border-radius: 14px; background: #0B1F3A; color: #fff; font-weight: 700; font-size: 13.5px; box-shadow: 0 12px 30px rgba(7,18,36,.3); display: flex; gap: 12px; align-items: center; }
.ws-preview a { color: #F4C95D; }
.ws-soon { min-height: 100vh; display: grid; place-items: center; text-align: center; padding: 30px; background: var(--ms-bg); color: var(--ms-text); }
.ws-soon h1 { font-size: 40px; letter-spacing: -.03em; margin: 16px 0 10px; }
.ws-reveal { animation: ms-rise .7s var(--ms-ease, ease) both; }

@media (max-width: 1000px) {
  .ws-links, .ws-cta { display: none; }
  .ws-menu { display: grid; place-items: center; }
  .ws-mobile.open { display: grid; gap: 4px; padding: 10px 20px 18px; border-top: 1px solid var(--ms-border); }
  .ws-mobile a { text-decoration: none; padding: 12px 10px; border-radius: 12px; font-weight: 800; }
  .ws-mobile a:hover { background: var(--ms-accent-soft); }
  .ws-hero-grid, .ws-split, .ws-contact, .ws-calc { grid-template-columns: 1fr; }
  .ws-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .ws-grid.three, .ws-news { grid-template-columns: 1fr 1fr; }
  .ws-foot-grid { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 640px) {
  .ws-grid.three, .ws-news, .ws-fees, .ws-vm, .ws-form .two, .ws-foot-grid { grid-template-columns: 1fr; }
  .ws-hero { padding-top: 32px; } .ws-sec { padding: 46px 0; }
  .ws-cta-band { padding: 26px; } .ws-cta-band .actions { margin-left: 0; }
}

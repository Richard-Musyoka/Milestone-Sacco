@page "/my"
@page "/my/{Tab}"
@using System.Globalization
@using System.Security.Claims
@using SaccoManagementSystem.Services
@inject MemberPortalStore Store
@inject ConfigStore Cfg

<PageTitle>@TitleFor(tab) · @Brand.Name</PageTitle>

<div class="ms-page mp">
    @if (loading)
    {
        <div class="ms-skel" style="height:210px;border-radius:24px"></div>
        <div class="ms-grid stats ms-mt">@for (int i = 0; i < 4; i++) { <div class="ms-skel" style="height:110px"></div> }</div>
    }
    else if (d == null)
    {
        <div class="ms-card"><EmptyState Icon="bi-person-x" Title="We couldn't open your account" Text="Your sign-in isn't linked to a membership. Please contact member services." /></div>
    }
    else
    {
        <section class="mp-wallet">
            <div class="mp-w-left">
                <span class="mp-hi">@Greeting, @d.First</span>
                <h1>Your money at @Brand.Name</h1>
                <div class="mp-w-meta">
                    <span><i class="bi bi-person-vcard"></i> @d.MemberNo</span>
                    @if (d.Joined.HasValue) { <span><i class="bi bi-calendar-heart"></i> Member since @d.Joined.Value.ToString("MMM yyyy")</span> }
                    @if (d.Streak > 1) { <span class="hot"><i class="bi bi-fire"></i> Saved @d.Streak months in a row</span> }
                </div>
                <div class="mp-w-actions">
                    <a class="ms-btn primary" href="my/pay"><i class="bi bi-phone"></i> Pay via M-Pesa</a>
                    <a class="ms-btn" href="my/statement"><i class="bi bi-receipt"></i> Statement</a>
                </div>
            </div>
            <div class="mp-card" aria-label="Your position">
                <div class="mp-card-top"><span>@Brand.Name</span><i class="bi bi-wifi"></i></div>
                <small>What you have with us</small>
                <b class="mp-big">@Sym @N(d.Deposits + d.SharesValue)</b>
                <div class="mp-card-row">
                    <div><small>Savings</small><b>@N(d.Deposits)</b></div>
                    <div><small>Shares</small><b>@N(d.SharesValue)</b></div>
                    <div><small>You owe</small><b>@N(d.LoanBalance)</b></div>
                </div>
                <div class="mp-card-no">@d.MemberNo.ToUpperInvariant() · @d.Name.ToUpperInvariant()</div>
            </div>
        </section>

        @foreach (var dv in d.Dividends.Where(x => x.Status == "Paid" && x.PaidOn >= DateTime.UtcNow.AddDays(-60)))
        {
            <div class="mp-alert ok"><span class="ic"><i class="bi bi-check2-circle"></i></span>
                <div><b>Paid successfully · dividend @dv.Year</b><small>@Sym @N(dv.Amount) sent @(dv.PaidOn?.ToLocalTime().ToString("d MMM yyyy")) @(dv.Method == "" ? "" : "via " + dv.Method) @(dv.Reference == "" ? "" : "· ref " + dv.Reference)</small></div></div>
        }
        @foreach (var dv in d.Dividends.Where(x => x.Status is "Pending" or "Approved" or "Processing"))
        {
            <div class="mp-alert info"><span class="ic"><i class="bi bi-gift"></i></span>
                <div><b>Dividend @dv.Year is on its way</b><small>@Sym @N(dv.Amount) on @dv.Shares.ToString("N0") shares. You'll see "Paid successfully" here once it's sent.</small></div></div>
        }
        @if (d.NextDue is { } nx && nx.Due.Date <= DateTime.Today.AddDays(7))
        {
            <div class="mp-alert @(nx.Due.Date < DateTime.Today ? "bad" : "warn")"><span class="ic"><i class="bi bi-alarm"></i></span>
                <div><b>@(nx.Due.Date < DateTime.Today ? "Repayment overdue" : "Repayment due soon")</b><small>@Sym @N(nx.Amount) for LN-@nx.LoanId.ToString("D4") due @nx.Due.ToLocalTime().ToString("ddd d MMM")</small></div>
                <a class="ms-btn sm" href="my/pay">Pay now</a></div>
        }

        <nav class="mp-tabs" aria-label="Portal sections">
            @foreach (var t in Tabs)
            {
                <a class="@(tab == t.Key ? "on" : "")" href="@(t.Key == "overview" ? "my" : "my/" + t.Key)"><i class="bi @t.Icon"></i> @t.Title</a>
            }
        </nav>

        @switch (tab)
        {
            case "statement":
                <section class="ms-card mp-sec">
                    <div class="mp-sec-head">
                        <div><h3>Statement</h3><small>Everything that has moved on your account</small></div>
                        <div class="mp-filters">
                            @foreach (var k in new[] { "All", "Deposit", "Shares", "Loan", "Repayment", "Dividend" })
                            {
                                var kk = k;
                                <button type="button" class="@(kind == kk ? "on" : "")" @onclick="() => kind = kk">@kk</button>
                            }
                            <button type="button" class="ms-btn sm" onclick="window.print()"><i class="bi bi-printer"></i> Print</button>
                        </div>
                    </div>
                    @{ var rows = d.Statement.Where(x => kind == "All" || x.Kind == kind).ToList(); }
                    @if (rows.Count == 0) { <EmptyState Icon="bi-receipt" Title="Nothing here yet" Text="Your transactions will appear here." /> }
                    else
                    {
                        <div class="mp-stmt">
                            @foreach (var g in rows.GroupBy(x => x.When.ToLocalTime().ToString("MMMM yyyy")))
                            {
                                <div class="mp-stmt-month">@g.Key <span>@Sym @N(g.Where(x => x.In).Sum(x => x.Amount)) in · @Sym @N(g.Where(x => !x.In).Sum(x => x.Amount)) out</span></div>
                                @foreach (var x in g)
                                {
                                    <div class="mp-txn">
                                        <span class="ic @x.Kind.ToLowerInvariant()"><i class="bi @KindIcon(x.Kind)"></i></span>
                                        <div class="t"><b>@x.Title</b><small>@x.When.ToLocalTime().ToString("ddd d MMM") @(x.Reference == "" ? "" : "· " + x.Reference)</small></div>
                                        <span class="k">@x.Kind</span>
                                        <b class="a @(x.In ? "in" : "out")">@(x.In ? "+" : "−")@N(x.Amount)</b>
                                    </div>
                                }
                            }
                        </div>
                    }
                </section>
                break;

            case "loans":
                <div class="ms-grid stats">
                    <StatCard Label="You owe" Icon="bi-cash-coin" Tone="gold" Prefix="@Sym" Value="@N(d.LoanBalance)" Foot="@($"{d.Loans.Count(l => l.Status is "Disbursed" or "Active")} running loans")" />
                    <StatCard Label="You can borrow up to" Icon="bi-unlock" Prefix="@Sym" Value="@N(d.LoanLimit)" Foot="@($"{d.Multiple}× your savings, less what you owe")" />
                    <StatCard Label="Next repayment" Icon="bi-calendar-event" Tone="blue" Prefix="@(d.NextDue == null ? "" : Sym)" Value="@(d.NextDue == null ? "None" : N(d.NextDue.Amount))" Foot="@(d.NextDue == null ? "Nothing due" : "Due " + d.NextDue.Due.ToLocalTime().ToString("d MMM yyyy"))" />
                    <StatCard Label="Guaranteeing" Icon="bi-shield-check" Tone="red" Value="@d.Guaranteeing.Count.ToString()" Foot="@(d.Guaranteeing.Count == 0 ? "No one's loan" : Sym + " " + N(d.Guaranteeing.Sum(g => g.Balance)) + " still owed")" />
                </div>
                @if (d.Loans.Count == 0)
                {
                    <div class="ms-card mp-sec"><EmptyState Icon="bi-cash-coin" Title="No loans yet" Text="@($"Based on your savings you could borrow up to {Sym} {N(d.LoanLimit)}. Talk to us to apply.")" /></div>
                }
                @foreach (var l in d.Loans)
                {
                    <section class="ms-card mp-loan">
                        <div class="mp-loan-head">
                            <div><small>@l.No · applied @l.Applied.ToLocalTime().ToString("d MMM yyyy")</small><h3>@l.Type</h3></div>
                            <StatusPill Status="@l.Status" />
                        </div>
                        <div class="mp-loan-grid">
                            <div><small>Borrowed</small><b>@Sym @N(l.Principal)</b></div>
                            <div><small>Rate</small><b>@l.Rate.ToString("0.#")% a year</b></div>
                            <div><small>Monthly</small><b>@Sym @N(l.Monthly)</b></div>
                            <div><small>Balance</small><b>@Sym @N(l.Balance)</b></div>
                        </div>
                        <div class="mp-meter"><i style="width:@(l.RepaidPct.ToString("0", CultureInfo.InvariantCulture))%"></i></div>
                        <div class="mp-meter-foot"><span>@l.RepaidPct.ToString("0")% repaid</span><span>@(l.End.HasValue ? "Ends " + l.End.Value.ToLocalTime().ToString("MMM yyyy") : l.Term + " months")</span></div>
                        @{ var sched = d.Upcoming.Where(i => i.LoanId == l.LoanId).Take(4).ToList(); }
                        @if (sched.Count > 0)
                        {
                            <div class="mp-sched">
                                @foreach (var i in sched)
                                {
                                    <div class="@(i.Due.Date < DateTime.Today ? "late" : "")"><small>#@i.No · @i.Due.ToLocalTime().ToString("d MMM")</small><b>@Sym @N(i.Amount)</b></div>
                                }
                            </div>
                        }
                    </section>
                }
                @if (d.Guaranteeing.Count > 0)
                {
                    <section class="ms-card mp-sec">
                        <div class="mp-sec-head"><div><h3>Loans you're guaranteeing</h3><small>If these aren't repaid, your savings can be used to cover them</small></div></div>
                        @foreach (var g in d.Guaranteeing)
                        {
                            <div class="mp-txn"><span class="ic loan"><i class="bi bi-shield-check"></i></span><div class="t"><b>@g.Borrower</b><small>@g.LoanNo · borrowed @Sym @N(g.Principal)</small></div><span class="k">@g.Status</span><b class="a">@N(g.Balance) left</b></div>
                        }
                    </section>
                }
                break;

            case "shares":
                <div class="ms-grid stats">
                    <StatCard Label="Share capital" Icon="bi-graph-up-arrow" Prefix="@Sym" Value="@N(d.SharesValue)" Foot="@($"{d.ShareUnits:N0} shares")" />
                    <StatCard Label="Dividends received" Icon="bi-gift" Tone="blue" Prefix="@Sym" Value="@N(d.DividendsPaid)" Foot="@($"{d.Dividends.Count(x => x.Status == "Paid")} payouts")" />
                    <StatCard Label="Dividends on the way" Icon="bi-hourglass-split" Tone="gold" Prefix="@Sym" Value="@N(d.DividendsDue)" Foot="Approved, not yet sent" />
                    <StatCard Label="Last rate" Icon="bi-percent" Tone="red" Value="@(d.Dividends.FirstOrDefault() is { } last ? last.Rate.ToString("0.##") : "–")" Foot="@(d.Dividends.FirstOrDefault()?.Year ?? "No dividend yet")" />
                </div>
                <div class="ms-grid two">
                    <section class="ms-card mp-sec">
                        <div class="mp-sec-head"><div><h3>Dividends</h3><small>Your share of each year's surplus</small></div></div>
                        @if (d.Dividends.Count == 0) { <EmptyState Icon="bi-gift" Title="No dividends yet" Text="Dividends are declared at the AGM and paid on the shares you hold." /> }
                        @foreach (var x in d.Dividends)
                        {
                            <div class="mp-div @(x.Status == "Paid" ? "paid" : x.Status == "Failed" ? "failed" : "")">
                                <span class="yr">@x.Year</span>
                                <div class="t"><b>@Sym @N(x.Amount)</b><small>@x.Shares.ToString("N0") shares × @x.Rate.ToString("0.##")</small></div>
                                @if (x.Status == "Paid")
                                {
                                    <span class="ok"><i class="bi bi-check-circle-fill"></i> Paid successfully<small>@x.PaidOn?.ToLocalTime().ToString("d MMM yyyy") @(x.Method == "" ? "" : "· " + x.Method)</small></span>
                                }
                                else { <StatusPill Status="@x.Status" /> }
                            </div>
                        }
                    </section>
                    <section class="ms-card mp-sec">
                        <div class="mp-sec-head"><div><h3>Share purchases</h3><small>Each time you bought shares</small></div></div>
                        @if (d.Shares.Count == 0) { <EmptyState Icon="bi-graph-up-arrow" Title="No shares yet" Text="Shares make you an owner and earn you a dividend." /> }
                        @foreach (var sh in d.Shares)
                        {
                            <div class="mp-txn"><span class="ic shares"><i class="bi bi-graph-up-arrow"></i></span><div class="t"><b>@sh.Units.ToString("N0") shares</b><small>@sh.Date.ToLocalTime().ToString("d MMM yyyy") · @Sym @N(sh.UnitPrice) each @(sh.Type == "" ? "" : "· " + sh.Type)</small></div><span class="k">@sh.Status</span><b class="a">@N(sh.Value)</b></div>
                        }
                    </section>
                </div>
                break;

            case "chamas":
                @if (d.Chamas.Count == 0)
                {
                    <div class="ms-card mp-sec"><EmptyState Icon="bi-people" Title="You're not in a chama yet" Text="Chamas and merry-go-rounds run through the SACCO keep every contribution and payout on record. Ask at the office to join or register your group." /></div>
                }
                <div class="ch-grid">
                    @foreach (var ch in d.Chamas)
                    {
                        <div class="ch-card" style="--cc:@(string.IsNullOrEmpty(ch.Color) ? "#0B7A52" : ch.Color)">
                            <div class="ch-band"><span class="ch-type"><i class="bi bi-arrow-repeat"></i> @ch.Type</span><h3>@ch.Name</h3><p>@Sym @N(ch.Amount) · @ch.Frequency.ToLowerInvariant() · you're @ch.Role.ToLowerInvariant()</p></div>
                            <div class="ch-body">
                                <div class="ch-round"><span>Round @ch.Cycle pot</span><b>@Sym @N(ch.Pot) <small>of @N(ch.Amount * Math.Max(1, ch.Members))</small></b></div>
                                <div class="ch-meter"><i style="width:@(Pct(ch.Pot, ch.Amount * Math.Max(1, ch.Members)))%"></i></div>
                                @if (ch.NextName != null) { <div class="ch-next"><span class="ms-avatar sm">@Ini(ch.NextName)</span><div><small>Next to receive</small><b>@ch.NextName</b></div><span class="when">@ch.NextDate?.ToString("d MMM")</span></div> }
                                <div class="ch-foot"><span><i class="bi bi-people"></i> @ch.Members members</span><span><i class="bi bi-wallet2"></i> You've paid @Sym @N(ch.MyTotal)</span></div>
                                @if (ch.MyCycle.HasValue) { <div class="mp-mine @(ch.MyStatus == "Paid" ? "paid" : "")"><i class="bi @(ch.MyStatus == "Paid" ? "bi-check-circle-fill" : "bi-hourglass")"></i> Your turn: round @ch.MyCycle @(ch.MyStatus == "Paid" ? "· paid successfully" : "· " + ch.MyDate?.ToString("d MMM yyyy"))</div> }
                            </div>
                        </div>
                    }
                </div>
                break;

            case "pay":
                <div class="ms-grid two">
                    <section class="ms-card mp-sec mp-pay">
                        <div class="mp-sec-head"><div><h3><i class="bi bi-phone"></i> Pay with M-Pesa</h3><small>Deposits, shares and loan repayments</small></div></div>
                        @if (string.IsNullOrWhiteSpace(Cfg.Current.MpesaPaybill))
                        {
                            <p class="ms-muted">The SACCO hasn't published a Paybill yet. Please pay at the office.</p>
                        }
                        else
                        {
                            <ol class="mp-steps">
                                <li>Open <b>M-Pesa</b> and choose <b>Lipa na M-Pesa</b></li>
                                <li>Choose <b>Pay Bill</b></li>
                                <li>Business number <span class="mp-code">@Cfg.Current.MpesaPaybill</span></li>
                                <li>Account number <span class="mp-code">@AccountRef</span></li>
                                <li>Enter the amount and your M-Pesa PIN</li>
                            </ol>
                            <p class="ms-muted" style="margin:10px 0 0">Your payment shows on your statement once the office posts it, usually the same working day.</p>
                        }
                    </section>
                    <section class="ms-card mp-sec">
                        <div class="mp-sec-head"><div><h3><i class="bi bi-bank"></i> Bank or check-off</h3><small>Other ways to pay</small></div></div>
                        @if (!string.IsNullOrWhiteSpace(Cfg.Current.BankAccountNo))
                        {
                            <div class="mp-kv"><span>Bank</span><b>@Cfg.Current.BankName</b></div>
                            <div class="mp-kv"><span>Account name</span><b>@Cfg.Current.BankAccountName</b></div>
                            <div class="mp-kv"><span>Account number</span><b>@Cfg.Current.BankAccountNo</b></div>
                            <div class="mp-kv"><span>Reference</span><b>@d.MemberNo</b></div>
                        }
                        <p class="ms-muted" style="margin-top:12px">If your employer deducts your savings (check-off), there's nothing to do: deductions appear after payroll each month.</p>
                        <div class="mp-alert info" style="margin:14px 0 0"><span class="ic"><i class="bi bi-shield-lock"></i></span><div><b>Stay safe</b><small>We never ask for your M-Pesa PIN or sign-in code by phone. Only pay to the Paybill above.</small></div></div>
                    </section>
                </div>
                break;

            default:
                <div class="ms-grid stats">
                    <StatCard Label="Savings" Icon="bi-piggy-bank-fill" Prefix="@Sym" Value="@N(d.Deposits)" Foot="@($"{Sym} {N(d.DepositsThisYear)} this year")" />
                    <StatCard Label="Share capital" Icon="bi-graph-up-arrow" Tone="blue" Prefix="@Sym" Value="@N(d.SharesValue)" Foot="@($"{d.ShareUnits:N0} shares")" />
                    <StatCard Label="You owe" Icon="bi-cash-coin" Tone="gold" Prefix="@Sym" Value="@N(d.LoanBalance)" Foot="@(d.NextDue == null ? "No repayment due" : "Next " + Sym + " " + N(d.NextDue.Amount) + " on " + d.NextDue.Due.ToLocalTime().ToString("d MMM"))" />
                    <StatCard Label="You can borrow up to" Icon="bi-unlock" Tone="red" Prefix="@Sym" Value="@N(d.LoanLimit)" Foot="@($"{d.Multiple}× savings, less what you owe")" />
                </div>

                <div class="mp-grid">
                    <section class="ms-card mp-sec">
                        <div class="mp-sec-head"><div><h3>Your savings, month by month</h3><small>Last 12 months · saved in @d.MonthsSaved of them</small></div></div>
                        @{ var max = Math.Max(1m, d.Monthly.Max(m => m.Amount)); }
                        <div class="mp-bars" role="img" aria-label="Monthly savings for the last 12 months">
                            @foreach (var m in d.Monthly)
                            {
                                <div class="bar" title="@m.Label: @Sym @N(m.Amount)"><span class="v">@(m.Amount > 0 ? Short(m.Amount) : "")</span><i style="height:@(Pct(m.Amount, max))%" class="@(m.Amount == 0 ? "zero" : "")"></i><small>@m.Label</small></div>
                            }
                        </div>
                    </section>
                    <section class="ms-card mp-sec">
                        <div class="mp-sec-head"><div><h3>Recent activity</h3><small>Your latest transactions</small></div><a class="ms-btn sm" href="my/statement">All</a></div>
                        @if (d.Statement.Count == 0) { <EmptyState Icon="bi-receipt" Title="No activity yet" Text="Your deposits and payments will show here." /> }
                        @foreach (var x in d.Statement.Take(6))
                        {
                            <div class="mp-txn"><span class="ic @x.Kind.ToLowerInvariant()"><i class="bi @KindIcon(x.Kind)"></i></span><div class="t"><b>@x.Title</b><small>@x.When.ToLocalTime().ToString("d MMM yyyy")</small></div><b class="a @(x.In ? "in" : "out")">@(x.In ? "+" : "−")@N(x.Amount)</b></div>
                        }
                    </section>
                </div>

                <div class="mp-grid three">
                    <a class="ms-card mp-tile" href="my/loans">
                        <span class="ic gold"><i class="bi bi-cash-coin"></i></span>
                        <b>@(d.Loans.Count(l => l.Status is "Disbursed" or "Active")) running loan@(d.Loans.Count(l => l.Status is "Disbursed" or "Active") == 1 ? "" : "s")</b>
                        <small>@(d.NextDue == null ? "Nothing due right now" : "Next: " + Sym + " " + N(d.NextDue.Amount) + " on " + d.NextDue.Due.ToLocalTime().ToString("d MMM"))</small>
                    </a>
                    <a class="ms-card mp-tile" href="my/shares">
                        <span class="ic blue"><i class="bi bi-gift"></i></span>
                        <b>@Sym @N(d.DividendsPaid) in dividends</b>
                        <small>@(d.DividendsDue > 0 ? Sym + " " + N(d.DividendsDue) + " on the way" : "Paid on your shares every year")</small>
                    </a>
                    <a class="ms-card mp-tile" href="my/chamas">
                        <span class="ic green"><i class="bi bi-people-fill"></i></span>
                        <b>@d.Chamas.Count chama@(d.Chamas.Count == 1 ? "" : "s")</b>
                        <small>@(d.Chamas.FirstOrDefault(c => c.MyCycle.HasValue && c.MyStatus != "Paid") is { } mc ? "Your turn in " + mc.Name + ": " + mc.MyDate?.ToString("d MMM") : "Save and rotate with your group")</small>
                    </a>
                </div>
                break;
        }
    }
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? Auth { get; set; }
    [Parameter] public string? Tab { get; set; }

    private MemberPortalStore.Data? d;
    private bool loading = true;
    private string tab = "overview";
    private string kind = "All";
    private int? memberId;

    private sealed record T(string Key, string Title, string Icon);
    private static readonly T[] Tabs =
    {
        new("overview", "Overview", "bi-grid-1x2"), new("statement", "Statement", "bi-receipt"), new("loans", "Loans", "bi-cash-coin"),
        new("shares", "Shares & dividends", "bi-graph-up-arrow"), new("chamas", "Chamas", "bi-people-fill"), new("pay", "How to pay", "bi-phone"),
    };

    private string Sym => Cfg.Current.CurrencySymbol;
    private string AccountRef => d == null ? "" : Cfg.Current.MpesaAccountRef.Contains("ID", StringComparison.OrdinalIgnoreCase) ? "Your ID number" : d.MemberNo;
    private static string N(decimal v) => v.ToString("N0", CultureInfo.InvariantCulture);
    private static string Short(decimal v) => v >= 1_000_000 ? (v / 1_000_000m).ToString("0.#") + "M" : v >= 1000 ? (v / 1000m).ToString("0.#") + "k" : v.ToString("0");
    private static string Pct(decimal v, decimal of) => of <= 0 ? "0" : Math.Min(100, Math.Round(v / of * 100, 1)).ToString(CultureInfo.InvariantCulture);
    private static string Ini(string n) { var p = n.Split(' ', StringSplitOptions.RemoveEmptyEntries); return p.Length >= 2 ? $"{p[0][0]}{p[^1][0]}" : n[..Math.Min(2, n.Length)]; }
    private static string Greeting => DateTime.Now.Hour < 12 ? "Habari ya asubuhi" : DateTime.Now.Hour < 17 ? "Habari ya mchana" : "Habari ya jioni";
    private static string KindIcon(string k) => k switch { "Deposit" => "bi-piggy-bank", "Shares" => "bi-graph-up-arrow", "Loan" => "bi-cash-coin", "Repayment" => "bi-arrow-repeat", "Dividend" => "bi-gift", _ => "bi-dot" };
    private static string TitleFor(string t) => Tabs.FirstOrDefault(x => x.Key == t)?.Title ?? "My money";

    protected override async Task OnParametersSetAsync()
    {
        tab = Tabs.Any(t => t.Key == Tab) ? Tab! : "overview";
        if (d != null || memberId.HasValue && !loading) return;
        if (Auth == null) { loading = false; return; }
        var u = (await Auth).User;
        memberId = int.TryParse(u.FindFirstValue(MemberPortalStore.MemberClaim), out var m) ? m : null;
        if (memberId.HasValue) d = await Store.LoadAsync(memberId.Value);
        loading = false;
    }
}
